---
import type { ClienteInvitacion } from '../../types/invitacion';
import { obtenerEtiquetaCategoria } from '../../utils/categorias';
import { formatearFechaCorta } from '../../utils/fechas';
import {
  PLANES_INFO,
  contarModulosActivos,
  resolverModulos,
} from '../../utils/planes';

interface Props {
  cliente: ClienteInvitacion;
}

const { cliente } = Astro.props;
const modulos = resolverModulos(cliente);
const totalModulos = contarModulosActivos(modulos);
const planInfo = PLANES_INFO[cliente.plan];
const rutaRelativa = `/${cliente.categoria}/${cliente.slug}`;
const tieneOverrides = Boolean(
  cliente.modulosOverride && Object.keys(cliente.modulosOverride).length > 0,
);
const clavesOverride = cliente.modulosOverride
  ? Object.entries(cliente.modulosOverride)
      .filter(([, activo]) => Boolean(activo))
      .map(([clave]) => clave)
  : [];

const textoBusqueda = [
  cliente.protagonistas,
  cliente.titulo,
  cliente.slug,
  cliente.ciudad,
  planInfo.nombre,
  obtenerEtiquetaCategoria(cliente.categoria),
]
  .join(' ')
  .toLowerCase();
---

<article
  data-cliente-card
  data-categoria={cliente.categoria}
  data-busqueda={textoBusqueda}
  class="flex w-full min-w-0 flex-col justify-between rounded-3xl border border-signato-secundario/45 bg-white p-5 shadow-xs transition-shadow hover:shadow-sm"
>
  <div class="w-full min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="rounded-full bg-signato-lienzo px-2.5 py-1 text-[11px] font-semibold text-signato-contraste">
          {obtenerEtiquetaCategoria(cliente.categoria)}
        </span>
        <span
          class:list={[
            'rounded-full px-2.5 py-1 text-[11px] font-semibold',
            cliente.plan === 'diamante'
              ? 'bg-signato-contraste text-signato-lienzo'
              : cliente.plan === 'oro'
                ? 'bg-signato-principal/20 text-signato-contraste'
                : 'bg-signato-secundario/30 text-signato-contraste',
          ]}
        >
          {planInfo.nombre} · ${planInfo.precioMXN}
        </span>
        {
          cliente.esDemo && (
            <span class="rounded-full border border-signato-principal/50 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-signato-principal">
              Demo
            </span>
          )
        }
      </div>

      <span class="text-xs text-signato-contraste/65">
        {formatearFechaCorta(cliente.fechaISO)}
      </span>
    </div>

    <h2 class="font-display mt-3 truncate text-2xl font-semibold text-signato-contraste">
      {cliente.protagonistas}
    </h2>
    <p class="mt-0.5 truncate text-xs text-signato-contraste/70">
      {cliente.ciudad} · <code class="font-mono text-[11px]">{rutaRelativa}</code>
    </p>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-signato-contraste/75">
      <span class="rounded-lg bg-signato-lienzo px-2.5 py-1">
        {totalModulos} módulos activos
      </span>
      <span class="rounded-lg bg-signato-lienzo px-2.5 py-1">
        Tema: {cliente.tema}
      </span>
      {
        tieneOverrides && (
          <span class="rounded-lg bg-signato-principal/15 px-2.5 py-1 font-medium text-signato-contraste">
            Override: {clavesOverride.join(', ')}
          </span>
        )
      }
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-signato-secundario/30 pt-4">
    <a
      href={rutaRelativa}
      class="inline-flex flex-1 items-center justify-center rounded-full bg-signato-principal px-4 py-2 text-xs font-semibold text-signato-lienzo transition-opacity hover:opacity-90"
    >
      Abrir invitación
    </a>

    {
      modulos.paseBoletos && (
        <a
          href={`${rutaRelativa}?pases=4`}
          class="inline-flex items-center justify-center rounded-full border border-signato-secundario/60 px-3.5 py-2 text-xs font-medium text-signato-contraste transition-colors hover:bg-signato-lienzo"
        >
          Probar ?pases=4
        </a>
      )
    }

    <button
      type="button"
      data-copiar-ruta={rutaRelativa}
      class="inline-flex items-center justify-center rounded-full border border-signato-secundario/60 px-3.5 py-2 text-xs font-medium text-signato-contraste transition-colors hover:bg-signato-lienzo"
    >
      Copiar enlace
    </button>
  </div>
</article>
