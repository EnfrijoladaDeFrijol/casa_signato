---
import type { PaseBoletosData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  pase: PaseBoletosData;
  protagonistas: string;
}

const { pase, protagonistas } = Astro.props;
const maxPases = pase.maxPases ?? 12;
const textoLugaresInicial =
  pase.pasesDefault === 1 ? 'lugar reservado' : 'lugares reservados';

// Evita repetir la leyenda del boleto en el encabezado superior
const etiquetaBase = pase.etiqueta?.trim() || '';
const eyebrow =
  !etiquetaBase || /intransferible/i.test(etiquetaBase) ? 'Pase de acceso' : etiquetaBase;

// Código de barras minimalista: [x, ancho] de cada trazo vertical
const barras: Array<[number, number]> = [
  [0, 1], [4, 2], [9, 1], [12, 1], [16, 3], [22, 1], [26, 2], [31, 1], [34, 1], [38, 2],
  [43, 1], [47, 3], [53, 1], [57, 1], [60, 2], [65, 1], [69, 2], [74, 1], [78, 1], [81, 3],
  [87, 1], [91, 2], [96, 1], [99, 1], [103, 2], [108, 1], [112, 1], [116, 2],
];
---

<section aria-labelledby="titulo-pase">
  <div
    class="mx-auto max-w-sm"
    data-pase-widget
    data-pases-default={String(pase.pasesDefault)}
    data-pases-max={String(maxPases)}
  >
    <SeccionTitulo id="titulo-pase" eyebrow={eyebrow} titulo={protagonistas} />

    <div class="inv-ticket-wrap mt-12" data-reveal style="--rv: 1">
      <div class="inv-ticket rounded-[1.5rem] bg-[var(--surface)] text-center">
        <span class="inv-ticket__marco rounded-[1rem] border border-[var(--border-soft)]" aria-hidden="true"></span>

        <div class="inv-ticket__cuerpo relative px-8 pb-6 pt-11">
          <p class="inv-micro">Pase oficial</p>
          <p class="inv-micro mt-5 hidden opacity-70" data-pase-invitado-label>Invitado</p>
          <p
            data-pase-invitado
            class="inv-nombre mt-2 break-words text-[2rem] font-medium italic leading-tight text-[var(--ink)]"
          >
            Reservado con cariño
          </p>
          <div class="mt-5 flex items-center justify-center gap-3 text-[var(--accent)]" aria-hidden="true">
            <span class="h-px w-10 bg-[var(--border-soft)]"></span>
            <span class="inv-rombo"></span>
            <span class="h-px w-10 bg-[var(--border-soft)]"></span>
          </div>
        </div>

        <div class="inv-ticket__talon relative flex flex-col items-center justify-center px-8">
          <span class="inv-medallon">
            <span data-pases-numero class="inv-num">{pase.pasesDefault}</span>
          </span>
          <span data-pases-etiqueta class="inv-micro mt-3">{textoLugaresInicial}</span>

          <svg
            class="mt-5 h-6 w-32 text-[var(--ink-muted)]"
            viewBox="0 0 120 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {barras.map(([x, w]) => <rect x={x} y="0" width={w} height="24" opacity="0.35" />)}
          </svg>
          <p class="inv-micro mt-3 !text-[0.58rem] opacity-75">Pase personal e intransferible</p>
        </div>
      </div>
    </div>

    {
      pase.nota && (
        <p class="inv-lede mx-auto mt-8 max-w-xs text-center text-sm" data-reveal style="--rv: 2">
          {pase.nota}
        </p>
      )
    }
  </div>
</section>

<style>
  .inv-ticket-wrap {
    /* Sombra cálida que respeta la silueta con muescas */
    filter: drop-shadow(0 14px 22px color-mix(in srgb, var(--ink) 10%, transparent));
  }
  .inv-ticket {
    position: relative;
    overflow: hidden;
    --muesca: 12px;
    --talon: 14.5rem;
    /* Muescas laterales transparentes: el fondo de la sección se ve tal cual */
    -webkit-mask:
      radial-gradient(circle var(--muesca) at 0 calc(100% - var(--talon)), transparent 97%, white) left / 51% 100% no-repeat,
      radial-gradient(circle var(--muesca) at 100% calc(100% - var(--talon)), transparent 97%, white) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle var(--muesca) at 0 calc(100% - var(--talon)), transparent 97%, white) left / 51% 100% no-repeat,
      radial-gradient(circle var(--muesca) at 100% calc(100% - var(--talon)), transparent 97%, white) right / 51% 100% no-repeat;
  }
  .inv-ticket__marco {
    position: absolute;
    inset: 0.9rem;
    pointer-events: none;
  }
  .inv-ticket__talon {
    height: var(--talon);
  }
  /* Perforación punteada entre las muescas */
  .inv-ticket__talon::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.75rem;
    right: 1.75rem;
    border-top: 2px dotted color-mix(in srgb, var(--ink) 28%, transparent);
  }

  .inv-micro {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .inv-nombre,
  .inv-num {
    font-family: 'Cormorant Garamond', var(--font-display), Georgia, serif;
  }
  .inv-rombo {
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    border: 1px solid var(--accent);
  }
  .inv-medallon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.25rem;
    height: 5.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .inv-num {
    font-size: 3.25rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums lining-nums;
  }

  @keyframes inv-ticket-destello {
    0% {
      opacity: 0;
      transform: translate3d(-105%, 0, 0) skewX(-18deg);
    }
    22% {
      opacity: 0.9;
    }
    78% {
      opacity: 0.65;
    }
    100% {
      opacity: 0;
      transform: translate3d(105%, 0, 0) skewX(-18deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .inv-ticket::after {
      content: '';
      position: absolute;
      inset: -20% -55%;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(
        115deg,
        transparent 35%,
        color-mix(in srgb, var(--surface) 64%, transparent) 50%,
        transparent 65%
      );
      transform: translate3d(-105%, 0, 0) skewX(-18deg);
    }

    .inv-ticket-wrap.is-visible .inv-ticket::after {
      animation: inv-ticket-destello 1.25s var(--ease) 0.35s 1 both;
    }
  }
</style>

<script>
  const widgets = document.querySelectorAll<HTMLElement>('[data-pase-widget]');

  widgets.forEach((widget) => {
    const elNumero = widget.querySelector<HTMLElement>('[data-pases-numero]');
    const elEtiqueta = widget.querySelector<HTMLElement>('[data-pases-etiqueta]');
    const elInvitado = widget.querySelector<HTMLElement>('[data-pase-invitado]');
    const elInvitadoLabel = widget.querySelector<HTMLElement>('[data-pase-invitado-label]');
    const valorDefault = Number(widget.dataset.pasesDefault || '1');
    const valorMax = Number(widget.dataset.pasesMax || '12');

    const params = new URLSearchParams(window.location.search);
    const paramPases = params.get('pases');
    let pasesFinal = valorDefault;

    if (paramPases && /^\d+$/.test(paramPases)) {
      const parsed = Number(paramPases);
      if (parsed >= 1 && parsed <= valorMax) {
        pasesFinal = parsed;
      }
    }

    if (elNumero) elNumero.textContent = String(pasesFinal);
    if (elEtiqueta) {
      elEtiqueta.textContent =
        pasesFinal === 1 ? 'lugar reservado' : 'lugares reservados';
    }

    // Invitado: texto plano saneado, nunca innerHTML
    const paramInvitado = params.get('invitado');
    if (paramInvitado && elInvitado) {
      const limpio = paramInvitado
        // eslint-disable-next-line no-control-regex
        .replace(/[\u0000-\u001f\u007f<>]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 60);
      if (limpio) {
        elInvitado.textContent = limpio;
        elInvitadoLabel?.classList.remove('hidden');
      }
    }
  });
</script>
