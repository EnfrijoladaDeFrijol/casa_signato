---
import type { CalendarioData } from '../../types/invitacion';
import {
  construirContenidoICS,
  construirUrlGoogleCalendar,
} from '../../utils/fechas';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  calendario: CalendarioData;
  fechaISO: string;
  horaInicio: string;
  slug: string;
}

const { calendario, fechaISO, horaInicio, slug } = Astro.props;

const googleUrl = construirUrlGoogleCalendar({
  titulo: calendario.titulo,
  descripcion: calendario.descripcion,
  ubicacion: calendario.ubicacion,
  fechaISO,
  horaInicio,
  duracionHoras: calendario.duracionHoras,
});

const contenidoIcs = construirContenidoICS({
  uid: slug,
  titulo: calendario.titulo,
  descripcion: calendario.descripcion,
  ubicacion: calendario.ubicacion,
  fechaISO,
  horaInicio,
  duracionHoras: calendario.duracionHoras,
});
---

<section aria-labelledby="titulo-calendario" data-compacta>
  <div class="mx-auto max-w-xl text-center">
    <div class="mx-auto mb-6 text-[var(--accent)]" aria-hidden="true" data-reveal>
      <svg class="mx-auto h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="5" width="17" height="15.5" rx="1.5" />
        <path d="M3.5 10h17M8 3v4M16 3v4" />
      </svg>
    </div>

    <SeccionTitulo
      id="titulo-calendario"
      eyebrow="Guarda la fecha"
      titulo="Agendar en Calendario"
      lede="Añade el recordatorio directamente en tu teléfono para no perder ningún detalle."
    />

    <div class="mx-auto mt-9 flex max-w-xs flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center" data-reveal style="--rv: 1">
      <a
        href={googleUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-abrir-mapa
        class="inv-btn inv-btn--solid active:scale-[0.98]"
      >
        <span class="inv-swap">
          <span data-swap-a>Google Calendar</span>
          <span data-swap-b>Abriendo…</span>
        </span>
      </a>

      <button
        type="button"
        data-descargar-ics={contenidoIcs}
        data-nombre-ics={`${slug}.ics`}
        class="inv-btn inv-btn--line active:scale-[0.98]"
      >
        <span class="inv-swap">
          <span data-swap-a>Apple / Outlook (.ics)</span>
          <span data-swap-b>Descargando…</span>
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-descargar-ics]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const contenido = boton.dataset.descargarIcs;
      const archivo = boton.dataset.nombreIcs || 'evento.ics';
      if (!contenido) return;

      const blob = new Blob([contenido], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const enlace = document.createElement('a');
      enlace.href = url;
      enlace.download = archivo;
      document.body.appendChild(enlace);
      enlace.click();
      enlace.remove();
      URL.revokeObjectURL(url);

      boton.dataset.estado = 'activo';
      window.setTimeout(() => {
        delete boton.dataset.estado;
      }, 1800);
    });
  });
</script>
