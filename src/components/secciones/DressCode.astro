---
import type { DressCodeData } from '../../types/invitacion';

interface Props {
  dressCode: DressCodeData;
}

const { dressCode } = Astro.props;
---

<section class="px-4 py-12 sm:px-6" aria-labelledby="titulo-dresscode">
  <div class="mx-auto max-w-2xl rounded-3xl border border-[var(--border-soft)] bg-[var(--surface)] px-6 py-8 text-center sm:px-10">
    <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-[var(--accent-soft)] text-[var(--accent)]" aria-hidden="true">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4a2 2 0 1 1 2 2c0 1-2 1.5-2 2.5L4 14h16l-8-5.5" />
      </svg>
    </div>

    <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--accent)]">
      Código de vestimenta
    </p>
    <h2 id="titulo-dresscode" class="font-display mt-1 text-3xl font-semibold text-[var(--ink)] sm:text-4xl">
      {dressCode.etiqueta}
    </h2>

    {
      dressCode.descripcion && (
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-[var(--ink-muted)]">
          {dressCode.descripcion}
        </p>
      )
    }

    {
      dressCode.coloresSugeridos && dressCode.coloresSugeridos.length > 0 && (
        <div class="mt-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink)]">
            Paleta sugerida
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-4">
            {dressCode.coloresSugeridos.map((color) => (
              <div class="flex flex-col items-center gap-1.5">
                <span
                  class="h-8 w-8 rounded-full border border-[var(--border-soft)]"
                  style={`background-color: ${color.hex};`}
                  aria-hidden="true"
                ></span>
                <span class="text-xs text-[var(--ink-muted)]">{color.nombre}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      dressCode.coloresReservados && dressCode.coloresReservados.length > 0 && (
        <div class="mt-6 border-t border-[var(--border-soft)] pt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink-muted)]">
            Tonos reservados
          </p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-4">
            {dressCode.coloresReservados.map((color) => (
              <div class="flex items-center gap-2 rounded-full bg-[var(--bg)] px-3 py-1.5 text-xs text-[var(--ink-muted)]">
                <span
                  class="h-4 w-4 rounded-full border border-[var(--border-soft)]"
                  style={`background-color: ${color.hex};`}
                  aria-hidden="true"
                ></span>
                <span>{color.nombre}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      dressCode.nota && (
        <p class="mt-4 text-xs italic text-[var(--ink-muted)]">{dressCode.nota}</p>
      )
    }
  </div>
</section>
