---
import type { DressCodeData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import InvitacionIcono from './InvitacionIcono.astro';

interface Props {
  dressCode: DressCodeData;
}

const { dressCode } = Astro.props;
---

<section aria-labelledby="titulo-dresscode" class="inv-papel">
  <div class="inv-card-editorial mx-auto mt-10 max-w-md px-6 pb-12 pt-0 text-center">
    <div class="inv-medallon -mt-10 mx-auto mb-8 h-14 w-14" data-reveal>
      <InvitacionIcono nombre="vestimenta" class="inv-icon-draw h-7 w-7" />
    </div>

    <SeccionTitulo
      id="titulo-dresscode"
      eyebrow="Código de vestimenta"
      titulo={dressCode.etiqueta}
      lede={dressCode.descripcion}
    />

    {
      dressCode.coloresSugeridos && dressCode.coloresSugeridos.length > 0 && (
        <div class="mt-12" data-reveal style="--rv: 1">
          <p class="inv-label">Paleta sugerida</p>
          <ul class="mt-6 flex flex-wrap items-start justify-center gap-x-7 gap-y-5">
            {dressCode.coloresSugeridos.map((color) => (
              <li class="flex w-16 flex-col items-center gap-2.5">
                <span
                  class="inv-bolita h-14 w-14 rounded-full"
                  style={`background-color: ${color.hex};`}
                  aria-hidden="true"
                />
                <span class="text-xs leading-tight text-[var(--ink-muted)]">{color.nombre}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      dressCode.coloresReservados && dressCode.coloresReservados.length > 0 && (
        <div class="mt-10 border-t border-[var(--border-soft)] pt-9" data-reveal style="--rv: 2">
          <p class="inv-label">Tonos reservados</p>
          <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
            {dressCode.coloresReservados.map((color) => (
              <li class="flex items-center gap-2.5 text-xs text-[var(--ink-muted)]">
                <span
                  class="h-4 w-4 rounded-full border border-[var(--border-soft)]"
                  style={`background-color: ${color.hex};`}
                  aria-hidden="true"
                />
                <span>{color.nombre}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      dressCode.nota && (
        <p class="inv-quote mx-auto mt-8 max-w-sm text-center text-[1.1rem]" data-reveal style="--rv: 3">
          {dressCode.nota}
        </p>
      )
    }
  </div>
</section>
