---
import type { DressCodeData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import InvitacionIcono from './InvitacionIcono.astro';

interface Props {
  dressCode: DressCodeData;
}

const { dressCode } = Astro.props;
const sugeridos = dressCode.coloresSugeridos ?? [];
const reservados = dressCode.coloresReservados ?? [];
const tieneColores = sugeridos.length > 0 || reservados.length > 0;
---

<section aria-labelledby="titulo-dresscode" class="inv-papel">
  <div class="mx-auto max-w-lg text-center">
    <InvitacionIcono
      nombre="vestimenta"
      class="inv-icon-draw mx-auto mb-5 h-10 w-10 text-[var(--ink)] opacity-85"
    />

    <SeccionTitulo
      id="titulo-dresscode"
      eyebrow="Código de vestimenta"
      titulo={dressCode.etiqueta}
      lede={dressCode.descripcion}
    />

    {
      tieneColores && (
        <div
          class="mx-auto mt-10 max-w-md border-t border-[var(--border-soft)] pt-9 text-center"
          data-reveal
          style="--rv: 1"
        >
          {sugeridos.length > 0 && (
            <div>
              <p class="inv-label">Paleta sugerida</p>
              <ul class="mt-6 flex flex-wrap items-start justify-center gap-x-7 gap-y-5">
                {sugeridos.map((color, idx) => (
                  <li
                    class="inv-bolita-item flex w-16 flex-col items-center gap-2.5"
                    style={`--bi: ${idx}`}
                  >
                    <span
                      class="inv-bolita h-12 w-12 rounded-full transition-transform duration-300 hover:scale-105"
                      style={`background-color: ${color.hex};`}
                      aria-hidden="true"
                    />
                    <span class="text-xs leading-tight text-[var(--ink-muted)]">{color.nombre}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {reservados.length > 0 && (
            <div class:list={[sugeridos.length > 0 && 'mt-8 border-t border-[var(--border-soft)] pt-7']}>
              <p class="inv-label">Tonos reservados</p>
              <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
                {reservados.map((color, idx) => (
                  <li
                    class="inv-bolita-item flex items-center gap-2.5 text-xs text-[var(--ink-muted)]"
                    style={`--bi: ${sugeridos.length + idx}`}
                  >
                    <span
                      class="h-4 w-4 shrink-0 rounded-full border border-[var(--border-soft)]"
                      style={`background-color: ${color.hex};`}
                      aria-hidden="true"
                    />
                    <span>{color.nombre}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )
    }

    {
      dressCode.nota && (
        <p class="inv-quote mx-auto mt-9 max-w-sm text-center text-[1.1rem]" data-reveal style="--rv: 2">
          {dressCode.nota}
        </p>
      )
    }
  </div>
</section>
