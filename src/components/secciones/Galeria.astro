---
import type { FotoGaleria, PlanTipo } from '../../types/invitacion';
import { obtenerLimiteGaleria } from '../../utils/planes';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  fotos: FotoGaleria[];
  plan: PlanTipo;
}

const { fotos, plan } = Astro.props;
const limite = obtenerLimiteGaleria(plan);
const fotosVisibles = fotos.slice(0, limite);
const [destacada, ...resto] = fotosVisibles;

// Proporciones alternadas para un mosaico asimétrico, sin marcos tipo tarjeta.
const proporciones = ['aspect-[4/5]', 'aspect-square', 'aspect-[3/4]', 'aspect-[5/6]'];
---

<section aria-labelledby="titulo-galeria">
  <div class="mx-auto max-w-4xl">
    <SeccionTitulo id="titulo-galeria" eyebrow="Recuerdos" titulo="Galería Fotográfica" />

    {
      destacada && (
        <figure
          class="mx-auto mt-14 w-[78%] overflow-hidden rounded-t-full sm:w-[46%]"
          data-reveal="galeria"
        >
          <img
            src={destacada.url}
            alt={destacada.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
        </figure>
      )
    }

    {
      resto.length > 0 && (
        <div class="mt-12 columns-2 gap-3 sm:columns-3 sm:gap-5">
          {resto.map((foto, i) => (
            <figure
              class="mb-3 break-inside-avoid overflow-hidden rounded-sm sm:mb-5"
              data-reveal="galeria"
              style={`--rv: ${i % 3}`}
            >
              <img
                src={foto.url}
                alt={foto.alt}
                loading="lazy"
                decoding="async"
                class:list={['w-full object-cover', proporciones[i % proporciones.length]]}
              />
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
