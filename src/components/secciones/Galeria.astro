---
import type { FotoGaleria, PlanTipo } from '../../types/invitacion';
import { obtenerLimiteGaleria } from '../../utils/planes';

interface Props {
  fotos: FotoGaleria[];
  plan: PlanTipo;
}

const { fotos, plan } = Astro.props;
const limite = obtenerLimiteGaleria(plan);
const fotosVisibles = fotos.slice(0, limite);
---

<section class="px-4 py-12 sm:px-6" aria-labelledby="titulo-galeria">
  <div class="mx-auto max-w-4xl">
    <div class="text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--accent)]">
        Recuerdos
      </p>
      <h2 id="titulo-galeria" class="font-display mt-1 text-3xl font-semibold text-[var(--ink)] sm:text-4xl">
        Galería Fotográfica
      </h2>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
      {
        fotosVisibles.map((foto) => (
          <figure class="overflow-hidden rounded-2xl border border-[var(--border-soft)] bg-[var(--surface)] p-1.5">
            <img
              src={foto.url}
              alt={foto.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full rounded-xl object-cover"
            />
            {foto.caption && (
              <figcaption class="px-2 py-2 text-center text-xs text-[var(--ink-muted)]">
                {foto.caption}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>
