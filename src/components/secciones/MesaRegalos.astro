---
import type { MesaRegalosData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import InvitacionIcono from './InvitacionIcono.astro';

interface Props {
  mesaRegalos: MesaRegalosData;
}

const { mesaRegalos } = Astro.props;
const tiendas = mesaRegalos.tiendas ?? [];
const lluvia = mesaRegalos.lluviaSobres;
const clabeAgrupada = lluvia ? lluvia.clabe.replace(/\s+/g, '').replace(/(\d{4})(?=\d)/g, '$1 ') : '';
const variasTiendas = tiendas.length > 1;
---

<section aria-labelledby="titulo-regalos" class="inv-papel">
  <div class="mx-auto max-w-xl text-center">
    <InvitacionIcono
      nombre="regalo"
      class="inv-icon-draw mx-auto mb-5 h-10 w-10 text-[var(--ink)] opacity-85"
    />

    <SeccionTitulo
      id="titulo-regalos"
      eyebrow="Detalles y obsequios"
      titulo="Mesa de Regalos"
      lede={mesaRegalos.mensaje}
    />

    {
      tiendas.length > 0 && (
        <ul
          class:list={[
            'mx-auto mt-11 grid divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]',
            variasTiendas ? 'sm:grid-cols-2 sm:divide-x sm:divide-y-0' : 'max-w-md',
          ]}
        >
          {tiendas.map((tienda, i) => (
            <li
              class="flex flex-col items-center px-5 py-8 text-center"
              data-reveal
              style={`--rv: ${i}`}
            >
              <h3 class="font-display text-[1.8rem] font-medium italic leading-tight text-[var(--ink)]">
                {tienda.nombre}
              </h3>
              {tienda.numeroEvento && (
                <p class="inv-label mt-2 !text-[var(--accent)]">{tienda.numeroEvento}</p>
              )}
              {tienda.descripcion && (
                <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-[var(--ink-muted)]">
                  {tienda.descripcion}
                </p>
              )}
              <a
                href={tienda.url}
                target="_blank"
                rel="noopener noreferrer"
                data-abrir-mapa
                class="inv-btn inv-btn--tinta mt-6 min-h-[46px] px-6 active:scale-[0.98]"
              >
                <span class="inv-swap">
                  <span data-swap-a>Ver mesa de regalos</span>
                  <span data-swap-b>Abriendo…</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      lluvia && (
        <div
          class:list={[
            'mx-auto max-w-md text-center',
            tiendas.length > 0 ? 'mt-12 pt-2' : 'mt-11 border-t border-[var(--border-soft)] pt-10',
          ]}
          data-reveal
          style="--rv: 2"
        >
          <InvitacionIcono
            nombre="sobre"
            class="inv-icon-draw mx-auto mb-4 h-9 w-9 text-[var(--ink)] opacity-85"
          />
          <p class="inv-eyebrow">Lluvia de sobres</p>
          <p class="mt-3 font-display text-[1.6rem] font-medium italic leading-tight text-[var(--ink)]">
            {lluvia.titular}
          </p>
          <p class="mt-1 text-sm text-[var(--ink-muted)]">{lluvia.banco}</p>

          <p class="mt-6 break-words text-[1.0625rem] font-medium tracking-[0.12em] text-[var(--ink)] [font-variant-numeric:tabular-nums]">
            {clabeAgrupada}
          </p>
          <p class="inv-label mt-1">CLABE interbancaria</p>

          <button
            type="button"
            data-copiar-texto={lluvia.clabe}
            class="inv-btn inv-btn--tinta mt-6 min-h-[46px] w-full rounded-full px-7 active:scale-[0.98] sm:w-auto"
          >
            <span class="inv-swap">
              <span data-swap-a>Copiar CLABE</span>
              <span data-swap-b>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                Copiada
              </span>
            </span>
          </button>

          {lluvia.nota && (
            <p class="inv-quote mx-auto mt-6 max-w-xs text-[1.05rem]">{lluvia.nota}</p>
          )}
        </div>
      )
    }
  </div>
</section>
