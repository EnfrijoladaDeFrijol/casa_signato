---
interface Props {
  foto: { url: string; alt: string };
  variante?: 'arco' | 'banda';
  posicion?: string;
}

const { foto, variante = 'arco', posicion } = Astro.props;
const estiloImg = posicion ? `object-position: ${posicion}` : undefined;
---

{
  variante === 'arco' ? (
    <div class="inv-papel bg-[var(--bg)] px-6 py-16 sm:py-20">
      <figure class="relative mx-auto aspect-[4/5] w-full max-w-[290px]" data-reveal>
        <span
          class="pointer-events-none absolute inset-0 translate-x-3 translate-y-3 rounded-t-full border border-[var(--accent)]"
          aria-hidden="true"
        />
        <div class="interludio-arco relative h-full w-full overflow-hidden rounded-t-full border border-[var(--border-soft)]">
          <img
            src={foto.url}
            alt={foto.alt}
            style={estiloImg}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      </figure>
    </div>
  ) : (
    <figure class="relative h-64 w-full overflow-hidden sm:h-80" data-reveal>
      <div class="absolute inset-x-0 -top-[12%] h-[124%]" data-parallax data-parallax-max="30">
        <img
          src={foto.url}
          alt={foto.alt}
          style={estiloImg}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <span class="interludio-velo-sup pointer-events-none absolute inset-x-0 top-0 h-1/3" aria-hidden="true" />
      <span class="interludio-velo-inf pointer-events-none absolute inset-x-0 bottom-0 h-1/3" aria-hidden="true" />
    </figure>
  )
}

<style>
  .interludio-arco {
    box-shadow:
      0 18px 32px -14px color-mix(in srgb, var(--ink) 38%, transparent),
      0 3px 8px color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .interludio-velo-sup {
    background: linear-gradient(to bottom, color-mix(in srgb, var(--ink) 28%, transparent), transparent);
  }
  .interludio-velo-inf {
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 28%, transparent), transparent);
  }
</style>
