---
import BordeRasgado from './BordeRasgado.astro';

interface Props {
  foto: { url: string; alt: string };
  variante?: 'arco' | 'banda' | 'impresa' | 'cierre' | 'diptico';
  posicion?: string;
  /** Segundo retrato para la variante "diptico". */
  fotoSecundaria?: string;
  altSecundario?: string;
  compactoSuperior?: boolean;
  /** Pie editorial discreto debajo de la foto (solo en variante "impresa"). */
  pie?: string;
}

const {
  foto,
  variante = 'arco',
  posicion,
  fotoSecundaria,
  altSecundario,
  compactoSuperior = false,
  pie,
} = Astro.props;
const estiloImg = posicion ? `object-position: ${posicion}` : undefined;
---

{
  variante === 'arco' ? (
    <div
      class:list={[
        'inv-papel bg-[var(--bg)] px-6',
        compactoSuperior ? 'pb-7 pt-1 sm:pb-9 sm:pt-2' : 'py-8 sm:py-10',
      ]}
    >
      <figure class="relative mx-auto aspect-[4/5] w-full max-w-[316px] sm:max-w-[356px]" data-reveal>
        <span
          class="interludio-arco-marco pointer-events-none absolute -inset-1.5 rounded-t-full border sm:-inset-2"
          aria-hidden="true"
        />
        <div class="interludio-arco relative h-full w-full overflow-hidden rounded-t-full border border-[var(--border-soft)] bg-[var(--accent-soft)]">
          <img
            src={foto.url}
            alt={foto.alt}
            style={estiloImg}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          <span
            class="interludio-arco-filete pointer-events-none absolute inset-2.5 rounded-t-full border"
            aria-hidden="true"
          />
        </div>
      </figure>
    </div>
  ) : variante === 'impresa' ? (
    <div class="inv-papel bg-[var(--bg)] px-6 py-10 sm:py-14">
      <figure
        class="interludio-impresa mx-auto w-full max-w-[300px] rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--surface)] p-3 pb-5 sm:max-w-[340px] sm:p-4 sm:pb-6"
        data-reveal
      >
        <div class="interludio-impresa-foto relative aspect-[4/5] w-full overflow-hidden rounded-[0.75rem] bg-[var(--accent-soft)]">
          <img
            src={foto.url}
            alt={foto.alt}
            style={estiloImg ?? 'object-position: center 25%'}
            loading="lazy"
            decoding="async"
            class="interludio-impresa-img h-full w-full object-cover"
          />
        </div>
        {pie && (
          <figcaption class="mt-3 text-center font-display text-[0.8125rem] italic tracking-[0.04em] text-[var(--ink-muted)] sm:mt-4">
            {pie}
          </figcaption>
        )}
      </figure>
    </div>
  ) : variante === 'diptico' ? (
    <div class="inv-papel bg-[var(--bg)] px-6 py-10 sm:py-14">
      <div class="mx-auto grid max-w-md grid-cols-2 gap-3 sm:gap-5">
        <figure
          class="interludio-diptico relative aspect-[3/4] w-full overflow-hidden rounded-[1rem] border border-[var(--border-soft)] bg-[var(--accent-soft)]"
          data-reveal
        >
          <img
            src={foto.url}
            alt={foto.alt}
            style={estiloImg ?? 'object-position: center 20%'}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </figure>
        {fotoSecundaria && (
          <figure
            class="interludio-diptico relative mt-6 aspect-[3/4] w-full overflow-hidden rounded-[1rem] border border-[var(--border-soft)] bg-[var(--accent-soft)]"
            data-reveal
            style="--rv: 1"
          >
            <img
              src={fotoSecundaria}
              alt={altSecundario ?? foto.alt}
              style={estiloImg ?? 'object-position: center 20%'}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </figure>
        )}
      </div>
    </div>
  ) : variante === 'cierre' ? (
    <div class="relative bg-[var(--bg)]">
      <figure class="interludio-cierre relative aspect-[4/3] w-full overflow-hidden bg-[var(--accent-soft)] sm:aspect-[16/10]">
        <img
          src={foto.url}
          alt={foto.alt}
          style={estiloImg ?? 'object-position: center 20%'}
          loading="lazy"
          decoding="async"
          class="interludio-cierre-img h-full w-full object-cover"
        />
        <BordeRasgado posicion="superior" sombra="suave" class="h-6 sm:h-8" />
      </figure>
    </div>
  ) : (
    <div class="relative bg-[var(--bg)]">
      <figure class="relative aspect-[4/3] w-full overflow-hidden bg-[var(--accent-soft)] sm:aspect-[21/10]">
        <div class="absolute inset-x-0 -top-[12%] h-[124%]" data-parallax data-parallax-max="30">
          <img
            src={foto.url}
            alt={foto.alt}
            style={estiloImg ?? 'object-position: center 20%'}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <span class="interludio-velo-sup pointer-events-none absolute inset-x-0 top-0 h-1/4" aria-hidden="true" />
        <span class="interludio-velo-inf pointer-events-none absolute inset-x-0 bottom-0 h-1/4" aria-hidden="true" />
        <BordeRasgado posicion="superior" sombra="foto" class="h-6 sm:h-8" />
        <BordeRasgado posicion="inferior" sombra="foto" class="h-6 sm:h-8" />
      </figure>
    </div>
  )
}

<style>
  .interludio-arco {
    box-shadow:
      0 18px 32px -14px color-mix(in srgb, var(--ink) 36%, transparent),
      0 3px 8px color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .interludio-arco-marco {
    border-color: color-mix(in srgb, var(--accent) 48%, transparent);
  }
  .interludio-arco-filete {
    border-color: color-mix(in srgb, var(--bg) 42%, transparent);
  }
  .interludio-velo-sup {
    background: linear-gradient(to bottom, color-mix(in srgb, var(--ink) 24%, transparent), transparent);
  }
  .interludio-velo-inf {
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 24%, transparent), transparent);
  }
  .interludio-diptico {
    box-shadow: 0 14px 26px -16px color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .interludio-impresa {
    box-shadow:
      0 24px 40px -18px color-mix(in srgb, var(--ink) 30%, transparent),
      0 4px 12px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  @keyframes interludio-revelar {
    from {
      clip-path: inset(8% 6% 8% 6% round 0.75rem);
      transform: scale(1.05);
      opacity: 0.4;
    }
    to {
      clip-path: inset(0 0 0 0 round 0.75rem);
      transform: scale(1);
      opacity: 1;
    }
  }
  @keyframes interludio-escala {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .interludio-impresa-img {
        animation: interludio-revelar linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
      .interludio-cierre-img {
        animation: interludio-escala linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }
</style>
