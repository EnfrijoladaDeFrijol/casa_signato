---
import type { RsvpGoogleFormData, RsvpWhatsappData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import Ornamento from './Ornamento.astro';

interface Props {
  mostrarWhatsapp: boolean;
  mostrarGoogleForm: boolean;
  rsvpWhatsapp?: RsvpWhatsappData;
  rsvpGoogleForm?: RsvpGoogleFormData;
}

const { mostrarWhatsapp, mostrarGoogleForm, rsvpWhatsapp, rsvpGoogleForm } =
  Astro.props;

const telefonoLimpio = rsvpWhatsapp
  ? rsvpWhatsapp.telefono.replace(/\D/g, '')
  : '';
const urlWhatsapp =
  rsvpWhatsapp && telefonoLimpio
    ? `https://wa.me/${telefonoLimpio}?text=${encodeURIComponent(rsvpWhatsapp.mensajeBase)}`
    : '';

const fechaLimite = rsvpGoogleForm?.fechaLimite || rsvpWhatsapp?.fechaLimite;
const instruccion =
  rsvpGoogleForm?.instruccion && mostrarGoogleForm
    ? rsvpGoogleForm.instruccion
    : 'Tu confirmación nos ayuda a preparar cada detalle para recibirte como mereces.';
---

<section aria-labelledby="titulo-rsvp" data-tono="tinta">
  <div class="mx-auto max-w-xl text-center">
    <Ornamento class="mb-8" />
    <SeccionTitulo
      id="titulo-rsvp"
      eyebrow="Tu presencia"
      titulo="Confirmar Asistencia"
      lede={instruccion}
    />

    {
      fechaLimite && (
        <p class="inv-quote mt-6 text-[1.15rem] !text-[var(--bg)]" data-reveal style="--rv: 1">
          Fecha límite: {fechaLimite}
        </p>
      )
    }

    <div class="mx-auto mt-10 flex max-w-xs flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center" data-reveal style="--rv: 2">
      {
        mostrarGoogleForm && rsvpGoogleForm && (
          <a
            href={rsvpGoogleForm.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inv-btn inv-btn--invert active:scale-[0.98]"
          >
            {rsvpGoogleForm.etiquetaBoton || 'Confirmar en formulario'}
          </a>
        )
      }

      {
        mostrarWhatsapp && urlWhatsapp && rsvpWhatsapp && (
          <a
            href={urlWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'inv-btn active:scale-[0.98]',
              mostrarGoogleForm ? 'inv-btn--invert-line' : 'inv-btn--invert',
            ]}
          >
            {rsvpWhatsapp.etiquetaBoton || 'Confirmar por WhatsApp'}
          </a>
        )
      }
    </div>
  </div>
</section>
