---
import type { RsvpGoogleFormData, RsvpWhatsappData } from '../../types/invitacion';

interface Props {
  mostrarWhatsapp: boolean;
  mostrarGoogleForm: boolean;
  rsvpWhatsapp?: RsvpWhatsappData;
  rsvpGoogleForm?: RsvpGoogleFormData;
}

const { mostrarWhatsapp, mostrarGoogleForm, rsvpWhatsapp, rsvpGoogleForm } =
  Astro.props;

const telefonoLimpio = rsvpWhatsapp
  ? rsvpWhatsapp.telefono.replace(/\D/g, '')
  : '';
const urlWhatsapp =
  rsvpWhatsapp && telefonoLimpio
    ? `https://wa.me/${telefonoLimpio}?text=${encodeURIComponent(rsvpWhatsapp.mensajeBase)}`
    : '';

const fechaLimite = rsvpGoogleForm?.fechaLimite || rsvpWhatsapp?.fechaLimite;
---

<section class="px-4 py-12 sm:px-6" aria-labelledby="titulo-rsvp">
  <div class="mx-auto max-w-2xl rounded-3xl border border-[var(--border-soft)] bg-[var(--surface)] px-6 py-9 text-center sm:px-10">
    <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[var(--accent)]">
      Confirma tu lugar
    </p>
    <h2 id="titulo-rsvp" class="font-display mt-1 text-3xl font-semibold text-[var(--ink)] sm:text-4xl">
      Confirmar Asistencia
    </h2>

    {
      rsvpGoogleForm?.instruccion && mostrarGoogleForm ? (
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[var(--ink-muted)]">
          {rsvpGoogleForm.instruccion}
        </p>
      ) : (
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[var(--ink-muted)]">
          Tu confirmación nos ayuda a preparar cada detalle para recibirte como mereces.
        </p>
      )
    }

    {
      fechaLimite && (
        <p class="mt-2 text-xs font-medium text-[var(--accent)]">
          Fecha límite de confirmación: {fechaLimite}
        </p>
      )
    }

    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      {
        mostrarGoogleForm && rsvpGoogleForm && (
          <a
            href={rsvpGoogleForm.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--accent)] px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--surface)] transition-opacity hover:opacity-90 sm:w-auto"
          >
            {rsvpGoogleForm.etiquetaBoton || 'Confirmar en formulario'}
          </a>
        )
      }

      {
        mostrarWhatsapp && urlWhatsapp && rsvpWhatsapp && (
          <a
            href={urlWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.14em] transition-colors sm:w-auto',
              mostrarGoogleForm
                ? 'border border-[var(--border-soft)] text-[var(--ink)] hover:bg-[var(--accent-soft)]'
                : 'bg-[var(--accent)] text-[var(--surface)] hover:opacity-90',
            ]}
          >
            {rsvpWhatsapp.etiquetaBoton || 'Confirmar por WhatsApp'}
          </a>
        )
      }
    </div>
  </div>
</section>
