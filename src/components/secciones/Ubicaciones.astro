---
import type { UbicacionItem } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  ubicaciones: UbicacionItem[];
}

const { ubicaciones } = Astro.props;
const varias = ubicaciones.length > 1;

function partirHora(hora: string): { numero: string; sufijo: string } {
  const coincidencia = /^(\d{1,2}[:.]\d{2})\s*(.*)$/.exec(hora.trim());
  return coincidencia
    ? { numero: coincidencia[1], sufijo: coincidencia[2] }
    : { numero: hora, sufijo: '' };
}
---

<section aria-labelledby="titulo-ubicaciones">
  <div class="mx-auto max-w-4xl">
    <SeccionTitulo id="titulo-ubicaciones" eyebrow="Dónde y cuándo" titulo="Ubicaciones" />

    <div
      class:list={[
        'mx-auto mt-14 grid max-w-md divide-y divide-[var(--border-soft)]',
        varias && 'md:max-w-none md:grid-cols-2 md:divide-x md:divide-y-0',
      ]}
    >
      {
        ubicaciones.map((lugar, i) => {
          const hora = partirHora(lugar.hora);
          return (
            <article
              class="py-12 text-center first:pt-0 last:pb-0 md:px-10 md:py-0"
              data-reveal
              style={`--rv: ${i}`}
            >
              <p class="inv-eyebrow">{lugar.tipo}</p>
              <p class="inv-num mt-5 text-[3.5rem] leading-none">
                {hora.numero}
                {hora.sufijo && (
                  <span class="ml-2 align-baseline font-body text-[0.6875rem] font-semibold uppercase tracking-[0.22em] text-[var(--ink-muted)]">
                    {hora.sufijo}
                  </span>
                )}
              </p>

              <h3 class="mt-6 font-display text-[1.75rem] font-medium italic leading-tight text-[var(--ink)]">
                {lugar.nombre}
              </h3>
              <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-[var(--ink-muted)]">
                {lugar.direccion}
              </p>
              {lugar.referencia && (
                <p class="mx-auto mt-3 max-w-xs font-display text-base italic text-[var(--ink-muted)]">
                  {lugar.referencia}
                </p>
              )}

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
                <a
                  href={lugar.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-abrir-mapa
                  class="inv-btn inv-btn--solid active:scale-[0.98]"
                >
                  <span class="inv-swap">
                    <span data-swap-a>
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21z" />
                        <circle cx="12" cy="10.5" r="2.2" />
                      </svg>
                      Google Maps
                    </span>
                    <span data-swap-b>Abriendo mapa…</span>
                  </span>
                </a>

                {lugar.wazeUrl && (
                  <a
                    href={lugar.wazeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-abrir-mapa
                    class="inv-btn inv-btn--line active:scale-[0.98]"
                  >
                    <span class="inv-swap">
                      <span data-swap-a>Waze</span>
                      <span data-swap-b>Abriendo…</span>
                    </span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
