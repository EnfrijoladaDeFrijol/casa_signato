---
import type { UbicacionItem } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import InvitacionIcono from './InvitacionIcono.astro';

interface Props {
  ubicaciones: UbicacionItem[];
}

const { ubicaciones } = Astro.props;
const varias = ubicaciones.length > 1;

function iconoDe(tipo: string): 'iglesia' | 'copas' {
  return /ceremonia|misa|iglesia|parroquia|templo|boda/i.test(tipo) ? 'iglesia' : 'copas';
}
---

<section aria-labelledby="titulo-ubicaciones" class="inv-papel">
  <div class="mx-auto max-w-4xl">
    <SeccionTitulo id="titulo-ubicaciones" eyebrow="Dónde y cuándo" titulo="Ubicaciones" />

    <div
      class:list={[
        'mx-auto mt-14 grid max-w-md',
        varias && 'md:max-w-none md:grid-cols-2 md:gap-x-12',
      ]}
    >
      {
        ubicaciones.map((lugar, i) => {
          const tieneFoto = Boolean(lugar.foto);
          return (
            <article
              class:list={[
                'flex flex-col items-center text-center',
                i > 0 && 'mt-12 border-t border-[var(--border-soft)] pt-12 md:mt-0 md:border-t-0 md:border-l md:pl-12 md:pt-0',
              ]}
              data-reveal
              style={`--rv: ${i}`}
            >
              {tieneFoto ? (
                <div
                  class="mb-7 aspect-[16/10] w-full overflow-hidden rounded-[1.5rem] bg-[var(--accent-soft)]"
                  data-reveal="foto-lugar"
                  style={`--rv: ${i}`}
                >
                  <img
                    src={lugar.foto}
                    alt={lugar.fotoAlt ?? `${lugar.tipo}: ${lugar.nombre}`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03]"
                  />
                </div>
              ) : (
                <InvitacionIcono
                  nombre={iconoDe(lugar.tipo)}
                  class="inv-icon-draw mb-5 h-10 w-10 text-[var(--ink)] opacity-85"
                />
              )}

              <p class="inv-num text-[1.55rem] font-medium tracking-[0.06em] text-[var(--ink)]">
                {lugar.hora}
              </p>
              <p class="mt-1.5 text-[0.75rem] font-semibold uppercase tracking-[0.26em] text-[var(--accent)]">
                {lugar.tipo}
              </p>

              <h3 class="mt-3 font-display text-[1.75rem] font-medium italic leading-tight text-[var(--ink)]">
                {lugar.nombre}
              </h3>

              <p class="mx-auto mt-2.5 max-w-xs text-sm leading-relaxed text-[var(--ink-muted)]">
                {lugar.direccion}
              </p>

              {lugar.referencia && (
                <p class="mx-auto mt-2 max-w-xs font-display text-base italic text-[var(--ink-muted)]">
                  {lugar.referencia}
                </p>
              )}

              <div class="mt-auto flex w-full flex-col items-center justify-center gap-3 pt-7 sm:flex-row">
                <a
                  href={lugar.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-abrir-mapa
                  class="inv-btn inv-btn--tinta min-h-[46px] w-full rounded-full px-7 active:scale-[0.98] sm:w-auto"
                >
                  <span class="inv-swap">
                    <span data-swap-a>Ver ubicación</span>
                    <span data-swap-b>Abriendo mapa…</span>
                  </span>
                </a>

                {lugar.wazeUrl && (
                  <a
                    href={lugar.wazeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-abrir-mapa
                    class="inv-btn min-h-[46px] w-full rounded-full border-[var(--border-soft)] px-6 text-[var(--ink)] hover:border-[var(--ink)] active:scale-[0.98] sm:w-auto"
                  >
                    <span class="inv-swap">
                      <span data-swap-a>Waze</span>
                      <span data-swap-b>Abriendo…</span>
                    </span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
