---
import type { IconoItinerario, ItinerarioItem } from '../../types/invitacion';
import InvitacionIcono, { type NombreIcono } from './InvitacionIcono.astro';
import BordeRasgado from './BordeRasgado.astro';

interface Props {
  itinerario: ItinerarioItem[];
}

const { itinerario } = Astro.props;

function mapearIcono(icono?: IconoItinerario): NombreIcono {
  switch (icono) {
    case 'ceremonia':
      return 'iglesia';
    case 'recepcion':
      return 'pin';
    case 'brindis':
      return 'coctel';
    case 'cena':
      return 'plato';
    case 'vals':
      return 'anillos';
    case 'baile':
      return 'esfera';
    case 'pastel':
      return 'pastel';
    default:
      return 'reloj';
  }
}

function formatearEtiquetaHora(hora: string): string {
  const limpia = hora.trim();
  return /hrs|am|pm/i.test(limpia) ? limpia : `${limpia} hrs`;
}
---

<section aria-labelledby="titulo-itinerario" data-tono="banda-rasgada" class="inv-papel itinerario-banda">
  <BordeRasgado posicion="superior" />

  <div class="mx-auto max-w-md">
    <div class="text-center" data-reveal>
      <p class="inv-eyebrow">Paso a paso</p>
      <h2
        id="titulo-itinerario"
        class="mt-2 font-display text-[clamp(1.55rem,6vw,2.15rem)] font-medium uppercase tracking-[0.18em] text-[var(--ink)]"
      >
        Itinerario de Actividades
      </h2>
    </div>

    <ol class="relative mx-auto mt-12 max-w-[22rem] sm:max-w-sm" data-itinerario-lista>
      <div
        data-itinerario-pista
        class="pointer-events-none absolute top-4 bottom-4 left-[4.875rem] w-px -translate-x-1/2 sm:left-[5.5rem]"
        aria-hidden="true"
      >
        <span class="block h-full w-full bg-[var(--ink)] opacity-25"></span>
        <span
          data-itinerario-progreso
          class="itinerario-linea-viva absolute inset-0 block h-full w-full origin-top bg-[var(--ink)]"
        ></span>
      </div>

      {
        itinerario.map((momento, i) => (
          <li
            class="group grid grid-cols-[3.25rem_1.75rem_1fr] items-start gap-x-3 pb-10 last:pb-0 sm:grid-cols-[3.75rem_2rem_1fr] sm:gap-x-3.5"
            data-reveal
            style={`--rv: ${Math.min(i, 5)}`}
          >
            <div class="flex justify-center pt-0.5 text-[var(--ink)] opacity-85">
              <InvitacionIcono nombre={mapearIcono(momento.icono)} class="inv-icon-draw h-8 w-8 sm:h-9 sm:w-9" />
            </div>

            <div class="relative flex justify-center pt-2">
              <span
                data-itinerario-nodo
                class="itinerario-nodo relative z-10 block h-2 w-2 rounded-full bg-[var(--ink)]"
                aria-hidden="true"
              />
            </div>

            <div class="min-w-0 pt-0.5">
              <p class="inv-script text-[1.2rem] leading-none text-[var(--ink)] opacity-80 [font-variant-numeric:tabular-nums]">
                {formatearEtiquetaHora(momento.hora)}
              </p>
              <h3 class="inv-script mt-1 text-[1.85rem] font-medium leading-[1.12] text-[var(--ink)] sm:text-[2.1rem]">
                {momento.titulo}
              </h3>
              {momento.descripcion && (
                <p class="mt-1 text-xs leading-relaxed text-[var(--ink-muted)]">
                  {momento.descripcion}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <BordeRasgado posicion="inferior" />
</section>

<style>
  .itinerario-banda {
    background-image:
      radial-gradient(
        ellipse 85% 60% at 22% 28%,
        color-mix(in srgb, var(--accent) 20%, var(--bg)) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 75% 55% at 80% 74%,
        color-mix(in srgb, var(--accent) 18%, var(--bg)) 0%,
        transparent 72%
      );
  }
  .itinerario-nodo {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, var(--bg));
  }
  .itinerario-linea-viva {
    transform: scaleY(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .itinerario-linea-viva {
      transform: scaleY(0);
      will-change: transform;
    }
  }
</style>

<script>
  const listas = document.querySelectorAll<HTMLElement>('[data-itinerario-lista]');
  const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  listas.forEach((lista) => {
    const pista = lista.querySelector<HTMLElement>('[data-itinerario-pista]');
    const lineaViva = lista.querySelector<HTMLElement>('[data-itinerario-progreso]');
    const nodos = lista.querySelectorAll<HTMLElement>('[data-itinerario-nodo]');
    const items = lista.querySelectorAll<HTMLElement>(':scope > li');

    if (!pista || !lineaViva || items.length < 2 || nodos.length < 2) {
      if (pista && items.length < 2) pista.style.display = 'none';
      return;
    }

    const ajustarExtremos = () => {
      const primero = nodos[0];
      const ultimo = nodos[nodos.length - 1];
      const padrePrimero = primero.offsetParent as HTMLElement | null;
      const xCentro = (padrePrimero ? padrePrimero.offsetLeft : 0) + primero.offsetLeft + primero.offsetWidth / 2;
      const inicio = items[0].offsetTop + primero.offsetTop + primero.offsetHeight / 2;
      const fin = items[items.length - 1].offsetTop + ultimo.offsetTop + ultimo.offsetHeight / 2;
      pista.style.left = `${xCentro}px`;
      pista.style.top = `${inicio}px`;
      pista.style.bottom = 'auto';
      pista.style.height = `${Math.max(0, fin - inicio)}px`;
    };

    ajustarExtremos();

    if (reducirMovimiento) {
      lineaViva.style.transform = 'scaleY(1)';
      window.addEventListener('resize', ajustarExtremos, { passive: true });
      return;
    }

    let rafId = 0;
    const actualizarLinea = () => {
      rafId = 0;
      const rect = pista.getBoundingClientRect();
      const altoVentana = window.innerHeight || document.documentElement.clientHeight;
      const pivote = altoVentana * 0.72;
      const progreso = rect.height > 0 ? Math.min(1, Math.max(0, (pivote - rect.top) / rect.height)) : 1;
      lineaViva.style.transform = `scaleY(${progreso})`;
    };

    const programar = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(actualizarLinea);
    };

    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', () => { ajustarExtremos(); programar(); }, { passive: true });
    window.addEventListener('pageshow', () => { ajustarExtremos(); actualizarLinea(); });
    actualizarLinea();
  });
</script>
