---
import type { IconoItinerario, ItinerarioItem } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  itinerario: ItinerarioItem[];
}

const { itinerario } = Astro.props;

function obtenerTrazo(icono?: IconoItinerario): string {
  switch (icono) {
    case 'ceremonia':
      return 'M12 3v18M7 8h10';
    case 'brindis':
      return 'M8 4h8l-1.5 6a2.5 2.5 0 0 1-5 0L8 4zm4 8.5V20m-3 0h6';
    case 'cena':
      return 'M7 4v7a2 2 0 0 0 2 2v7m6-16v16m0-16a3 3 0 0 1 3 5v2h-3';
    case 'vals':
    case 'baile':
      return 'M9 18V6l10-2v12M9 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10-2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z';
    case 'pastel':
      return 'M5 12h14v7H5zm2-4h10v4H7zm5-4v4';
    default:
      return 'M12 6v6l4 2m5-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z';
  }
}
---

<section aria-labelledby="titulo-itinerario">
  <div class="mx-auto max-w-xl">
    <SeccionTitulo id="titulo-itinerario" eyebrow="Paso a paso" titulo="Itinerario del Evento" />

    <ol class="relative mt-14" data-itinerario-lista>
      <div
        data-itinerario-pista
        class="pointer-events-none absolute top-3 bottom-3 left-[calc(4.4rem+1.5rem)] w-px -translate-x-1/2"
        aria-hidden="true"
      >
        <span class="block h-full w-full bg-[var(--border-soft)] opacity-50"></span>
        <span
          data-itinerario-progreso
          class="itinerario-linea-viva absolute inset-0 block h-full w-full origin-top bg-[var(--accent)]"
        ></span>
      </div>

      {
        itinerario.map((momento, i) => (
          <li
            class="group grid grid-cols-[4.4rem_1fr] gap-x-6"
            data-reveal
            style={`--rv: ${Math.min(i, 5)}`}
          >
            <span class="inv-num pt-0.5 text-right text-[1.75rem] leading-none">
              {momento.hora}
            </span>
            <div class="relative pb-11 pl-8 group-last:pb-0">
              <span
                data-itinerario-nodo
                class="itinerario-nodo absolute -left-[12px] top-0 z-10 flex h-6 w-6 items-center justify-center rounded-full border border-[var(--accent)] bg-[var(--bg)] text-[var(--accent)]"
                aria-hidden="true"
              >
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={obtenerTrazo(momento.icono)} />
                </svg>
              </span>
              <h3 class="font-display text-[1.55rem] font-medium italic leading-tight text-[var(--ink)]">
                {momento.titulo}
              </h3>
              {momento.descripcion && (
                <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">
                  {momento.descripcion}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .itinerario-linea-viva {
    transform: scaleY(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .itinerario-linea-viva {
      transform: scaleY(0);
      will-change: transform;
    }

    :global(.js) li[data-reveal] .itinerario-nodo {
      transform: scale(0.84);
      transition: transform 0.65s var(--ease);
      transition-delay: calc(var(--rv, 0) * 90ms + 80ms);
    }

    :global(.js) li[data-reveal].is-visible .itinerario-nodo {
      transform: scale(1);
    }
  }
</style>

<script>
  const listas = document.querySelectorAll<HTMLElement>('[data-itinerario-lista]');
  const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  listas.forEach((lista) => {
    const pista = lista.querySelector<HTMLElement>('[data-itinerario-pista]');
    const lineaViva = lista.querySelector<HTMLElement>('[data-itinerario-progreso]');
    const items = lista.querySelectorAll<HTMLElement>(':scope > li');

    if (!pista || !lineaViva || items.length < 2) {
      if (pista && items.length < 2) pista.style.display = 'none';
      return;
    }

    // Usa offsetTop (geometría de layout inmune a transformaciones de reveal)
    const ajustarExtremos = () => {
      const inicio = items[0].offsetTop + 12;
      const fin = items[items.length - 1].offsetTop + 12;
      pista.style.top = `${inicio}px`;
      pista.style.bottom = 'auto';
      pista.style.height = `${Math.max(0, fin - inicio)}px`;
    };

    ajustarExtremos();

    if (reducirMovimiento) {
      lineaViva.style.transform = 'scaleY(1)';
      window.addEventListener('resize', ajustarExtremos, { passive: true });
      return;
    }

    let rafId = 0;

    const actualizarLinea = () => {
      rafId = 0;
      const rect = pista.getBoundingClientRect();
      const altoVentana = window.innerHeight || document.documentElement.clientHeight;
      const pivote = altoVentana * 0.72;
      const progreso =
        rect.height > 0
          ? Math.min(1, Math.max(0, (pivote - rect.top) / rect.height))
          : 1;
      lineaViva.style.transform = `scaleY(${progreso})`;
    };

    const programar = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(actualizarLinea);
    };

    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', () => {
      ajustarExtremos();
      programar();
    }, { passive: true });
    window.addEventListener('pageshow', () => {
      ajustarExtremos();
      actualizarLinea();
    });
    actualizarLinea();
  });
</script>
