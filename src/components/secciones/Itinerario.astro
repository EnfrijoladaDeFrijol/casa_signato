---
import type { IconoItinerario, ItinerarioItem } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  itinerario: ItinerarioItem[];
}

const { itinerario } = Astro.props;

function obtenerTrazo(icono?: IconoItinerario): string {
  switch (icono) {
    case 'ceremonia':
      return 'M12 3v18M7 8h10';
    case 'brindis':
      return 'M8 4h8l-1.5 6a2.5 2.5 0 0 1-5 0L8 4zm4 8.5V20m-3 0h6';
    case 'cena':
      return 'M7 4v7a2 2 0 0 0 2 2v7m6-16v16m0-16a3 3 0 0 1 3 5v2h-3';
    case 'vals':
    case 'baile':
      return 'M9 18V6l10-2v12M9 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10-2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z';
    case 'pastel':
      return 'M5 12h14v7H5zm2-4h10v4H7zm5-4v4';
    default:
      return 'M12 6v6l4 2m5-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z';
  }
}
---

<section aria-labelledby="titulo-itinerario">
  <div class="mx-auto max-w-xl">
    <SeccionTitulo id="titulo-itinerario" eyebrow="Paso a paso" titulo="Itinerario del Evento" />

    <ol class="mt-14">
      {
        itinerario.map((momento) => (
          <li class="group grid grid-cols-[4.4rem_1fr] gap-x-6" data-reveal>
            <span class="inv-num pt-0.5 text-right text-[1.75rem] leading-none">
              {momento.hora}
            </span>
            <div class="relative border-l border-[var(--border-soft)] pb-11 pl-8 group-last:border-transparent group-last:pb-0">
              <span
                class="absolute -left-[12px] top-0 flex h-6 w-6 items-center justify-center rounded-full border border-[var(--accent)] bg-[var(--bg)] text-[var(--accent)]"
                aria-hidden="true"
              >
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={obtenerTrazo(momento.icono)} />
                </svg>
              </span>
              <h3 class="font-display text-[1.55rem] font-medium italic leading-tight text-[var(--ink)]">
                {momento.titulo}
              </h3>
              {momento.descripcion && (
                <p class="mt-2 text-sm leading-relaxed text-[var(--ink-muted)]">
                  {momento.descripcion}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
