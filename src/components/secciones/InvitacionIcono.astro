---
// Biblioteca central de iconografía editorial lineal (trazo fino 1.25px, 100% clásico, cero botánico).
// Visible por defecto; anima suavemente su trazado al recibir `.is-visible`.
export type NombreIcono =
  | 'anillos'
  | 'rama'
  | 'iglesia'
  | 'copas'
  | 'coctel'
  | 'plato'
  | 'esfera'
  | 'pastel'
  | 'vestimenta'
  | 'regalo'
  | 'sobre'
  | 'mensaje'
  | 'calendario'
  | 'reloj'
  | 'pin'
  | 'camara'
  | 'destello';

interface Props {
  nombre: NombreIcono;
  class?: string;
}

const { nombre, class: clase } = Astro.props;
const viewBox = nombre === 'rama' ? '0 0 96 28' : '0 0 24 24';
---

<svg
  class={clase}
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nombre === 'anillos' && (
      <>
        <circle cx="9" cy="14.5" r="5" pathLength="100" />
        <circle cx="15" cy="14.5" r="5" pathLength="100" />
        <path d="M7.7 5.6 9 3.8l1.3 1.8L9 7.4z" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'rama' && (
      <>
        <path d="M10 14h31M55 14h31" pathLength="100" />
        <path d="M48 10.2 51.8 14 48 17.8 44.2 14Z" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'iglesia' && (
      <>
        <path d="M12 2.5v4M10.3 4.2h3.4" pathLength="100" />
        <path d="M6 20.5v-9l6-4.5 6 4.5v9" pathLength="100" />
        <path d="M10 20.5v-4a2 2 0 0 1 4 0v4" pathLength="100" />
        <path d="M3.5 20.5h17" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'copas' && (
      <>
        <path d="M4.5 3.5h6l-.6 5a2.4 2.4 0 0 1-4.8 0z" pathLength="100" />
        <path d="M7.5 11v8M5 19.5h5" pathLength="100" />
        <path d="M13.5 3.5h6l-.6 5a2.4 2.4 0 0 1-4.8 0z" pathLength="100" />
        <path d="M16.5 11v8M14 19.5h5" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'coctel' && (
      <>
        <path d="M5 4.5h14L12 12.5 5 4.5z" pathLength="100" />
        <path d="M12 12.5v7M8.5 19.5h7" pathLength="100" />
        <path d="M14.5 3l2.5 3.5" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'plato' && (
      <>
        <circle cx="12" cy="12" r="5.5" pathLength="100" />
        <circle cx="12" cy="12" r="3.2" pathLength="100" />
        <path d="M3.5 5.5v5a1.5 1.5 0 0 0 1.5 1.5v6.5M5 5.5v4" pathLength="100" />
        <path d="M20.5 5.5v13M20.5 5.5c-1.6 0-2.3 1.8-2.3 4.2v1.8h2.3" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'esfera' && (
      <>
        <path d="M12 2.5v2.5" pathLength="100" />
        <circle cx="12" cy="13" r="7.5" pathLength="100" />
        <path d="M4.8 13h14.4M6 9.5h12M6 16.5h12" pathLength="100" />
        <path d="M12 5.5c2.4 2.2 2.4 12.8 0 15M12 5.5c-2.4 2.2-2.4 12.8 0 15" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'pastel' && (
      <>
        <path d="M5 13.5h14v5.5H5z" pathLength="100" />
        <path d="M7.5 9.5h9v4h-9z" pathLength="100" />
        <path d="M12 5.5v4M3.5 19h17" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'vestimenta' && (
      <>
        <path d="M12 4.5a2 2 0 1 1 2 2c0 1-2 1.4-2 2.5L3.5 15a1 1 0 0 0 .6 1.8h15.8a1 1 0 0 0 .6-1.8L12 9" pathLength="100" />
        <path d="M7 19.5h10" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'regalo' && (
      <>
        <path d="M4.5 11.5h15v8.5h-15z" pathLength="100" />
        <path d="M3.5 7.8h17v3.7h-17z" pathLength="100" />
        <path d="M12 7.8V20" pathLength="100" />
        <path d="M12 7.8C9.2 7.8 7.6 6.4 8.1 5.2c.8-1.6 3 .1 3.9 2.6.9-2.5 3.1-4.2 3.9-2.6.5 1.2-1.1 2.6-3.9 2.6z" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'sobre' && (
      <>
        <path d="M3.5 6.5h17v11h-17z" pathLength="100" />
        <path d="M3.8 7.2 12 13.5l8.2-6.3" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'mensaje' && (
      <>
        <path d="M12 3.8a8.2 8.2 0 0 0-7.1 12.3L3.8 20.2l4.3-1.1A8.2 8.2 0 1 0 12 3.8z" pathLength="100" />
        <path d="M9.4 9.5c.3-.6.8-.7 1.2-.4l.9 1.2c.2.3.1.7-.2 1l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.3-.3.7-.4 1-.2l1.2.9c.3.4.2.9-.4 1.2-1.2.6-3.1.1-4.6-1.4-1.5-1.5-2-3.4-1.4-4.6z" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'calendario' && (
      <>
        <path d="M4.5 6h15v14h-15z" pathLength="100" />
        <path d="M4.5 10.5h15" pathLength="100" />
        <path d="M8.5 3.5v4M15.5 3.5v4" pathLength="100" />
        <path d="M8 14h2M14 14h2M8 17h2" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'reloj' && (
      <>
        <circle cx="12" cy="12" r="8.5" pathLength="100" />
        <path d="M12 7.5V12l3 2" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21z" pathLength="100" />
        <circle cx="12" cy="10.5" r="2.2" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'camara' && (
      <>
        <path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z" pathLength="100" />
        <circle cx="12" cy="13.2" r="3.3" pathLength="100" />
      </>
    )
  }
  {
    nombre === 'destello' && (
      <>
        <path d="M11 3c.6 4.6 1.9 6.4 7 7-5.1.6-6.4 2.4-7 7-.6-4.6-1.9-6.4-7-7 5.1-.6 6.4-2.4 7-7z" pathLength="100" />
        <path d="M19 17v3.5M17.25 18.75h3.5" pathLength="100" />
      </>
    )
  }
</svg>
