---
// Biblioteca central de iconografía editorial (trazo fino consistente).
// Con la clase `inv-icon-draw` los trazos se dibujan al revelarse en scroll.
export type NombreIcono =
  | 'anillos'
  | 'rama'
  | 'iglesia'
  | 'copas'
  | 'vestimenta'
  | 'regalo'
  | 'sobre'
  | 'calendario'
  | 'reloj'
  | 'pin'
  | 'camara'
  | 'destello';

interface Props {
  nombre: NombreIcono;
  class?: string;
}

const { nombre, class: clase } = Astro.props;
const viewBox = nombre === 'rama' ? '0 0 96 28' : '0 0 24 24';
---

<svg
  class={clase}
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nombre === 'anillos' && (
      <>
        <circle cx="9" cy="14.5" r="5" pathLength="1" stroke="currentColor" />
        <circle cx="15" cy="14.5" r="5" pathLength="1" stroke="currentColor" />
        <path d="M7.7 5.6 9 3.8l1.3 1.8L9 7.4z" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'rama' && (
      <>
        <path d="M6 14C24 9 38 19 48 14S72 9 90 14" pathLength="1" stroke="currentColor" />
        <path d="M22 11.5c-2-4-.5-7 3-8 1.4 3.4.4 6.6-3 8z" pathLength="1" stroke="currentColor" />
        <path d="M34 15.6c-3 3.4-3.2 6.8-1.2 9 3-1.4 4.4-5 1.2-9z" pathLength="1" stroke="currentColor" />
        <path d="M62 15.6c3 3.4 3.2 6.8 1.2 9-3-1.4-4.4-5-1.2-9z" pathLength="1" stroke="currentColor" />
        <path d="M74 11.5c2-4 .5-7-3-8-1.4 3.4-.4 6.6 3 8z" pathLength="1" stroke="currentColor" />
        <path d="M44 14.4c-1.2-2.6-.4-4.6 1.6-5.6M52 14.4c1.2-2.6.4-4.6-1.6-5.6" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'iglesia' && (
      <>
        <path d="M12 2.5v4M10.3 4.2h3.4" pathLength="1" stroke="currentColor" />
        <path d="M6 20.5V11.5l6-4.5 6 4.5v9" pathLength="1" stroke="currentColor" />
        <path d="M10 20.5v-4a2 2 0 0 1 4 0v4" pathLength="1" stroke="currentColor" />
        <path d="M3.5 20.5h17" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'copas' && (
      <>
        <path d="M4.5 3.5h6l-.6 5a2.4 2.4 0 0 1-4.8 0z" pathLength="1" stroke="currentColor" />
        <path d="M7.5 11v8M5 19.5h5" pathLength="1" stroke="currentColor" />
        <path d="M13.5 3.5h6l-.6 5a2.4 2.4 0 0 1-4.8 0z" pathLength="1" stroke="currentColor" />
        <path d="M16.5 11v8M14 19.5h5" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'vestimenta' && (
      <>
        <path d="M12 4.5a2 2 0 1 1 2 2c0 1-2 1.4-2 2.5L3.5 15a1 1 0 0 0 .6 1.8h15.8a1 1 0 0 0 .6-1.8L12 9" pathLength="1" stroke="currentColor" />
        <path d="M7 19.5h10" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'regalo' && (
      <>
        <path d="M4.5 11.5h15v8.5h-15z" pathLength="1" stroke="currentColor" />
        <path d="M3.5 7.8h17v3.7h-17z" pathLength="1" stroke="currentColor" />
        <path d="M12 7.8V20" pathLength="1" stroke="currentColor" />
        <path d="M12 7.8C9.2 7.8 7.6 6.4 8.1 5.2c.8-1.6 3 .1 3.9 2.6 .9-2.5 3.1-4.2 3.9-2.6.5 1.2-1.1 2.6-3.9 2.6z" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'sobre' && (
      <>
        <path d="M3.5 6.5h17v11h-17z" pathLength="1" stroke="currentColor" />
        <path d="M3.8 7.2 12 13.5l8.2-6.3" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'calendario' && (
      <>
        <path d="M4.5 6h15v14h-15z" pathLength="1" stroke="currentColor" />
        <path d="M4.5 10.5h15" pathLength="1" stroke="currentColor" />
        <path d="M8.5 3.5v4M15.5 3.5v4" pathLength="1" stroke="currentColor" />
        <path d="M8 14h2M14 14h2M8 17h2" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'reloj' && (
      <>
        <circle cx="12" cy="12" r="8.5" pathLength="1" stroke="currentColor" />
        <path d="M12 7.5V12l3 2" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21z" pathLength="1" stroke="currentColor" />
        <circle cx="12" cy="10.5" r="2.2" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'camara' && (
      <>
        <path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z" pathLength="1" stroke="currentColor" />
        <circle cx="12" cy="13.2" r="3.3" pathLength="1" stroke="currentColor" />
      </>
    )
  }
  {
    nombre === 'destello' && (
      <>
        <path d="M11 3c.6 4.6 1.9 6.4 7 7-5.1.6-6.4 2.4-7 7-.6-4.6-1.9-6.4-7-7 5.1-.6 6.4-2.4 7-7z" pathLength="1" stroke="currentColor" />
        <path d="M19 17v3.5M17.25 18.75h3.5" pathLength="1" stroke="currentColor" />
      </>
    )
  }
</svg>
