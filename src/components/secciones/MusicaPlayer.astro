---
import type { MusicaData } from '../../types/invitacion';

interface Props {
  musica: MusicaData;
}

const { musica } = Astro.props;
const esModoDemo = Boolean(musica.modoDemo) || !musica.audioUrl.trim();
---

<aside
  class="pointer-events-none fixed bottom-4 right-4 z-40 flex flex-col items-center gap-2"
  aria-label="Reproductor de música de fondo"
  data-musica-widget
  data-modo-demo={esModoDemo ? 'true' : 'false'}
  data-musica-titulo={musica.titulo}
>
  {!esModoDemo && <audio data-musica-audio preload="metadata" loop src={musica.audioUrl} />}

  <!-- Etiqueta breve en móvil a la izquierda del botón Play/Pausa -->
  <div
    data-musica-toast
    aria-hidden="true"
    class="musica-toast pointer-events-none absolute bottom-0 right-[calc(100%+0.5rem)] z-10 flex h-11 w-max max-w-[min(56vw,210px)] flex-col justify-center rounded-full border border-[var(--border-soft)] px-3.5 text-right backdrop-blur-md sm:hidden"
  >
    <span class="block max-w-full truncate text-[11px] font-semibold leading-tight text-[var(--ink)]">
      {musica.titulo}
    </span>
    <span data-musica-toast-estado class="block max-w-full truncate text-[10px] leading-tight text-[var(--ink-muted)]">
      {musica.artista || 'Música del evento'}
    </span>
  </div>

  <!-- Volumen discreto: oculto en iOS y mientras no suena -->
  <div class="pointer-events-none relative z-20 flex flex-col items-center gap-2" data-volumen-grupo hidden>
    <div
      data-volumen-panel
      class="musica-vol-panel z-30 flex h-28 w-9 items-center justify-center rounded-full border border-[var(--border-soft)] backdrop-blur-md"
      aria-hidden="true"
    >
      <input
        type="range"
        min="0"
        max="100"
        step="1"
        value="45"
        data-volumen-slider
        aria-label="Volumen de la música"
        class="musica-vol-slider"
        tabindex="-1"
      />
    </div>
    <button
      type="button"
      data-volumen-disparador
      aria-expanded="false"
      aria-label="Ajustar volumen"
      class="musica-vol-disparador pointer-events-auto relative z-20 flex h-8 w-8 items-center justify-center rounded-full border border-[var(--border-soft)] p-0 text-[var(--ink)] backdrop-blur-md"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" />
        <path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
      </svg>
    </button>
  </div>

  <button
    type="button"
    data-musica-boton
    aria-pressed="false"
    aria-label={`Reproducir música: ${musica.titulo}`}
    class="musica-boton pointer-events-auto relative z-20 flex h-11 w-11 items-center justify-center rounded-full border border-[var(--border-soft)] p-0 text-left text-xs font-medium text-[var(--ink)] backdrop-blur-md transition-[scale,border-color] duration-200 active:scale-[0.98] sm:h-12 sm:w-auto sm:gap-3 sm:py-1.5 sm:pl-1.5 sm:pr-5"
  >
    <span class="relative flex h-full w-full shrink-0 items-center justify-center rounded-full text-[var(--accent)] sm:h-9 sm:w-9 sm:bg-[var(--accent)] sm:text-[var(--surface)]">
      <span class="musica-halo" aria-hidden="true"></span>
      <span class="relative z-10 flex items-center justify-center">
        <svg data-icono-play class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="M8.5 5.5v13l10-6.5-10-6.5z" />
        </svg>
        <svg data-icono-pause class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M9 6v12M15 6v12" />
        </svg>
      </span>
    </span>

    <span class="hidden max-w-[155px] truncate sm:block">
      <span class="block truncate font-semibold leading-tight">{musica.titulo}</span>
      <span data-musica-estado class="block truncate text-[10px] text-[var(--ink-muted)]">
        {musica.artista || 'Música del evento'}
      </span>
    </span>
  </button>
</aside>

<style>
  .musica-boton,
  .musica-toast {
    background-color: color-mix(in srgb, var(--bg) 90%, transparent);
  }

  .musica-vol-panel,
  .musica-vol-disparador {
    background-color: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .musica-vol-disparador:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [data-volumen-grupo][hidden] {
    display: none;
  }

  .musica-vol-panel {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 6px, 0);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease),
      visibility 0s linear 0.25s;
  }

  .musica-vol-panel[data-abierto='true'] {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .musica-vol-slider {
    -webkit-appearance: none;
    appearance: none;
    writing-mode: vertical-lr;
    direction: rtl;
    width: 14px;
    height: 88px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    accent-color: var(--accent);
  }

  .musica-vol-slider::-webkit-slider-runnable-track {
    width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .musica-vol-slider::-moz-range-track {
    width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .musica-vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    margin-left: -6px;
    border-radius: 999px;
    border: 1px solid var(--surface);
    background: var(--accent);
  }
  .musica-vol-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 1px solid var(--surface);
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .musica-vol-panel {
      transition: none;
    }
  }

  .musica-boton:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .musica-boton[aria-pressed='true'] {
    border-color: var(--accent);
  }

  /* Etiqueta efímera en móvil: solo opacity + transform */
  .musica-toast {
    opacity: 0;
    visibility: hidden;
    transform: translate3d(6px, 0, 0);
    transition:
      opacity 0.28s var(--ease),
      transform 0.28s var(--ease),
      visibility 0s linear 0.28s;
  }

  .musica-toast[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* Halo: solo transform + opacity, activo únicamente mientras suena */
  .musica-halo {
    position: absolute;
    inset: -1px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .musica-boton[aria-pressed='true'] .musica-halo {
      animation: musica-pulso 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .musica-toast {
      transition: none;
    }
    .musica-boton[aria-pressed='true'] .musica-halo {
      opacity: 0.55;
      transform: scale(1.16);
    }
  }

  @keyframes musica-pulso {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }
</style>

<script>
  const widgets = document.querySelectorAll<HTMLElement>('[data-musica-widget]');

  widgets.forEach((widget) => {
    const boton = widget.querySelector<HTMLButtonElement>('[data-musica-boton]');
    const audio = widget.querySelector<HTMLAudioElement>('[data-musica-audio]');
    const iconoPlay = widget.querySelector<SVGElement>('[data-icono-play]');
    const iconoPause = widget.querySelector<SVGElement>('[data-icono-pause]');
    const estado = widget.querySelector<HTMLElement>('[data-musica-estado]');
    const toast = widget.querySelector<HTMLElement>('[data-musica-toast]');
    const toastEstado = widget.querySelector<HTMLElement>('[data-musica-toast-estado]');
    const titulo = widget.dataset.musicaTitulo || 'Música del evento';
    const esDemo = widget.dataset.modoDemo === 'true';

    if (!boton) return;

    let reproduciendo = false;
    let temporizadorToast: number | undefined;

    // Volumen: solo si el dispositivo permite modificar audio.volume (iOS lo bloquea)
    const grupoVol = widget.querySelector<HTMLElement>('[data-volumen-grupo]');
    const panelVol = widget.querySelector<HTMLElement>('[data-volumen-panel]');
    const sliderVol = widget.querySelector<HTMLInputElement>('[data-volumen-slider]');
    const disparadorVol = widget.querySelector<HTMLButtonElement>('[data-volumen-disparador]');
    const VOLUMEN_INICIAL = 0.45;
    const esIOS =
      /iP(hone|ad|od)/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const volumenEditable = (() => {
      if (!audio || esIOS) return false;
      try {
        const previo = audio.volume;
        audio.volume = 0.5;
        const ok = Math.abs(audio.volume - 0.5) < 0.01;
        audio.volume = previo;
        return ok;
      } catch {
        return false;
      }
    })();
    let volumenObjetivo = VOLUMEN_INICIAL;
    let rafFade = 0;
    let temporizadorVol: number | undefined;

    const cerrarVolumen = () => {
      window.clearTimeout(temporizadorVol);
      if (!panelVol || !disparadorVol) return;
      delete panelVol.dataset.abierto;
      panelVol.setAttribute('aria-hidden', 'true');
      disparadorVol.setAttribute('aria-expanded', 'false');
      sliderVol?.setAttribute('tabindex', '-1');
    };

    const programarCierreVolumen = () => {
      window.clearTimeout(temporizadorVol);
      temporizadorVol = window.setTimeout(cerrarVolumen, 3500);
    };

    const aplicarFadeIn = () => {
      if (!audio || !volumenEditable) return;
      cancelAnimationFrame(rafFade);
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reducido) {
        audio.volume = volumenObjetivo;
        return;
      }
      const duracion = 1400;
      const inicio = performance.now();
      audio.volume = 0;
      const paso = (ahora: number) => {
        const t = Math.min(1, (ahora - inicio) / duracion);
        audio.volume = Math.min(1, Math.max(0, volumenObjetivo * t));
        if (t < 1 && !audio.paused) rafFade = requestAnimationFrame(paso);
      };
      rafFade = requestAnimationFrame(paso);
    };

    const ocultarToastMovil = () => {
      window.clearTimeout(temporizadorToast);
      if (!toast) return;
      delete toast.dataset.visible;
    };

    if (volumenEditable && audio && grupoVol && panelVol && sliderVol && disparadorVol) {
      audio.volume = 0;
      disparadorVol.addEventListener('click', () => {
        const abierto = panelVol.dataset.abierto === 'true';
        if (abierto) {
          cerrarVolumen();
          return;
        }
        ocultarToastMovil();
        panelVol.dataset.abierto = 'true';
        panelVol.setAttribute('aria-hidden', 'false');
        disparadorVol.setAttribute('aria-expanded', 'true');
        sliderVol.removeAttribute('tabindex');
        programarCierreVolumen();
      });
      panelVol.addEventListener('pointerdown', programarCierreVolumen);
      sliderVol.addEventListener('input', () => {
        cancelAnimationFrame(rafFade);
        volumenObjetivo = Number(sliderVol.value) / 100;
        audio.volume = volumenObjetivo;
        programarCierreVolumen();
      });
      document.addEventListener('pointerdown', (e) => {
        if (!widget.contains(e.target as Node)) cerrarVolumen();
      });
    }

    const mostrarToastMovil = (textoEstado?: string) => {
      if (!toast) return;
      cerrarVolumen();
      if (toastEstado && textoEstado) {
        toastEstado.textContent = textoEstado;
      }
      toast.dataset.visible = 'true';
      window.clearTimeout(temporizadorToast);
      temporizadorToast = window.setTimeout(() => {
        delete toast.dataset.visible;
      }, 2600);
    };

    const actualizarUI = (activo: boolean, textoEstado?: string, anunciar = false) => {
      reproduciendo = activo;
      boton.setAttribute('aria-pressed', activo ? 'true' : 'false');
      boton.setAttribute(
        'aria-label',
        `${activo ? 'Pausar' : 'Reproducir'} música: ${titulo}`,
      );
      iconoPlay?.classList.toggle('hidden', activo);
      iconoPause?.classList.toggle('hidden', !activo);
      if (grupoVol) {
        grupoVol.hidden = !(activo && volumenEditable);
        if (!activo) cerrarVolumen();
      }
      if (estado && textoEstado) {
        estado.textContent = textoEstado;
      }
      if (anunciar) {
        mostrarToastMovil(textoEstado);
      }
    };

    const iniciarReproduccion = async () => {
      if (esDemo || !audio) {
        if (!reproduciendo) {
          actualizarUI(true, 'Demo sin archivo MP3', true);
        }
        return;
      }

      if (reproduciendo && !audio.paused) return;

      try {
        if (volumenEditable) audio.volume = 0;
        const promesa = audio.play();
        if (promesa) await promesa;
        aplicarFadeIn();
        actualizarUI(true, 'Reproduciendo', true);
      } catch {
        actualizarUI(false, 'Toca para reproducir', true);
      }
    };

    audio?.addEventListener('error', () => {
      actualizarUI(false, 'Audio no disponible', true);
    });

    audio?.addEventListener('pause', () => {
      if (reproduciendo) {
        actualizarUI(false, 'Música en pausa', false);
      }
    });

    audio?.addEventListener('play', () => {
      if (!reproduciendo) {
        actualizarUI(true, 'Reproduciendo', false);
      }
    });

    window.addEventListener('signato:iniciar-musica', () => {
      void iniciarReproduccion();
    });

    boton.addEventListener('click', async () => {
      if (esDemo || !audio) {
        const siguiente = !reproduciendo;
        actualizarUI(
          siguiente,
          siguiente ? 'Demo sin archivo MP3' : 'Pausado (modo demo)',
          true,
        );
        return;
      }

      if (reproduciendo) {
        audio.pause();
        actualizarUI(false, 'Música en pausa', true);
        return;
      }

      await iniciarReproduccion();
    });
  });
</script>
