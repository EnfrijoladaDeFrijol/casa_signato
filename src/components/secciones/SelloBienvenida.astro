---
interface Props {
  protagonistas: string;
  subtitulo?: string;
  tieneMusica?: boolean;
  fotoPortada?: string | { url?: string; alt?: string };
}

const { protagonistas, subtitulo, tieneMusica = false, fotoPortada } = Astro.props;

function obtenerIniciales(texto: string): string {
  const limpio = texto.trim();
  if (limpio.includes('&')) {
    const partes = limpio.split('&').map((p) => p.trim()).filter(Boolean);
    if (partes.length >= 2) return `${partes[0][0] ?? ''}&${partes[1][0] ?? ''}`.toUpperCase();
  }
  const palabras = limpio.split(/\s+/).filter(Boolean);
  return palabras.length >= 2
    ? `${palabras[0][0] ?? ''}${palabras[1][0] ?? ''}`.toUpperCase()
    : limpio.slice(0, 2).toUpperCase();
}

const iniciales = obtenerIniciales(protagonistas);
const urlPortada = typeof fotoPortada === 'string' ? fotoPortada : fotoPortada?.url;
const fotoValida = urlPortada && !/\.svg(\?|#|$)/i.test(urlPortada) ? urlPortada : undefined;
const altPortada = typeof fotoPortada === 'object' && fotoPortada?.alt ? fotoPortada.alt : `Portada de ${protagonistas}`;
---

<div
  id="sello-bienvenida"
  data-sello-bienvenida
  data-tiene-musica={tieneMusica ? 'true' : 'false'}
  role="dialog"
  aria-modal="true"
  aria-labelledby="sello-bienvenida-titulo"
  class="sello-bienvenida fixed inset-0 z-50 flex items-center justify-center"
>
  <div
    class="sello-marco relative h-[100svh] w-full sm:h-[min(92svh,780px)] sm:w-auto sm:max-w-[440px] sm:aspect-[9/16] sm:rounded-[1.25rem]"
  >
    <button
      type="button"
      data-sello-abrir
      aria-label={`Abrir invitación de ${protagonistas}`}
      class="sello-sobre-btn absolute inset-0 block h-full w-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]"
    >
      <!-- 1. Interior y forro editorial -->
      <span class="sello-interior sello-redondo" aria-hidden="true">
        <span class="sello-grano"></span>
        <span class="sello-forro-marco"></span>
        <svg class="sello-filigrana" viewBox="0 0 100 100" fill="none" preserveAspectRatio="xMidYMid meet">
          <circle cx="50" cy="50" r="44" stroke="var(--accent)" stroke-width="0.35" vector-effect="non-scaling-stroke" />
          <circle cx="50" cy="50" r="38" stroke="var(--accent)" stroke-width="0.35" vector-effect="non-scaling-stroke" />
          <path d="M50 6 L94 50 L50 94 L6 50 Z" stroke="var(--accent)" stroke-width="0.35" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="sello-forro-monograma font-display">{iniciales}</span>
      </span>

      <!-- 2. Carta interior -->
      <span class="sello-carta" aria-hidden="true">
        {
          fotoValida && (
            <span class="sello-carta-foto">
              <img src={fotoValida} alt={altPortada} decoding="async" class="h-full w-full object-cover" />
            </span>
          )
        }
        <span class="sello-carta-texto">
          {subtitulo && <span class="sello-carta-sub">{subtitulo}</span>}
          <span class="sello-carta-nombres">{protagonistas}</span>
        </span>
      </span>

      <!-- 3. Bolsillo frontal -->
      <span class="sello-bolsillo sello-redondo" aria-hidden="true">
        <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="sello-sombra-lat" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--ink)" stop-opacity="0.1" />
              <stop offset="100%" stop-color="var(--ink)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="sello-sombra-inf" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0%" stop-color="var(--ink)" stop-opacity="0" />
              <stop offset="100%" stop-color="var(--ink)" stop-opacity="0.12" />
            </linearGradient>
          </defs>
          <path d="M0 100 L50 54 L100 100 Z" class="sello-cara-inf" />
          <path d="M0 100 L50 54 L100 100 Z" fill="url(#sello-sombra-inf)" />
          <path d="M0 0 L50 54 L0 100 Z" class="sello-cara-izq" />
          <path d="M100 0 L50 54 L100 100 Z" class="sello-cara-der" />
          <path d="M0 0 L50 54 L0 100 Z" fill="url(#sello-sombra-lat)" />
          <path d="M0 100 L50 54 L100 100" fill="none" class="sello-luz-pliegue" stroke-width="1" vector-effect="non-scaling-stroke" />
          <path d="M0 0 L50 54 L0 100 M100 0 L50 54 L100 100" fill="none" stroke="var(--border-soft)" stroke-width="1" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="sello-grano"></span>
      </span>

      <!-- 4. Solapa superior -->
      <span class="sello-solapa-escena" aria-hidden="true">
        <span class="sello-solapa-sombra"></span>
        <span class="sello-solapa">
          <span class="sello-solapa-cara"></span>
          <span class="sello-solapa-texto">
            {subtitulo && <span class="sello-solapa-sub">{subtitulo}</span>}
            <span id="sello-bienvenida-titulo" class="sello-solapa-nombres">{protagonistas}</span>
          </span>
        </span>
      </span>

      <!-- 5. Sello de lacre -->
      <span class="sello-lacre" aria-hidden="true">
        <span class="sello-pulso"></span>
        <span class="sello-lacre-pieza">
          <svg class="h-full w-full overflow-visible" viewBox="0 0 100 100" fill="none">
            <defs>
              <radialGradient id="sello-cera-grad" cx="34%" cy="28%" r="72%">
                <stop offset="0%" stop-color="var(--cera-luz)" />
                <stop offset="46%" stop-color="var(--cera-base)" />
                <stop offset="84%" stop-color="var(--cera-profunda)" />
                <stop offset="100%" stop-color="var(--cera-sombra)" />
              </radialGradient>
              <linearGradient id="sello-cuno-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--cera-sombra)" stop-opacity="0.52" />
                <stop offset="52%" stop-color="var(--cera-base)" stop-opacity="0.12" />
                <stop offset="100%" stop-color="var(--cera-luz)" stop-opacity="0.45" />
              </linearGradient>
            </defs>
            <path d="M52 8 C66 7 79 13 87 24 C95 34 97 49 93 63 C89 77 78 88 65 93 C52 98 36 96 24 88 C12 80 6 66 7 51 C8 36 14 22 26 14 C35 8 43 8.5 52 8 Z" transform="translate(0 3.2)" fill="var(--cera-contacto)" />
            <path d="M52 7 C66 6 79 12 87 23 C95 34 97 49 93 63 C89 77 78 88 65 93 C52 98 36 96 24 88 C12 80 6 66 7 51 C8 36 14 22 26 14 C35 8 43 7.5 52 7 Z" fill="url(#sello-cera-grad)" />
            <circle cx="50" cy="50" r="37" stroke="var(--cera-luz)" stroke-opacity="0.34" stroke-width="1.2" />
            <circle cx="50" cy="50" r="32.5" fill="url(#sello-cuno-grad)" />
            <circle cx="50" cy="50" r="32.5" stroke="var(--cera-sombra)" stroke-opacity="0.52" stroke-width="1.4" />
            <circle cx="50" cy="50" r="29" stroke="var(--cera-luz)" stroke-opacity="0.44" stroke-width="0.9" />
          </svg>
          <span class="sello-iniciales font-display">{iniciales}</span>
        </span>
      </span>

      <span class="sello-indicacion" aria-hidden="true">Toca el sello</span>
    </button>

    {
      tieneMusica && (
        <button
          type="button"
          data-sello-silencio
          class="sello-silencio absolute bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 z-40 inline-flex min-h-[44px] -translate-x-1/2 cursor-pointer items-center justify-center whitespace-nowrap px-4 text-[10px] font-medium uppercase tracking-[0.22em] text-[var(--ink-muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
        >
          Entrar sin música
        </button>
      )
    }
  </div>
</div>

<style>
  :global(html:not(.js)) .sello-bienvenida {
    display: none;
  }

  .sello-bienvenida {
    --sello-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --sello-borde: color-mix(in srgb, var(--ink) 14%, var(--surface));
    overscroll-behavior: contain;
    overflow: hidden;
    background: var(--bg);
    opacity: 1;
  }

  @media (min-width: 640px) {
    .sello-bienvenida {
      background:
        radial-gradient(ellipse at 50% 28%, color-mix(in srgb, var(--accent) 18%, var(--bg)), transparent 70%),
        color-mix(in srgb, var(--ink) 16%, var(--bg));
    }

    .sello-marco {
      box-shadow:
        0 48px 90px -36px color-mix(in srgb, var(--ink) 52%, transparent),
        0 14px 30px -16px color-mix(in srgb, var(--ink) 32%, transparent);
    }
  }

  .sello-sobre-btn {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    border-radius: inherit;
    perspective: 1200px;
  }

  .sello-redondo {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
    overflow: hidden;
  }

  .sello-grano {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.07;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  /* 1. Interior + forro */
  .sello-interior {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink) 8%, transparent), transparent 40%),
      color-mix(in srgb, var(--accent) 22%, var(--bg));
  }

  .sello-forro-marco {
    position: absolute;
    inset: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 0.6rem;
  }

  .sello-filigrana {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.2;
  }

  .sello-forro-monograma {
    position: absolute;
    left: 50%;
    top: 78%;
    transform: translateX(-50%);
    font-size: 4.5rem;
    font-style: italic;
    line-height: 1;
    color: var(--accent);
    opacity: 0.1;
  }

  /* 2. Carta */
  .sello-carta {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 24%;
    height: 72%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 0.9rem 0.9rem 1.1rem;
    border: 1px solid var(--border-soft);
    border-radius: 3px;
    background: var(--surface);
    box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--ink) 38%, transparent);
    transform: translate3d(0, 0, 0) scale(1);
    will-change: transform;
  }

  .sello-carta-foto {
    display: block;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 2px;
    background: var(--accent-soft, color-mix(in srgb, var(--accent) 20%, var(--surface)));
  }

  .sello-carta-texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    padding-top: 0.2rem;
  }

  .sello-carta-sub,
  .sello-solapa-sub {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sello-carta-nombres,
  .sello-solapa-nombres {
    font-family: var(--font-script, var(--font-display, 'Cormorant Garamond', serif));
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--ink);
  }

  /* 3. Bolsillo */
  .sello-bolsillo {
    z-index: 15;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .sello-cara-izq {
    fill: color-mix(in srgb, var(--ink) 4%, var(--surface));
  }

  .sello-cara-der {
    fill: color-mix(in srgb, var(--ink) 8%, var(--surface));
  }

  .sello-cara-inf {
    fill: color-mix(in srgb, var(--bg) 40%, var(--surface));
  }

  .sello-luz-pliegue {
    stroke: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  /* 4. Solapa */
  .sello-solapa-escena {
    position: absolute;
    inset: 0;
    z-index: 20;
    perspective: 1200px;
    pointer-events: none;
  }

  .sello-solapa-sombra {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(54% + 14px);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--ink) 20%, transparent));
    opacity: 1;
  }

  .sello-solapa {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 54%;
    transform-origin: top center;
    transform: rotateX(0deg);
    will-change: transform;
  }

  .sello-solapa-cara {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    background:
      linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--ink) 6%, var(--bg)) 100%),
      var(--surface);
    box-shadow: inset 0 0 0 1px var(--border-soft);
  }

  .sello-solapa-cara::after {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(0.4% 0, 99.6% 0, 50% calc(100% - 2px));
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 60%, var(--bg)), color-mix(in srgb, var(--ink) 4%, var(--bg)));
  }

  .sello-solapa-texto {
    position: absolute;
    left: 15%;
    right: 15%;
    top: 12%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  /* 5. Lacre */
  .sello-lacre {
    --cera-luz: color-mix(in srgb, var(--surface) 32%, var(--accent));
    --cera-base: var(--accent);
    --cera-profunda: color-mix(in srgb, var(--ink) 26%, var(--accent));
    --cera-sombra: color-mix(in srgb, var(--ink) 44%, var(--accent));
    --cera-contacto: color-mix(in srgb, var(--ink) 26%, transparent);
    --cera-tinta: color-mix(in srgb, var(--bg) 92%, var(--surface));
    position: absolute;
    left: 50%;
    top: 54%;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate3d(-50%, -50%, 0) scale(1);
    will-change: transform, opacity;
  }

  .sello-sobre-btn:active .sello-lacre {
    transform: translate3d(-50%, -50%, 0) scale(0.95);
  }

  .sello-lacre-pieza {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
  }

  .sello-iniciales {
    position: absolute;
    font-size: 1.4rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--cera-tinta);
    text-shadow:
      0 -1px 0 color-mix(in srgb, var(--ink) 40%, transparent),
      0 1px 0 color-mix(in srgb, var(--surface) 24%, transparent);
  }

  .sello-pulso {
    position: absolute;
    inset: 2px;
    border-radius: 9999px;
    border: 1px solid var(--accent);
    opacity: 0;
    pointer-events: none;
  }

  .sello-indicacion {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(54% + 3.9rem);
    z-index: 25;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-muted);
  }

  @keyframes sello-pulso-suave {
    0% { opacity: 0.42; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.36); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sello-pulso {
      animation: sello-pulso-suave 2.8s var(--sello-ease) infinite;
      will-change: transform, opacity;
    }
  }

  /* Coreografía "sacar la carta" (~1.28s, solo transform y opacity) */
  @keyframes sello-lacre-sale {
    0% { transform: translate3d(-50%, -50%, 0) scale(1); opacity: 1; }
    35% { transform: translate3d(-50%, -50%, 0) scale(0.94); opacity: 1; }
    100% { transform: translate3d(-50%, -50%, 0) scale(1.1); opacity: 0; }
  }

  @keyframes sello-desvanece {
    to { opacity: 0; }
  }

  @keyframes sello-solapa-abre {
    from { transform: rotateX(0deg); }
    to { transform: rotateX(-175deg); }
  }

  @keyframes sello-escena-z {
    0%, 49% { z-index: 20; }
    50%, 100% { z-index: 5; }
  }

  @keyframes sello-carta-sale {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(0, -24%, 0) scale(1.04); }
  }

  @keyframes sello-bolsillo-baja {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, 38%, 0); }
  }

  .sello-bienvenida[data-estado='abriendo'] {
    pointer-events: none;
    animation: sello-desvanece 330ms var(--sello-ease) 950ms forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-lacre {
    animation: sello-lacre-sale 240ms var(--sello-ease) forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-pulso {
    animation: none;
    opacity: 0;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-indicacion,
  .sello-bienvenida[data-estado='abriendo'] .sello-silencio,
  .sello-bienvenida[data-estado='abriendo'] .sello-solapa-texto,
  .sello-bienvenida[data-estado='abriendo'] .sello-solapa-sombra {
    animation: sello-desvanece 200ms var(--sello-ease) forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-solapa-escena {
    animation: sello-escena-z 640ms linear 160ms forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-solapa {
    animation: sello-solapa-abre 480ms var(--sello-ease) 160ms forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-carta {
    animation: sello-carta-sale 590ms cubic-bezier(0.22, 0.8, 0.24, 1) 460ms forwards;
  }

  .sello-bienvenida[data-estado='abriendo'] .sello-bolsillo {
    animation: sello-bolsillo-baja 590ms var(--sello-ease) 460ms forwards;
  }

  /* Salida rápida: sin música, Escape o movimiento reducido */
  .sello-bienvenida[data-estado='cerrando'] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.26s var(--sello-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .sello-bienvenida[data-estado] ,
    .sello-bienvenida[data-estado] * {
      animation: none !important;
    }

    .sello-bienvenida[data-estado='cerrando'],
    .sello-bienvenida[data-estado='abriendo'] {
      opacity: 0;
      transition: opacity 0.16s linear !important;
    }

    .sello-pulso {
      animation: none !important;
    }
  }
</style>

<script>
  const sello = document.querySelector<HTMLElement>('[data-sello-bienvenida]');

  if (sello) {
    const btnAbrir = sello.querySelector<HTMLButtonElement>('[data-sello-abrir]');
    const btnSilencio = sello.querySelector<HTMLButtonElement>('[data-sello-silencio]');
    const tieneMusica = sello.dataset.tieneMusica === 'true';
    const consultaMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    let cerrado = false;

    const liberarScroll = () => {
      document.body.dataset.selloAbierto = 'false';
      document.body.style.removeProperty('overflow');
      document.documentElement.style.removeProperty('overflow');
    };

    const retirarDelFlujo = () => {
      sello.classList.add('pointer-events-none');
      sello.setAttribute('aria-hidden', 'true');
      sello.hidden = true;
      sello.style.display = 'none';
      liberarScroll();
    };

    if (consultaMovimiento.matches) {
      liberarScroll();
    } else {
      document.body.dataset.selloAbierto = 'true';
    }

    const cerrar = (animarSobre: boolean, iniciarMusica: boolean) => {
      if (cerrado) return;
      cerrado = true;

      // Sincrónico dentro del gesto del usuario (autoplay iOS/Android)
      if (iniciarMusica && tieneMusica) {
        window.dispatchEvent(new CustomEvent('signato:iniciar-musica'));
      }

      sello.classList.add('pointer-events-none');
      sello.setAttribute('aria-hidden', 'true');

      const conMovimiento = animarSobre && !consultaMovimiento.matches;
      sello.dataset.estado = conMovimiento ? 'abriendo' : 'cerrando';

      // Pase lo que pase, el scroll queda liberado y el sobre se retira
      window.setTimeout(retirarDelFlujo, conMovimiento ? 1300 : 300);
      window.setTimeout(liberarScroll, conMovimiento ? 950 : 0);
    };

    btnAbrir?.addEventListener('click', () => cerrar(true, tieneMusica));
    btnSilencio?.addEventListener('click', () => cerrar(false, false));
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !cerrado) cerrar(false, false);
    });
  }
</script>
