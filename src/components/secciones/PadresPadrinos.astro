---
import type { PadresPadrinosData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';
import InvitacionIcono from './InvitacionIcono.astro';

interface Props {
  datos: PadresPadrinosData;
}

const { datos } = Astro.props;
const dosGrupos = datos.grupos.length === 2;
---

<section aria-labelledby="titulo-padres" class="inv-papel">
  <div class="mx-auto max-w-2xl">
    <InvitacionIcono nombre="anillos" class="inv-icon-draw mx-auto mb-5 h-9 w-9 text-[var(--accent)]" />
    <SeccionTitulo id="titulo-padres" eyebrow="Con la bendición de" titulo="Padres y Padrinos" />

    {
      datos.nota && (
        <p class="inv-lede mx-auto mt-5 max-w-sm text-center" data-reveal style="--rv: 1">
          {datos.nota}
        </p>
      )
    }

    <div
      class:list={[
        'mt-12 grid divide-y divide-[var(--border-soft)]',
        dosGrupos && 'sm:grid-cols-2 sm:divide-x sm:divide-y-0',
      ]}
    >
      {
        datos.grupos.map((grupo, i) => (
          <div class="px-4 py-8 text-center first:pt-2 last:pb-2 sm:py-4" data-reveal style={`--rv: ${i + 2}`}>
            <h3 class="inv-eyebrow">{grupo.titulo}</h3>
            <ul class="mt-4 space-y-2">
              {grupo.nombres.map((nombre) => (
                <li class="font-display text-[1.6rem] font-medium italic leading-tight text-[var(--ink)]">
                  {nombre}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
