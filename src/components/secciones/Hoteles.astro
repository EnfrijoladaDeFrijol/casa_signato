---
import type { HotelItem } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  hoteles: HotelItem[];
}

const { hoteles } = Astro.props;
const varios = hoteles.length > 1;
---

<section aria-labelledby="titulo-hoteles">
  <div class="mx-auto max-w-3xl">
    <SeccionTitulo id="titulo-hoteles" eyebrow="Invitados foráneos" titulo="Hospedaje Sugerido" />

    <div
      class:list={[
        'mx-auto mt-14 grid max-w-md divide-y divide-[var(--border-soft)] border-y border-[var(--border-soft)]',
        varios && 'md:max-w-none md:grid-cols-2 md:divide-x md:divide-y-0',
      ]}
    >
      {
        hoteles.map((hotel, i) => (
          <article class="px-2 py-10 text-center md:px-8" data-reveal style={`--rv: ${i}`}>
            <h3 class="font-display text-[1.7rem] font-medium italic leading-tight text-[var(--ink)]">
              {hotel.nombre}
            </h3>
            <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-[var(--ink-muted)]">
              {hotel.direccion}
            </p>

            <dl class="mx-auto mt-6 grid max-w-xs grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 text-left text-sm">
              {hotel.distancia && (
                <>
                  <dt class="inv-label self-center">Distancia</dt>
                  <dd class="text-right text-[var(--ink)]">{hotel.distancia}</dd>
                </>
              )}
              {hotel.tarifaReferencia && (
                <>
                  <dt class="inv-label self-center">Tarifa ref.</dt>
                  <dd class="text-right text-[var(--ink)] [font-variant-numeric:tabular-nums]">
                    {hotel.tarifaReferencia}
                  </dd>
                </>
              )}
              {hotel.codigoDescuento && (
                <>
                  <dt class="inv-label self-center">Código</dt>
                  <dd class="text-right font-semibold tracking-[0.12em] text-[var(--accent)]">
                    {hotel.codigoDescuento}
                  </dd>
                </>
              )}
            </dl>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center">
              <a
                href={hotel.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-abrir-mapa
                class="inv-btn inv-btn--line active:scale-[0.98]"
              >
                <span class="inv-swap">
                  <span data-swap-a>Ver mapa</span>
                  <span data-swap-b>Abriendo mapa…</span>
                </span>
              </a>
              {hotel.webUrl && (
                <a
                  href={hotel.webUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inv-btn inv-btn--solid active:scale-[0.98]"
                >
                  Reservar
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
