---
import type { AlbumQrData } from '../../types/invitacion';
import SeccionTitulo from './SeccionTitulo.astro';

interface Props {
  album: AlbumQrData;
}

const { album } = Astro.props;
---

<section aria-labelledby="titulo-album">
  <div class="mx-auto max-w-xl text-center">
    <SeccionTitulo
      id="titulo-album"
      eyebrow="Comparte tus fotos"
      titulo={album.titulo || 'Álbum Compartido'}
      lede={album.descripcion}
    />

    <div class="relative mx-auto mt-12 w-44" data-reveal style="--rv: 1">
      <div class="flex h-56 w-full items-end justify-center rounded-t-full border border-[var(--accent)] bg-[var(--bg)] pb-9">
        <div class="h-24 w-24">
          {
            album.qrImagenUrl ? (
              <img
                src={album.qrImagenUrl}
                alt="Código QR del álbum compartido"
                loading="lazy"
                class="h-full w-full object-contain"
              />
            ) : (
              <svg class="h-full w-full text-[var(--ink)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="8" y="8" width="18" height="18" rx="1.5" />
                <rect x="38" y="8" width="18" height="18" rx="1.5" />
                <rect x="8" y="38" width="18" height="18" rx="1.5" />
                <path d="M14 14h6v6h-6zM44 14h6v6h-6zM14 44h6v6h-6z" fill="currentColor" stroke="none" />
                <path d="M38 38h8v8h-8zM50 38h6v6h-6zM38 50h6v6h-6zM48 48h8v8h-8z" />
              </svg>
            )
          }
        </div>
      </div>
    </div>

    {
      album.hashtag && (
        <p class="mt-8 font-display text-[1.75rem] font-medium italic text-[var(--accent)]" data-reveal style="--rv: 2">
          {album.hashtag}
        </p>
      )
    }

    <div class="mx-auto mt-8 flex max-w-xs flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center" data-reveal style="--rv: 3">
      <a
        href={album.url}
        target="_blank"
        rel="noopener noreferrer"
        data-abrir-mapa
        class="inv-btn inv-btn--solid active:scale-[0.98]"
      >
        <span class="inv-swap">
          <span data-swap-a>Subir fotos al álbum</span>
          <span data-swap-b>Abriendo álbum…</span>
        </span>
      </a>
      <button
        type="button"
        data-copiar-texto={album.url}
        class="inv-btn inv-btn--line active:scale-[0.98]"
      >
        <span class="inv-swap">
          <span data-swap-a>Copiar enlace</span>
          <span data-swap-b>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
            Enlace copiado
          </span>
        </span>
      </button>
    </div>
  </div>
</section>
