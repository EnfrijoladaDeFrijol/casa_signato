---
import type { ClienteInvitacion } from '../types/invitacion';
import { resolverModulos, obtenerLimiteGaleria } from '../utils/planes';
import HeroClasico from './temas/clasico/Hero.astro';
import HeroBase from './temas/base/Hero.astro';
import HeroXvEditorial from './temas/xv-editorial/Hero.astro';
import PadresPadrinos from './secciones/PadresPadrinos.astro';
import Contador from './secciones/Contador.astro';
import Ubicaciones from './secciones/Ubicaciones.astro';
import MusicaPlayer from './secciones/MusicaPlayer.astro';
import SelloBienvenida from './secciones/SelloBienvenida.astro';
import Galeria from './secciones/Galeria.astro';
import Itinerario from './secciones/Itinerario.astro';
import DressCode from './secciones/DressCode.astro';
import MesaRegalos from './secciones/MesaRegalos.astro';
import PaseBoletos from './secciones/PaseBoletos.astro';
import RSVP from './secciones/RSVP.astro';
import AgendarCalendario from './secciones/AgendarCalendario.astro';
import Hoteles from './secciones/Hoteles.astro';
import AlbumQR from './secciones/AlbumQR.astro';
import Ornamento from './secciones/Ornamento.astro';
import DemoThemeSwitcher from './secciones/DemoThemeSwitcher.astro';
import DemoTopBar from './secciones/DemoTopBar.astro';
import InterludioFoto from './secciones/InterludioFoto.astro';
import BordeRasgado from './secciones/BordeRasgado.astro';

interface Props {
  cliente: ClienteInvitacion;
}

const { cliente } = Astro.props;
const modulos = resolverModulos(cliente);
const mostrarRsvp = modulos.rsvpWhatsapp || modulos.rsvpGoogleForm;
const tieneMusica = Boolean(modulos.musica && cliente.musica);
const mostrarSobre = cliente.sobreBienvenida !== false;

// Fotografías reales (no SVG) distribuidas sin repetir entre galería, interludios y cierre
const galeriaActiva = Boolean(modulos.galeria && cliente.galeria);
const fotosReales = galeriaActiva
  ? (cliente.galeria ?? [])
      .filter((foto) => foto.url && !/\.svg(\?|#|$)/i.test(foto.url))
      .slice(0, obtenerLimiteGaleria(cliente.plan))
  : [];
const hayFotos = fotosReales.length > 0;
const dispersas = cliente.modoFotos === 'dispersas' && hayFotos;
const fotoInterludio = dispersas
  ? fotosReales[0]
  : fotosReales.length >= 2
    ? fotosReales[0]
    : undefined;
const fotoCierre = dispersas ? undefined : hayFotos ? fotosReales[fotosReales.length - 1] : undefined;
// Modo dispersas: banda (1), impresa (2) y cierre (3 o la última disponible)
const fotoBanda = dispersas ? fotosReales[1] : undefined;
const fotoImpresa = dispersas ? fotosReales[2] : undefined;
const fotoCierreDispersa = dispersas && fotosReales.length >= 4 ? fotosReales[3] : undefined;

const fotosGaleria = hayFotos
  ? fotosReales.length >= 4
    ? fotosReales.slice(1, -1)
    : fotosReales.length === 3
      ? fotosReales.slice(1)
      : fotosReales
  : (cliente.galeria ?? []);
---

<main class="inv-flow">
  {cliente.esDemo === true && <DemoTopBar tema={cliente.tema} />}
  {
    mostrarSobre && (
      <SelloBienvenida
        protagonistas={cliente.protagonistas}
        subtitulo={cliente.subtitulo}
        tieneMusica={tieneMusica}  fotoPortada={cliente.fotoPortada}/>
    )
  }
  {
    cliente.tema === 'clasico' ? (
      <HeroClasico cliente={cliente} />
    ) : cliente.tema === 'xv-editorial' ? (
      <HeroXvEditorial cliente={cliente} />
    ) : (
      <HeroBase cliente={cliente} />
    )
  }

  {
    fotoInterludio && (
      <InterludioFoto
        variante="arco"
        foto={fotoInterludio}
        compactoSuperior={cliente.tema === 'clasico'}
      />
    )
  }

  {
    modulos.padresPadrinos && cliente.padresPadrinos && (
      <PadresPadrinos
        datos={cliente.padresPadrinos}
        protagonistas={cliente.protagonistas}
        fechaISO={cliente.fechaISO}
        categoria={cliente.categoria}
      />
    )
  }

  {
    modulos.contador && (
      <Contador fechaISO={cliente.fechaISO} horaInicio={cliente.horaInicio} />
    )
  }

  {
    modulos.ubicaciones && cliente.ubicaciones && (
      <Ubicaciones ubicaciones={cliente.ubicaciones} />
    )
  }

  {fotoBanda && <InterludioFoto variante="banda" foto={fotoBanda} />}

  {
    modulos.itinerario && cliente.itinerario && (
      <Itinerario itinerario={cliente.itinerario} />
    )
  }

  {
    modulos.galeria && cliente.galeria && !dispersas && (
      <Galeria fotos={fotosGaleria} plan={cliente.plan} />
    )
  }

  {
    modulos.dressCode && cliente.dressCode && (
      <DressCode dressCode={cliente.dressCode} />
    )
  }

  {fotoImpresa && <InterludioFoto variante="impresa" foto={fotoImpresa} />}

  {
    modulos.mesaRegalos && cliente.mesaRegalos && (
      <MesaRegalos mesaRegalos={cliente.mesaRegalos} />
    )
  }

  {
    modulos.paseBoletos && cliente.paseBoletos && (
      <PaseBoletos
        pase={cliente.paseBoletos}
        protagonistas={cliente.protagonistas}
      />
    )
  }

  {
    mostrarRsvp && (
      <RSVP
        mostrarWhatsapp={modulos.rsvpWhatsapp}
        mostrarGoogleForm={modulos.rsvpGoogleForm}
        rsvpWhatsapp={cliente.rsvpWhatsapp}
        rsvpGoogleForm={cliente.rsvpGoogleForm}
      />
    )
  }

  {
    modulos.calendario && cliente.calendario && (
      <AgendarCalendario
        calendario={cliente.calendario}
        fechaISO={cliente.fechaISO}
        horaInicio={cliente.horaInicio}
        slug={cliente.slug}
      />
    )
  }

  {
    modulos.hoteles && cliente.hoteles && (
      <Hoteles hoteles={cliente.hoteles} />
    )
  }

  {
    modulos.albumQr && cliente.albumQr && (
      <AlbumQR album={cliente.albumQr} />
    )
  }

  {fotoCierreDispersa && <InterludioFoto variante="cierre" foto={fotoCierreDispersa} />}

  {
    fotoCierre && (
      <div class="inv-cierre bg-[var(--bg)]">
        <div class="inv-papel border-t border-[var(--border-soft)] px-6 pb-10 pt-12 text-center">
          <div class="inv-divisor-clasico mb-5" aria-hidden="true">
            <span class="inv-rombo"></span>
          </div>
          <p
            class="text-[0.6875rem] font-semibold uppercase tracking-[0.3em] text-[var(--ink-muted)]"
            data-reveal
          >
            Te esperamos para celebrar juntos
          </p>
        </div>
        <div class="relative aspect-[16/11] max-h-[560px] w-full overflow-hidden bg-[var(--accent-soft)] sm:aspect-[16/9]">
          <BordeRasgado posicion="superior" sombra="foto" class="h-7 sm:h-9" />
          <img
            src={fotoCierre.url}
            alt={fotoCierre.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    )
  }

  <footer class="inv-pie text-center">
    <Ornamento />
    <p class="mt-6 text-[11px] uppercase tracking-[0.24em] text-[var(--ink-muted)]">
      Invitación digital diseñada por
    </p>
    <a
      href="/"
      class="mt-2 inline-flex min-h-11 items-center font-display text-xl font-semibold italic text-[var(--ink)] underline decoration-[var(--accent)] decoration-1 underline-offset-[6px]"
    >
      Casa Signato
    </a>
  </footer>

  {
    modulos.musica && cliente.musica && (
      <MusicaPlayer musica={cliente.musica} />
    )
  }

  {cliente.esDemo === true && <DemoThemeSwitcher temaOriginal={cliente.temaColores} />}
</main>
