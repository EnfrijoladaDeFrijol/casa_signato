---
import type { ClienteInvitacion } from '../../../types/invitacion';
import { formatearFechaCorta, formatearHora } from '../../../utils/fechas';
import { obtenerEtiquetaCategoria } from '../../../utils/categorias';
import BordeRasgado from '../../secciones/BordeRasgado.astro';

interface Props {
  cliente: ClienteInvitacion;
}

const { cliente } = Astro.props;

const etiquetaPortada = cliente.subtitulo || obtenerEtiquetaCategoria(cliente.categoria, true);
const etiquetaCategoria = obtenerEtiquetaCategoria(cliente.categoria, true);
const fechaCorta = formatearFechaCorta(cliente.fechaISO);
const horaTexto = formatearHora(cliente.horaInicio);
const posicionFoto = cliente.fotoPosicion ? `object-position: ${cliente.fotoPosicion}` : undefined;

function extraerIniciales(texto: string): [string, string?] {
  const limpio = texto.trim();
  const pareja = /^(.+?)\s*(?:&|\by\b)\s*(.+)$/i.exec(limpio);
  if (pareja) {
    const a = pareja[1].trim().charAt(0).toUpperCase();
    const b = pareja[2].trim().charAt(0).toUpperCase();
    return b ? [a, b] : [a];
  }
  const palabras = limpio.split(/\s+/).filter(Boolean);
  if (palabras.length >= 2) {
    return [palabras[0].charAt(0).toUpperCase(), palabras[1].charAt(0).toUpperCase()];
  }
  return [limpio.charAt(0).toUpperCase()];
}

const [inicialIzq, inicialDer] = extraerIniciales(cliente.protagonistas);
const subtituloMonograma =
  cliente.categoria === 'bodas' ? 'Nuestra boda' : etiquetaCategoria;
---

<header class="hero-clasico">
  <div class="relative flex min-h-[100svh] w-full flex-col justify-between overflow-hidden lg:h-[100svh] lg:max-h-[960px]">
    <div class="absolute inset-x-0 -top-[5%] h-[110%]" data-parallax data-parallax-speed="0.1" data-parallax-max="44">
      <img
        src={cliente.fotoPortada}
        alt={cliente.fotoPortadaAlt || cliente.titulo}
        style={posicionFoto}
        class="hero-foto hero-clasico__img absolute inset-0 h-full w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="hero-clasico__velo-sup pointer-events-none absolute inset-x-0 top-0 h-[30%]" aria-hidden="true"></div>
    <div class="hero-clasico__velo-inf pointer-events-none absolute inset-x-0 bottom-0 h-[48%]" aria-hidden="true"></div>

    <BordeRasgado posicion="inferior" sombra="foto" class="h-7 sm:h-9" />

    <div class="relative z-10 px-6 text-center" style="padding-top: calc(2.5rem + var(--demo-bar-h, 0px))">
      <p class="inv-enter hero-clasico__sutil text-[10px] font-semibold uppercase tracking-[0.34em] sm:text-[11px]" style="--i: 0">
        {etiquetaPortada}
      </p>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-2xl px-6 pb-16 text-center sm:pb-14">
      <h1 class="inv-enter hero-clasico__titulo font-display text-[clamp(2.85rem,11vw,4.25rem)] font-medium italic leading-[0.98] tracking-[-0.01em]" style="--i: 1">
        {cliente.protagonistas}
      </h1>
      <span class="inv-enter hero-clasico__linea mx-auto mt-4 block h-px w-12" style="--i: 2" aria-hidden="true"></span>
      <p class="inv-enter hero-clasico__meta mt-3.5 text-[11px] font-medium uppercase tracking-[0.22em] sm:text-xs" style="--i: 3">
        {fechaCorta} · {horaTexto}
      </p>
      <p class="inv-enter hero-clasico__sutil mt-1.5 text-[10px] font-medium uppercase tracking-[0.26em]" style="--i: 4">
        {cliente.ciudad}
      </p>
      <div class="inv-enter mt-5 flex justify-center" style="--i: 5" aria-hidden="true">
        <svg class="hero-clasico__deslizar h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.5 9.5L12 15l5.5-5.5" />
        </svg>
      </div>
    </div>
  </div>

  <div class="inv-papel bg-[var(--bg)] px-6 py-8 text-center sm:px-10 sm:py-10">
    {
      cliente.frase && (
        <div class="mx-auto max-w-lg">
          <blockquote class="inv-quote" data-reveal>
            “{cliente.frase}”
          </blockquote>
          <div class="inv-divisor-clasico mt-4" data-reveal style="--rv: 1" aria-hidden="true">
            <span class="inv-rombo"></span>
          </div>
        </div>
      )
    }

    <div class:list={['flex flex-col items-center', cliente.frase ? 'mt-6' : 'mt-1']} data-reveal style="--rv: 2">
      <div
        class="flex items-center justify-center gap-5 sm:gap-7"
        aria-label={`Monograma editorial de ${cliente.protagonistas}`}
      >
        <span class="hero-clasico__monograma-letra font-display text-[clamp(3.6rem,15vw,5rem)] font-normal leading-none tracking-[0.06em] text-[var(--ink)]">
          {inicialIzq}
        </span>
        {
          inicialDer && (
            <>
              <span class="hero-clasico__monograma-linea h-14 w-px shrink-0" aria-hidden="true"></span>
              <span class="hero-clasico__monograma-letra font-display text-[clamp(3.6rem,15vw,5rem)] font-normal leading-none tracking-[0.06em] text-[var(--ink)]">
                {inicialDer}
              </span>
            </>
          )
        }
      </div>
      <p class="mt-3 text-[0.6875rem] font-semibold uppercase tracking-[0.38em] text-[var(--ink-muted)]">
        {subtituloMonograma}
      </p>
    </div>
  </div>
</header>

<style>
  .hero-clasico__img {
    object-position: center 22%;
  }
  .hero-clasico__velo-sup {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 56%, transparent) 0%,
      color-mix(in srgb, var(--ink) 22%, transparent) 55%,
      transparent 100%
    );
  }
  .hero-clasico__velo-inf {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--ink) 68%, transparent) 0%,
      color-mix(in srgb, var(--ink) 58%, transparent) 34%,
      color-mix(in srgb, var(--ink) 32%, transparent) 68%,
      color-mix(in srgb, var(--ink) 10%, transparent) 88%,
      transparent 100%
    );
  }
  .hero-clasico__titulo {
    color: var(--bg);
    text-shadow:
      0 2px 18px color-mix(in srgb, var(--ink) 65%, transparent),
      0 1px 6px color-mix(in srgb, var(--ink) 44%, transparent);
    text-wrap: balance;
  }
  .hero-clasico__meta {
    color: color-mix(in srgb, var(--bg) 94%, var(--surface));
    text-shadow: 0 2px 18px color-mix(in srgb, var(--ink) 65%, transparent);
  }
  .hero-clasico__sutil {
    color: color-mix(in srgb, var(--bg) 86%, transparent);
    text-shadow: 0 1px 12px color-mix(in srgb, var(--ink) 48%, transparent);
  }
  .hero-clasico__monograma-letra {
    font-family: 'Cormorant Garamond', var(--font-display), Georgia, serif;
  }
  .hero-clasico__monograma-linea {
    background-color: color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .hero-clasico__linea {
    background-color: color-mix(in srgb, var(--bg) 52%, transparent);
  }
  .hero-clasico__deslizar {
    color: color-mix(in srgb, var(--bg) 76%, transparent);
  }
  @keyframes hero-deslizar {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, 5px, 0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-clasico__img { animation: inv-foto 1.6s var(--ease) both; }
    .hero-clasico__deslizar { animation: hero-deslizar 2.6s var(--ease) infinite; }
  }
</style>
