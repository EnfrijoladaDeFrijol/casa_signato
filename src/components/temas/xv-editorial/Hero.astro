---
import type { ClienteInvitacion } from '../../../types/invitacion';
import { formatearHora, formatearPartesFecha } from '../../../utils/fechas';
import Ornamento from '../../secciones/Ornamento.astro';

interface Props {
  cliente: ClienteInvitacion;
}

const { cliente } = Astro.props;
const fecha = formatearPartesFecha(cliente.fechaISO);
const horaTexto = formatearHora(cliente.horaInicio);

const [nombre, ...resto] = cliente.protagonistas.trim().split(/\s+/);
const apellido = resto.join(' ');
const paso = (n: number) => `--i: ${n}`;
---

<header class="hero-xv relative flex min-h-svh flex-col px-6 pb-16 pt-6 sm:px-10">
  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col">
    <div
      class="inv-enter flex items-center justify-between gap-4 border-b border-[var(--border-soft)] pb-4 text-[10px] font-medium uppercase tracking-[0.3em] text-[var(--ink-muted)]"
      style={paso(0)}
    >
      <span>{cliente.subtitulo || 'Mis XV Años'}</span>
      <span class="text-right">{cliente.ciudad}</span>
    </div>

    <div class="grid flex-1 items-center gap-10 py-9 md:grid-cols-12 md:gap-14 md:py-16">
      <figure
        class="inv-enter hero-arco relative mx-auto w-[min(66vw,18rem)] md:order-2 md:col-span-6 md:w-[min(32vw,25rem)]"
        style={paso(1)}
      >
        <div class="overflow-hidden rounded-t-full">
          <img
            src={cliente.fotoPortada}
            alt={cliente.fotoPortadaAlt || cliente.titulo}
            class="hero-foto aspect-[3/4] w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <span
          class="absolute left-1/2 top-[-0.7rem] -translate-x-1/2 -translate-y-1/2 bg-[var(--bg)] px-1.5 text-[var(--accent)]"
          aria-hidden="true"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
            <path d="M8 1.5L11 8L8 14.5L5 8L8 1.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"></path>
          </svg>
        </span>
      </figure>

      <div class="text-center md:order-1 md:col-span-6 md:text-left">
        <p class="inv-enter inv-eyebrow" style={paso(2)}>Te invito a celebrar</p>

        <h1 class="inv-enter mt-5" style={paso(3)}>
          <span
            class="block font-display text-[clamp(4.5rem,23vw,7.75rem)] font-medium italic leading-[0.88] tracking-[-0.01em] text-[var(--ink)]"
          >
            {nombre}
          </span>
          {' '}
          {
            apellido && (
              <span class="mt-4 block pl-[0.42em] font-display text-[clamp(1.05rem,5vw,1.5rem)] font-semibold uppercase tracking-[0.42em] text-[var(--ink)] md:pl-0">
                {apellido}
              </span>
            )
          }
        </h1>

        <div
          class="inv-enter mx-auto mt-8 grid max-w-sm grid-cols-[1fr_auto_1fr] items-center border-y border-[var(--border-soft)] py-5 md:mx-0"
          style={paso(4)}
        >
          <span class="text-[10px] font-semibold uppercase tracking-[0.26em] text-[var(--ink-muted)]">
            {fecha.diaSemana}
          </span>
          <span class="inv-num mx-5 border-x border-[var(--border-soft)] px-5 text-[3.25rem] leading-none text-[var(--accent)]">
            {fecha.dia}
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.26em] text-[var(--ink-muted)]">
            <span class="block">{fecha.mes}</span>
            <span class="inv-num mt-1 block text-sm tracking-[0.18em]">{fecha.anio}</span>
          </span>
        </div>

        <p class="inv-enter inv-num mt-5 text-2xl italic" style={paso(5)}>
          {horaTexto}
        </p>

        {
          cliente.frase && (
            <blockquote class="inv-enter inv-quote mx-auto mt-8 max-w-md md:mx-0" style={paso(6)}>
              “{cliente.frase}”
            </blockquote>
          )
        }

        <Ornamento class="inv-enter mt-10 md:justify-start" />
      </div>
    </div>
  </div>
</header>

<style>
  /* Marco de arco desplazado: una línea fina, sin sombras */
  .hero-arco::before {
    content: '';
    position: absolute;
    inset: -0.7rem;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--bg));
    border-radius: 999px 999px 0 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-foto {
      animation: inv-foto 1.8s var(--ease) both;
      animation-delay: 0.12s;
    }
  }
</style>
