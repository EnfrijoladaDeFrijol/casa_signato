---
// ============================================================
// UI Común — Contador (Cuenta Regresiva)
// Componente reutilizable para cualquier plantilla.
// Recibe la fecha y hora del evento, y renderiza un countdown
// con cajas estilizadas + script de actualización en tiempo real.
// ============================================================
import type { Colores } from '../../types/invitacion';

interface Props {
  /** Fecha del evento en formato ISO 8601 (ej. "2026-03-15") */
  fecha: string;
  /** Hora del evento (ej. "17:00") */
  hora: string;
  /** Paleta de colores para estilizar el contador */
  colores: Colores;
  /** Título de la sección (por defecto: "Cuenta Regresiva") */
  titulo?: string;
}

const { fecha, hora, colores, titulo = 'Cuenta Regresiva' } = Astro.props;
---

<section class="px-6 py-20 text-center" style={`background-color: ${colores.fondo};`}>
  <h2
    class="mb-12 font-serif text-3xl font-semibold md:text-4xl"
    style={`color: ${colores.primario};`}
  >
    {titulo}
  </h2>

  <div
    id="countdown"
    class="mx-auto flex max-w-lg justify-center gap-4 md:gap-8"
    data-fecha={fecha}
    data-hora={hora}
  >
    {['Días', 'Horas', 'Min', 'Seg'].map((label) => (
      <div class="flex flex-col items-center">
        <div
          class="flex h-20 w-20 items-center justify-center rounded-2xl text-3xl font-bold text-white shadow-lg md:h-24 md:w-24 md:text-4xl"
          style={`background: linear-gradient(135deg, ${colores.primario}, ${colores.acento});`}
        >
          <span class="countdown-value">--</span>
        </div>
        <span class="mt-2 text-xs font-medium uppercase tracking-wider" style={`color: ${colores.secundario};`}>
          {label}
        </span>
      </div>
    ))}
  </div>
</section>

<script>
  function initCountdown(): void {
    const container = document.getElementById('countdown');
    if (!container) return;

    const fecha = container.dataset.fecha;
    const hora = container.dataset.hora ?? '00:00';
    if (!fecha) return;

    const target = new Date(`${fecha}T${hora}:00`).getTime();
    const values = container.querySelectorAll('.countdown-value');

    function update(): void {
      const now = Date.now();
      const diff = Math.max(0, target - now);

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      const vals = [days, hours, mins, secs];
      values.forEach((el, i) => {
        el.textContent = String(vals[i]).padStart(2, '0');
      });
    }

    update();
    setInterval(update, 1000);
  }

  document.addEventListener('DOMContentLoaded', initCountdown);
</script>
