---
// ============================================================
// Componente: Hero — XV Elegante
// Portada espectacular estilo Liquid Glass + UI Espacial.
// Tarjeta de cristal flotante con nombre, fecha y detalles.
// ============================================================
import type { Colores, ContenidoCliente } from '../../../types/invitacion';

interface Props {
  datos: ContenidoCliente;
  colores: Colores;
}

const { datos, colores } = Astro.props;

const fechaEvento = new Date(datos.fecha + 'T00:00:00');
const opcionesFecha: Intl.DateTimeFormatOptions = {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
const fechaFormateada = fechaEvento.toLocaleDateString('es-MX', opcionesFecha);
---

<section
  class="relative flex min-h-[100dvh] flex-col items-center justify-center overflow-hidden px-6 py-20"
  style={`background: radial-gradient(ellipse at 30% 20%, ${colores.acento}18 0%, transparent 50%),
          radial-gradient(ellipse at 70% 80%, ${colores.primario}12 0%, transparent 50%),
          ${colores.fondo};`}
>
  <!-- Orbes decorativos flotantes -->
  <div
    class="animate-float pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full opacity-30 blur-3xl"
    style={`background: radial-gradient(circle, ${colores.acento}40, transparent 70%);`}
    aria-hidden="true"
  ></div>
  <div
    class="animate-float pointer-events-none absolute -right-16 -bottom-16 h-60 w-60 rounded-full opacity-20 blur-3xl"
    style={`background: radial-gradient(circle, ${colores.primario}30, transparent 70%);`}
    aria-hidden="true"
    style:animation-delay="3s"
  ></div>

  <!-- Tarjeta de cristal principal -->
  <div class="animate-fade-in-up glass-card-elevated relative mx-auto w-full max-w-md rounded-3xl px-8 py-14 text-center md:max-w-lg md:px-12 md:py-20"
    style={`background: linear-gradient(135deg, ${colores.fondo}cc, ${colores.fondo}88);`}
  >
    <!-- Icono XV decorativo -->
    <div class="animate-scale-in animate-delay-200 mx-auto mb-6" aria-hidden="true">
      <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="36" cy="36" r="33" stroke={`${colores.secundario}60`} stroke-width="0.5" fill="none" />
        <circle cx="36" cy="36" r="26" stroke={`${colores.acento}80`} stroke-width="0.5" fill="none" />
        <circle cx="36" cy="36" r="19" stroke={`${colores.secundario}40`} stroke-width="0.5" fill="none" />
        <text
          x="36" y="43"
          text-anchor="middle"
          fill={colores.primario}
          font-size="20"
          font-weight="600"
          font-family="'Playfair Display', serif"
        >XV</text>
      </svg>
    </div>

    <!-- Subtítulo -->
    <p
      class="animate-fade-in-up animate-delay-200 text-xs font-medium uppercase tracking-[0.35em]"
      style={`color: ${colores.secundario};`}
    >
      {datos.subtitulo}
    </p>

    <!-- Nombre de la quinceañera -->
    <h1
      class="animate-fade-in-up animate-delay-400 mt-5 font-serif text-4xl font-bold leading-tight sm:text-5xl md:text-6xl"
      style={`color: ${colores.primario};`}
    >
      {datos.titulo}
    </h1>

    <!-- Divisor decorativo -->
    <div class="animate-fade-in-up animate-delay-600 mt-6 flex items-center justify-center gap-4" aria-hidden="true">
      <span class="block h-px w-14 transition-all duration-700" style={`background: linear-gradient(to right, transparent, ${colores.secundario});`}></span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill={colores.acento} class="animate-pulse-glow rounded-full" style="animation-duration: 3s;">
        <path d="M12 2l2.4 7.4h7.6l-6 4.6 2.3 7-6.3-4.6-6.3 4.6 2.3-7-6-4.6h7.6z"/>
      </svg>
      <span class="block h-px w-14 transition-all duration-700" style={`background: linear-gradient(to left, transparent, ${colores.secundario});`}></span>
    </div>

    <!-- Fecha formateada -->
    <p
      class="animate-fade-in-up animate-delay-800 mt-5 font-serif text-lg capitalize md:text-xl"
      style={`color: ${colores.texto};`}
    >
      {fechaFormateada}
    </p>

    <!-- Hora del evento -->
    <p
      class="animate-fade-in-up animate-delay-1000 mt-2 text-base font-light tracking-wide"
      style={`color: ${colores.secundario};`}
    >
      {datos.hora} hrs
    </p>
  </div>

  <!-- Sección de Padres y Padrinos (debajo de la tarjeta) -->
  {(datos.padres?.length || datos.padrinos?.length) && (
    <div class="animate-fade-in-up animate-delay-1200 mx-auto mt-12 w-full max-w-md text-center md:max-w-lg">
      {datos.padres && datos.padres.length > 0 && (
        <div class="mb-6">
          <p class="text-xs font-medium uppercase tracking-[0.25em]" style={`color: ${colores.secundario};`}>
            Con el cariño de mis padres
          </p>
          {datos.padres.map((padre: string) => (
            <p class="mt-2 font-serif text-base" style={`color: ${colores.texto};`}>{padre}</p>
          ))}
        </div>
      )}
      {datos.padrinos && datos.padrinos.length > 0 && (
        <div class="mb-6">
          <p class="text-xs font-medium uppercase tracking-[0.25em]" style={`color: ${colores.secundario};`}>
            Y mis padrinos
          </p>
          {datos.padrinos.map((padrino: string) => (
            <p class="mt-2 font-serif text-base" style={`color: ${colores.texto};`}>{padrino}</p>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- Mensaje personal -->
  <div class="animate-fade-in-up animate-delay-1200 mx-auto mt-8 w-full max-w-md px-4 text-center md:max-w-lg">
    <blockquote
      class="font-serif text-base leading-relaxed italic md:text-lg"
      style={`color: ${colores.texto}dd;`}
    >
      "{datos.mensaje}"
    </blockquote>
  </div>

  <!-- Indicador de scroll -->
  <div class="animate-fade-in animate-delay-1200 absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
    <div
      class="flex h-10 w-6 items-start justify-center rounded-full border p-1.5"
      style={`border-color: ${colores.secundario}50;`}
    >
      <div
        class="h-2 w-1 rounded-full animate-slide-up"
        style={`background-color: ${colores.primario}80; animation: slideUp 1.5s ease-in-out infinite;`}
      ></div>
    </div>
  </div>
</section>
