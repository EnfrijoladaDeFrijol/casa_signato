---
// ============================================================
// Componente: DetallesRSVP — XV Elegante
// Sección unificada: Dress Code, Mesa de Regalos, y botón
// vibrante de "Confirmar Asistencia".
// ============================================================
import type { Colores } from '../../../types/invitacion';

interface Props {
  colores: Colores;
  /** Código de vestimenta (ej. "Formal / Cocktail") */
  dressCode?: string;
  /** Colores sugeridos para la vestimenta */
  coloresVestimenta?: string[];
  /** Sugerencias de mesa de regalos */
  mesaRegalos?: { tienda: string; enlace?: string }[];
  /** URL o acción del botón de confirmar asistencia */
  urlConfirmar?: string;
  /** Nombre de la quinceañera para el texto del RSVP */
  nombreQuinceañera?: string;
}

const {
  colores,
  dressCode = 'Formal / Cocktail',
  coloresVestimenta = ['Rosa empolvado', 'Dorado', 'Verde salvia', 'Marfil'],
  mesaRegalos = [
    { tienda: 'Liverpool', enlace: '#' },
    { tienda: 'Amazon', enlace: '#' },
  ],
  urlConfirmar = '#',
  nombreQuinceañera = 'la Quinceañera',
} = Astro.props;
---

<section
  class="relative overflow-hidden px-6 py-24 md:py-32"
  style={`background: linear-gradient(180deg, ${colores.fondo} 0%, ${colores.acento}0a 40%, ${colores.primario}08 70%, ${colores.fondo} 100%);`}
>
  <!-- Título de sección -->
  <div class="animate-fade-in-up mx-auto mb-16 max-w-lg text-center">
    <p
      class="text-xs font-medium uppercase tracking-[0.3em]"
      style={`color: ${colores.secundario};`}
    >
      Todo listo para el gran día
    </p>
    <h2
      class="mt-3 font-serif text-3xl font-semibold md:text-4xl"
      style={`color: ${colores.primario};`}
    >
      Detalles Importantes
    </h2>
    <div class="mx-auto mt-4 h-px w-16" style={`background: linear-gradient(to right, transparent, ${colores.secundario}, transparent);`}></div>
  </div>

  <div class="mx-auto max-w-4xl space-y-10">

    <!-- ═══════════ Dress Code ═══════════ -->
    <article
      class="animate-fade-in-up animate-delay-200 glass-card-elevated overflow-hidden rounded-3xl p-8 text-center md:p-10"
      style={`background: linear-gradient(145deg, ${colores.fondo}ee, ${colores.fondo}cc);`}
    >
      <!-- Icono vestimenta -->
      <div
        class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl"
        style={`background: ${colores.primario}12;`}
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={colores.primario} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6l-1 12h14l-1-12h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
        </svg>
      </div>

      <h3
        class="font-serif text-xl font-semibold md:text-2xl"
        style={`color: ${colores.primario};`}
      >
        Código de Vestimenta
      </h3>

      <p
        class="mt-3 text-lg font-medium"
        style={`color: ${colores.texto};`}
      >
        {dressCode}
      </p>

      <!-- Paleta de colores sugeridos -->
      {coloresVestimenta.length > 0 && (
        <div class="mt-5">
          <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em]" style={`color: ${colores.secundario};`}>
            Colores sugeridos
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            {coloresVestimenta.map((colorNombre) => (
              <span
                class="glass-card rounded-full px-4 py-1.5 text-xs font-medium"
                style={`color: ${colores.texto}cc; background: ${colores.acento}15;`}
              >
                {colorNombre}
              </span>
            ))}
          </div>
        </div>
      )}
    </article>

    <!-- ═══════════ Mesa de Regalos ═══════════ -->
    {mesaRegalos.length > 0 && (
      <article
        class="animate-fade-in-up animate-delay-400 glass-card-elevated overflow-hidden rounded-3xl p-8 text-center md:p-10"
        style={`background: linear-gradient(145deg, ${colores.fondo}ee, ${colores.fondo}cc);`}
      >
        <!-- Icono regalo -->
        <div
          class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl"
          style={`background: ${colores.acento}15;`}
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={colores.primario} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="8" width="18" height="13" rx="2"/>
            <path d="M12 8v13"/>
            <path d="M3 13h18"/>
            <path d="M12 8a3 3 0 10-3-3c0 2 3 3 3 3z"/>
            <path d="M12 8a3 3 0 113-3c0 2-3 3-3 3z"/>
          </svg>
        </div>

        <h3
          class="font-serif text-xl font-semibold md:text-2xl"
          style={`color: ${colores.primario};`}
        >
          Mesa de Regalos
        </h3>

        <p
          class="mx-auto mt-3 max-w-sm text-sm leading-relaxed"
          style={`color: ${colores.texto}99;`}
        >
          Tu presencia es el mejor regalo. Si deseas obsequiar algo, te dejamos estas sugerencias:
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
          {mesaRegalos.map((regalo) => (
            <a
              href={regalo.enlace || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="group/regalo glass-card flex items-center gap-2 rounded-2xl px-6 py-3 text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
              style={`color: ${colores.primario}; background: ${colores.primario}08;`}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover/regalo:scale-110">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              {regalo.tienda}
            </a>
          ))}
        </div>
      </article>
    )}

    <!-- ═══════════ Confirmar Asistencia (RSVP) ═══════════ -->
    <article
      class="animate-fade-in-up animate-delay-600 relative overflow-hidden rounded-3xl p-10 text-center md:p-14"
      style={`background: linear-gradient(135deg, ${colores.primario}10, ${colores.acento}15, ${colores.primario}08);`}
    >
      <!-- Orbe decorativo -->
      <div
        class="animate-float pointer-events-none absolute -top-10 -right-10 h-40 w-40 rounded-full opacity-20 blur-2xl"
        style={`background: ${colores.acento};`}
        aria-hidden="true"
      ></div>

      <!-- Icono corazón -->
      <div
        class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full"
        style={`background: linear-gradient(135deg, ${colores.primario}20, ${colores.acento}20);`}
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill={colores.primario} stroke="none">
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
        </svg>
      </div>

      <h3
        class="font-serif text-2xl font-semibold md:text-3xl"
        style={`color: ${colores.primario};`}
      >
        ¿Nos acompañas?
      </h3>

      <p
        class="mx-auto mt-4 max-w-md text-sm leading-relaxed"
        style={`color: ${colores.texto}bb;`}
      >
        Confirma tu asistencia para que {nombreQuinceañera} pueda preparar todo
        con mucho cariño para ti.
      </p>

      <!-- Botón vibrante RSVP -->
      <div class="mt-8">
        <a
          href={urlConfirmar}
          id="btn-confirmar-asistencia"
          class="animate-pulse-glow group/rsvp relative inline-flex items-center gap-3 rounded-full px-10 py-4 text-base font-semibold text-white shadow-2xl transition-all duration-300 hover:scale-[1.05] hover:shadow-3xl active:scale-[0.97]"
          style={`background: linear-gradient(135deg, ${colores.primario}, ${colores.acento}dd, ${colores.primario});
                  background-size: 200% 200%;
                  animation: pulseGlow 2.5s ease-in-out infinite, glassShimmer 4s ease-in-out infinite;`}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover/rsvp:rotate-12">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Confirmar Asistencia
        </a>
      </div>

      <p
        class="mt-5 text-xs"
        style={`color: ${colores.texto}60;`}
      >
        Favor de confirmar antes de la fecha del evento
      </p>
    </article>
  </div>
</section>
