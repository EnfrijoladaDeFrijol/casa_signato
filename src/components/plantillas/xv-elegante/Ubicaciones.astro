---
// ============================================================
// Componente: Ubicaciones — XV Elegante
// Tarjetas flotantes estilo UI Espacial para Ceremonia y
// Recepción con botones hacia Google Maps.
// ============================================================
import type { Colores, Ubicacion } from '../../../types/invitacion';

interface Props {
  ubicaciones: Ubicacion[];
  colores: Colores;
}

const { ubicaciones, colores } = Astro.props;

/** Etiquetas semánticas para las ubicaciones del evento */
const etiquetas = ['Ceremonia Religiosa', 'Recepción', 'Evento', 'Evento'];

/** Iconos SVG inline para cada tipo de ubicación */
const iconos = [
  // Iglesia / Ceremonia
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="${colores.primario}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 21V9l-6-4-6 4v12"/><path d="M9 21v-6h6v6"/><path d="M12 5V2"/><path d="M10 2h4"/></svg>`,
  // Fiesta / Recepción
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="${colores.primario}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22h20"/><path d="M6.36 17.4 4 22h16l-2.36-4.6"/><path d="M12 2l4.5 9h-9z"/><circle cx="12" cy="2" r="1" fill="${colores.acento}"/></svg>`,
  // Genérico
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="${colores.primario}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>`,
  // Genérico 2
  `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="${colores.primario}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>`,
];
---

<section
  class="relative px-6 py-24 md:py-32"
  style={`background: linear-gradient(180deg, ${colores.fondo} 0%, ${colores.acento}08 50%, ${colores.fondo} 100%);`}
>
  <!-- Título de sección -->
  <div class="animate-fade-in-up mx-auto mb-16 max-w-lg text-center">
    <p
      class="text-xs font-medium uppercase tracking-[0.3em]"
      style={`color: ${colores.secundario};`}
    >
      Nos encantaría verte en
    </p>
    <h2
      class="mt-3 font-serif text-3xl font-semibold md:text-4xl"
      style={`color: ${colores.primario};`}
    >
      Lugares del Evento
    </h2>
    <!-- Línea decorativa -->
    <div class="mx-auto mt-4 h-px w-16" style={`background: linear-gradient(to right, transparent, ${colores.secundario}, transparent);`}></div>
  </div>

  <!-- Grid de tarjetas -->
  <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
    {ubicaciones.map((ubi, idx) => (
      <article
        class={`animate-fade-in-up ${idx === 0 ? 'animate-delay-200' : 'animate-delay-400'} glass-card-elevated group relative overflow-hidden rounded-3xl p-8 text-center transition-all duration-500 hover:-translate-y-1 md:p-10`}
        style={`background: linear-gradient(145deg, ${colores.fondo}ee, ${colores.fondo}cc);`}
      >
        <!-- Acento decorativo superior -->
        <div
          class="absolute top-0 left-1/2 h-1 w-20 -translate-x-1/2 rounded-b-full transition-all duration-500 group-hover:w-32"
          style={`background: linear-gradient(to right, ${colores.acento}60, ${colores.primario}80, ${colores.acento}60);`}
          aria-hidden="true"
        ></div>

        <!-- Icono -->
        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl"
          style={`background: ${colores.primario}10;`}
        >
          <Fragment set:html={iconos[idx] || iconos[2]} />
        </div>

        <!-- Tipo de evento -->
        <p
          class="text-xs font-medium uppercase tracking-[0.2em]"
          style={`color: ${colores.acento};`}
        >
          {etiquetas[idx] || 'Evento'}
        </p>

        <!-- Nombre del lugar -->
        <h3
          class="mt-2 font-serif text-xl font-semibold md:text-2xl"
          style={`color: ${colores.primario};`}
        >
          {ubi.nombre}
        </h3>

        <!-- Hora -->
        <p
          class="mt-3 text-lg font-medium"
          style={`color: ${colores.texto};`}
        >
          {ubi.hora} hrs
        </p>

        <!-- Dirección -->
        <p
          class="mt-2 text-sm leading-relaxed"
          style={`color: ${colores.texto}99;`}
        >
          {ubi.direccion}
        </p>

        <!-- Botón Google Maps -->
        <a
          href={ubi.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="spatial-shadow group/btn mt-6 inline-flex items-center gap-2.5 rounded-full px-7 py-3 text-sm font-medium text-white transition-all duration-300 hover:scale-[1.03] hover:brightness-110 active:scale-[0.98]"
          style={`background: linear-gradient(135deg, ${colores.primario}, ${colores.primario}dd);`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Cómo llegar
        </a>
      </article>
    ))}
  </div>
</section>
