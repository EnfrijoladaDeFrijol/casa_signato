---
// ============================================================
// Componente: Itinerario — XV Elegante
// Línea de tiempo vertical animada y minimalista.
// Revela cada paso con animaciones escalonadas.
// ============================================================
import type { Colores, Ubicacion } from '../../../types/invitacion';

interface Props {
  ubicaciones: Ubicacion[];
  colores: Colores;
  /** Items adicionales del itinerario (opcionales) */
  extras?: { hora: string; titulo: string; descripcion: string }[];
}

const { ubicaciones, colores, extras = [] } = Astro.props;

/**
 * Construye los pasos del itinerario automáticamente a partir de
 * las ubicaciones del evento, enriqueciéndolos con etiquetas semánticas.
 */
const etiquetasDefault = ['Ceremonia Religiosa', 'Recepción y Celebración', 'Evento', 'Evento'];
const iconosTimeline = [
  // Cruz / Ceremonia
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${colores.fondo}" stroke-width="2" stroke-linecap="round"><path d="M12 3v18"/><path d="M5 8h14"/></svg>`,
  // Copa / Fiesta
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${colores.fondo}" stroke-width="2" stroke-linecap="round"><path d="M8 22h8"/><path d="M12 17v5"/><path d="M17 2H7l1 10c0 2.2 1.8 4 4 4s4-1.8 4-4L17 2z"/></svg>`,
  // Estrella / Genérico
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="${colores.fondo}"><path d="M12 2l2.4 7.4h7.6l-6 4.6 2.3 7-6.3-4.6-6.3 4.6 2.3-7-6-4.6h7.6z"/></svg>`,
  // Música / Baile
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${colores.fondo}" stroke-width="2" stroke-linecap="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
];

interface PasoItinerario {
  hora: string;
  titulo: string;
  descripcion: string;
  icono: string;
}

const pasos: PasoItinerario[] = ubicaciones.map((ubi, idx) => ({
  hora: ubi.hora,
  titulo: etiquetasDefault[idx] || 'Evento',
  descripcion: ubi.nombre,
  icono: iconosTimeline[idx] || iconosTimeline[2],
}));

// Agregar extras al final
extras.forEach((e, idx) => {
  pasos.push({
    hora: e.hora,
    titulo: e.titulo,
    descripcion: e.descripcion,
    icono: iconosTimeline[Math.min(idx + ubicaciones.length, iconosTimeline.length - 1)],
  });
});
---

<section
  class="relative px-6 py-24 md:py-32"
  style={`background-color: ${colores.fondo};`}
>
  <!-- Título de sección -->
  <div class="animate-fade-in-up mx-auto mb-20 max-w-lg text-center">
    <p
      class="text-xs font-medium uppercase tracking-[0.3em]"
      style={`color: ${colores.secundario};`}
    >
      Todo lo que necesitas saber
    </p>
    <h2
      class="mt-3 font-serif text-3xl font-semibold md:text-4xl"
      style={`color: ${colores.primario};`}
    >
      Itinerario del Día
    </h2>
    <div class="mx-auto mt-4 h-px w-16" style={`background: linear-gradient(to right, transparent, ${colores.secundario}, transparent);`}></div>
  </div>

  <!-- Línea de tiempo -->
  <div class="relative mx-auto max-w-lg">
    <!-- Línea vertical central -->
    <div
      class="absolute top-0 left-8 h-full w-px md:left-1/2 md:-translate-x-1/2"
      style={`background: linear-gradient(to bottom, transparent, ${colores.secundario}60, ${colores.secundario}60, transparent);`}
      aria-hidden="true"
    ></div>

    <!-- Pasos del itinerario -->
    {pasos.map((paso, idx) => {
      const delayClass = `animate-delay-${Math.min(idx * 200 + 200, 1200)}`;
      return (
        <div class={`animate-timeline-reveal ${delayClass} relative mb-14 flex items-start gap-6 pl-20 last:mb-0 md:pl-0 md:${idx % 2 === 0 ? 'pr-[calc(50%+2rem)] pl-0 text-right' : 'pl-[calc(50%+2rem)]'}`}>
          <!-- Nodo circular -->
          <div
            class="absolute left-4 flex h-10 w-10 items-center justify-center rounded-full shadow-lg md:left-1/2 md:-translate-x-1/2"
            style={`background: linear-gradient(135deg, ${colores.primario}, ${colores.acento});`}
          >
            <Fragment set:html={paso.icono} />
          </div>

          <!-- Tarjeta de contenido -->
          <div
            class="glass-card w-full rounded-2xl p-6 transition-all duration-300 hover:-translate-y-0.5"
            style={`background: ${colores.fondo}dd;`}
          >
            <!-- Hora -->
            <span
              class="inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wider"
              style={`background: ${colores.primario}15; color: ${colores.primario};`}
            >
              {paso.hora} hrs
            </span>
            <!-- Título -->
            <h3
              class="mt-3 font-serif text-lg font-semibold"
              style={`color: ${colores.primario};`}
            >
              {paso.titulo}
            </h3>
            <!-- Descripción -->
            <p
              class="mt-1 text-sm leading-relaxed"
              style={`color: ${colores.texto}99;`}
            >
              {paso.descripcion}
            </p>
          </div>
        </div>
      );
    })}
  </div>
</section>
