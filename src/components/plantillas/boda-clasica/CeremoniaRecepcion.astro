---
// ============================================================
// Boda Clásica — Ceremonia y Recepción
// Grid de ubicaciones con tarjetas y enlaces a Google Maps
// ============================================================
import type { ContenidoCliente, Colores } from '../../../types/invitacion';

interface Props {
  datos: ContenidoCliente;
  colores: Colores;
}

const { datos, colores } = Astro.props;

// Separar ubicaciones
const ceremonia = datos.ubicaciones[0];
const recepcion = datos.ubicaciones[1];
---

<section
  class="px-6 py-20"
  style={`background: linear-gradient(180deg, ${colores.primario}08 0%, ${colores.fondo} 100%);`}
>
  <div class="mx-auto max-w-4xl">
    <h2
      class="mb-16 text-center font-serif text-3xl font-semibold md:text-4xl"
      style={`color: ${colores.primario};`}
    >
      Detalles del Evento
    </h2>

    <div class="grid gap-12 md:grid-cols-2">
      {/* Ceremonia */}
      {ceremonia && (
        <div class="rounded-2xl border p-8 text-center transition-shadow duration-300 hover:shadow-lg"
          style={`border-color: ${colores.secundario}40; background-color: ${colores.fondo};`}
        >
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full" style={`background-color: ${colores.primario}15;`}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill={colores.primario} xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 7v2h20V7L12 2zM4 11v8h3v-8H4zm5 0v8h3v-8H9zm5 0v8h3v-8h-3zm5 0v8h3v-8h-3zM2 21h20v2H2v-2z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-semibold" style={`color: ${colores.primario};`}>
            Ceremonia
          </h3>
          <p class="mt-2 text-lg font-medium" style={`color: ${colores.acento};`}>
            {ceremonia.hora} hrs
          </p>
          <p class="mt-3 font-serif text-lg" style={`color: ${colores.texto};`}>
            {ceremonia.nombre}
          </p>
          <p class="mt-1 text-sm" style={`color: ${colores.texto}99;`}>
            {ceremonia.direccion}
          </p>
          <a
            href={ceremonia.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 rounded-full px-6 py-2 text-sm font-medium text-white transition-all duration-300 hover:scale-105 hover:shadow-md"
            style={`background-color: ${colores.primario};`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Ver en Google Maps
          </a>
        </div>
      )}

      {/* Recepción */}
      {recepcion && (
        <div class="rounded-2xl border p-8 text-center transition-shadow duration-300 hover:shadow-lg"
          style={`border-color: ${colores.secundario}40; background-color: ${colores.fondo};`}
        >
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full" style={`background-color: ${colores.acento}15;`}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill={colores.acento} xmlns="http://www.w3.org/2000/svg">
              <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-semibold" style={`color: ${colores.primario};`}>
            Recepción
          </h3>
          <p class="mt-2 text-lg font-medium" style={`color: ${colores.acento};`}>
            {recepcion.hora} hrs
          </p>
          <p class="mt-3 font-serif text-lg" style={`color: ${colores.texto};`}>
            {recepcion.nombre}
          </p>
          <p class="mt-1 text-sm" style={`color: ${colores.texto}99;`}>
            {recepcion.direccion}
          </p>
          <a
            href={recepcion.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 rounded-full px-6 py-2 text-sm font-medium text-white transition-all duration-300 hover:scale-105 hover:shadow-md"
            style={`background-color: ${colores.primario};`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Ver en Google Maps
          </a>
        </div>
      )}
    </div>
  </div>
</section>
