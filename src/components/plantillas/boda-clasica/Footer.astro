---
// ============================================================
// Boda Clásica — Footer
// Pie de página con despedida y ornamento decorativo
// ============================================================
import type { ContenidoCliente, Colores } from '../../../types/invitacion';

interface Props {
  datos: ContenidoCliente;
  colores: Colores;
  fechaFormateada: string;
}

const { datos, colores, fechaFormateada } = Astro.props;
---

<footer class="px-6 py-12 text-center" style={`background-color: ${colores.primario}08;`}>
  <p class="font-serif text-lg italic" style={`color: ${colores.secundario};`}>
    ¡Te esperamos con mucho cariño!
  </p>
  <p class="mt-4 font-serif text-2xl font-semibold" style={`color: ${colores.primario};`}>
    {datos.titulo}
  </p>
  <p class="mt-2 text-sm" style={`color: ${colores.texto}80;`}>
    {fechaFormateada} · {datos.hora} hrs
  </p>

  <div class="mx-auto mt-8" aria-hidden="true">
    <svg width="60" height="20" viewBox="0 0 60 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 10 H25 M35 10 H60" stroke={colores.secundario} stroke-width="1" opacity="0.4"/>
      <circle cx="30" cy="10" r="4" fill={colores.acento} opacity="0.6"/>
    </svg>
  </div>
</footer>
