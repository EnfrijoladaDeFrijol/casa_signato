---
// ============================================================
// Boda Clásica — Mensaje
// Sección del mensaje personal y nombres de padres
// ============================================================
import type { ContenidoCliente, Colores } from '../../../types/invitacion';

interface Props {
  datos: ContenidoCliente;
  colores: Colores;
}

const { datos, colores } = Astro.props;
---

<section class="px-6 py-20 text-center" style={`background-color: ${colores.fondo};`}>
  <div class="mx-auto max-w-2xl">
    <div class="mb-8" aria-hidden="true">
      <svg width="60" height="20" viewBox="0 0 60 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="mx-auto">
        <path d="M0 10 H25 M35 10 H60" stroke={colores.secundario} stroke-width="1" opacity="0.4"/>
        <circle cx="30" cy="10" r="4" fill={colores.acento} opacity="0.6"/>
      </svg>
    </div>

    {datos.padres && datos.padres.length > 0 && (
      <div class="mb-8">
        <p class="text-sm uppercase tracking-[0.2em]" style={`color: ${colores.secundario};`}>
          Con la bendición de nuestros padres
        </p>
        {datos.padres.map((padre: string) => (
          <p class="mt-2 font-serif text-lg" style={`color: ${colores.texto};`}>{padre}</p>
        ))}
      </div>
    )}

    <blockquote class="font-serif text-lg leading-relaxed italic md:text-xl" style={`color: ${colores.texto};`}>
      "{datos.mensaje}"
    </blockquote>
  </div>
</section>
