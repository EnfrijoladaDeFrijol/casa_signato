---
// ============================================================
// Boda Clásica — Hero
// Sección de bienvenida a pantalla completa con animaciones
// ============================================================
import type { ContenidoCliente, Colores } from '../../../types/invitacion';

interface Props {
  datos: ContenidoCliente;
  colores: Colores;
  fechaFormateada: string;
}

const { datos, colores, fechaFormateada } = Astro.props;
---

<section
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center"
  style={`background: linear-gradient(135deg, ${colores.fondo} 0%, ${colores.secundario}15 50%, ${colores.fondo} 100%);`}
>
  <!-- Ornamento decorativo superior -->
  <div class="animate-fade-in mb-6" aria-hidden="true">
    <svg width="120" height="40" viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M60 5 C30 5, 5 20, 5 35 M60 5 C90 5, 115 20, 115 35" stroke={colores.secundario} stroke-width="1.5" fill="none" opacity="0.6"/>
      <circle cx="60" cy="5" r="3" fill={colores.acento} opacity="0.8"/>
      <circle cx="5" cy="35" r="2" fill={colores.secundario} opacity="0.5"/>
      <circle cx="115" cy="35" r="2" fill={colores.secundario} opacity="0.5"/>
    </svg>
  </div>

  <p
    class="animate-slide-up font-serif text-sm tracking-[0.35em] uppercase"
    style={`color: ${colores.secundario};`}
  >
    {datos.subtitulo}
  </p>

  <h1
    class="animate-slide-up animate-delay-200 mt-4 font-serif text-5xl font-bold leading-tight md:text-7xl"
    style={`color: ${colores.primario};`}
  >
    {datos.titulo}
  </h1>

  <div class="animate-slide-up animate-delay-400 mt-6 flex items-center gap-4" aria-hidden="true">
    <span class="block h-px w-16" style={`background-color: ${colores.secundario};`}></span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill={colores.acento} xmlns="http://www.w3.org/2000/svg">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span class="block h-px w-16" style={`background-color: ${colores.secundario};`}></span>
  </div>

  <p
    class="animate-slide-up animate-delay-600 mt-4 font-serif text-xl capitalize md:text-2xl"
    style={`color: ${colores.texto};`}
  >
    {fechaFormateada}
  </p>

  <p
    class="animate-slide-up animate-delay-800 mt-2 text-lg font-light"
    style={`color: ${colores.secundario};`}
  >
    {datos.hora} hrs
  </p>

  <!-- Indicador de scroll -->
  <div class="absolute bottom-8 animate-bounce" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={colores.secundario} stroke-width="2">
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </div>
</section>
