---
import { MARCA, esWhatsappActivo, obtenerEnlaceCotizacion } from '../../data/marca';

const enlaceCotizar = obtenerEnlaceCotizacion();
const usaWhatsapp = esWhatsappActivo();

const enlaces = [
  { href: '#muestras', etiqueta: 'Muestras' },
  { href: '#como-funciona', etiqueta: 'Cómo funciona' },
  { href: '#paquetes', etiqueta: 'Paquetes' },
  { href: '#preguntas', etiqueta: 'Preguntas' },
];
---

<header id="site-navbar" data-scrolled="false" class="nav-header">
  <div class="nav-shell">
    <div class="nav-bar">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-2 px-3 py-2 sm:px-6 sm:py-2.5">
        <a
          href="#inicio"
          class="nav-brand inline-flex min-h-[44px] items-center gap-2.5 pr-2 hover:opacity-85"
        >
          <span class="nav-logo-stack relative inline-flex h-9 w-12 shrink-0 items-center justify-center">
            <img
              src="/marca/logo-blanco.png"
              alt={MARCA.nombre}
              width="48"
              height="36"
              class="nav-logo-claro absolute inset-0 h-9 w-12 object-contain object-center"
            />
            <img
              src="/marca/logo-color.png"
              alt=""
              aria-hidden="true"
              width="48"
              height="36"
              class="nav-logo-color absolute inset-0 h-9 w-12 object-contain object-center"
            />
          </span>
          <span class="font-display text-xl font-semibold leading-none tracking-wide sm:text-2xl">
            {MARCA.nombre}
          </span>
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Secciones principales">
          {enlaces.map((item) => (
            <a href={item.href} class="nav-link text-sm font-medium">
              {item.etiqueta}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="#muestras"
            class="nav-cta inline-flex min-h-[38px] items-center justify-center rounded-full px-4 py-1.5 text-[13px] font-medium tracking-[0.01em] active:scale-[0.98] md:hidden"
          >
            Muestras
          </a>

          <a
            href={enlaceCotizar}
            target={usaWhatsapp ? '_blank' : undefined}
            rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
            class="nav-cta hidden min-h-[40px] items-center justify-center rounded-full px-5 py-1.5 text-[13px] font-medium tracking-[0.02em] active:scale-[0.98] md:inline-flex"
          >
            Cotizar
          </a>

          <button
            type="button"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-movil-menu"
            aria-label="Abrir menú de navegación"
            class="nav-toggle inline-flex h-10 w-10 items-center justify-center rounded-full active:scale-[0.96] md:hidden"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path data-icono-abrir d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
              <path data-icono-cerrar class="hidden" d="M6 6l12 12M18 6l-12 12" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div id="nav-movil-menu" class="nav-movil-menu mt-2 hidden flex-col gap-1 rounded-3xl p-3 md:hidden">
      {enlaces.map((item) => (
        <a
          href={item.href}
          data-nav-enlace
          class="nav-movil-enlace flex min-h-[48px] items-center justify-between rounded-2xl px-4 text-sm font-medium"
        >
          <span>{item.etiqueta}</span>
          <svg class="nav-movil-flecha h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
      <a
        href={enlaceCotizar}
        target={usaWhatsapp ? '_blank' : undefined}
        rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
        data-nav-enlace
        class="nav-movil-cta mt-1 flex min-h-[48px] items-center justify-center rounded-lg px-5 text-sm font-medium tracking-[0.01em] active:scale-[0.98]"
      >
        Cotizar mi evento
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-navbar');
  const boton = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-movil-menu');
  const iconoAbrir = boton?.querySelector('[data-icono-abrir]');
  const iconoCerrar = boton?.querySelector('[data-icono-cerrar]');

  const alternar = (abrir: boolean) => {
    if (!boton || !menu) return;
    boton.setAttribute('aria-expanded', abrir ? 'true' : 'false');
    boton.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú de navegación');
    menu.classList.toggle('hidden', !abrir);
    menu.classList.toggle('flex', abrir);
    iconoAbrir?.classList.toggle('hidden', abrir);
    iconoCerrar?.classList.toggle('hidden', !abrir);
  };

  boton?.addEventListener('click', () => alternar(boton.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-nav-enlace]').forEach((el) => el.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') alternar(false); });

  if (header) {
    let rafId = 0;

    const actualizarEstadoScroll = () => {
      rafId = 0;
      const desplazado = window.scrollY > 40;
      const valor = desplazado ? 'true' : 'false';
      if (header.dataset.scrolled !== valor) {
        header.dataset.scrolled = valor;
      }
    };

    const programarScroll = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(actualizarEstadoScroll);
    };

    window.addEventListener('scroll', programarScroll, { passive: true });
    window.addEventListener('resize', programarScroll, { passive: true });
    actualizarEstadoScroll();
  }
</script>
