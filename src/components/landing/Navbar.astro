---
import { MARCA, esWhatsappActivo, obtenerEnlaceCotizacion } from '../../data/marca';

const enlaceCotizar = obtenerEnlaceCotizacion();
const usaWhatsapp = esWhatsappActivo();

const enlaces = [
  { href: '#muestras', etiqueta: 'Muestras' },
  { href: '#como-funciona', etiqueta: 'Cómo funciona' },
  { href: '#paquetes', etiqueta: 'Paquetes' },
  { href: '#preguntas', etiqueta: 'Preguntas' },
];
---

<header class="sticky top-3 z-50 mx-auto w-full max-w-6xl px-3 sm:top-4 sm:px-6">
  <div class="glass-nav flex items-center justify-between gap-2 rounded-full px-3 py-2 sm:px-5 sm:py-2.5">
    <a
      href="#inicio"
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full pr-2 text-signato-contraste transition-opacity hover:opacity-80"
    >
      <span class="inline-flex h-8 w-12 shrink-0 items-center justify-center overflow-hidden">
        <img
          src="/marca/logo-color.png"
          alt={MARCA.nombre}
          width="108"
          height="135"
          class="h-auto w-full max-w-none -translate-y-[2%]"
        />
      </span>
      <span class="font-display text-xl font-semibold tracking-wide sm:text-2xl">
        {MARCA.nombre}
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Secciones principales">
      {enlaces.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-signato-contraste/80 transition-colors hover:text-signato-contraste"
        >
          {item.etiqueta}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <a
        href="#muestras"
        class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-signato-contraste px-4 text-xs font-semibold tracking-wide text-signato-lienzo transition-transform active:scale-[0.98] md:hidden"
      >
        Muestras
      </a>

      <a
        href={enlaceCotizar}
        target={usaWhatsapp ? '_blank' : undefined}
        rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
        class="hidden min-h-[44px] items-center justify-center rounded-full bg-signato-contraste px-5 text-xs font-semibold uppercase tracking-[0.14em] text-signato-lienzo transition-all hover:bg-signato-principal active:scale-[0.98] md:inline-flex"
      >
        Cotizar
      </a>

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-movil-menu"
        aria-label="Abrir menú de navegación"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-signato-secundario/50 text-signato-contraste transition-transform active:scale-[0.96] md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path data-icono-abrir d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          <path data-icono-cerrar class="hidden" d="M6 6l12 12M18 6l-12 12" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-movil-menu" class="glass-nav mt-2 hidden flex-col gap-1 rounded-3xl p-3 md:hidden">
    {enlaces.map((item) => (
      <a
        href={item.href}
        data-nav-enlace
        class="flex min-h-[48px] items-center justify-between rounded-2xl px-4 text-sm font-medium text-signato-contraste transition-colors hover:bg-white/55"
      >
        <span>{item.etiqueta}</span>
        <svg class="h-4 w-4 text-signato-principal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ))}
    <a
      href={enlaceCotizar}
      target={usaWhatsapp ? '_blank' : undefined}
      rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
      data-nav-enlace
      class="mt-1 flex min-h-[48px] items-center justify-center rounded-full bg-signato-principal px-5 text-xs font-semibold uppercase tracking-[0.14em] text-signato-lienzo transition-transform active:scale-[0.98]"
    >
      Cotizar mi evento
    </a>
  </div>
</header>

<script>
  const boton = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-movil-menu');
  const iconoAbrir = boton?.querySelector('[data-icono-abrir]');
  const iconoCerrar = boton?.querySelector('[data-icono-cerrar]');

  const alternar = (abrir: boolean) => {
    if (!boton || !menu) return;
    boton.setAttribute('aria-expanded', abrir ? 'true' : 'false');
    boton.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú de navegación');
    menu.classList.toggle('hidden', !abrir);
    menu.classList.toggle('flex', abrir);
    iconoAbrir?.classList.toggle('hidden', abrir);
    iconoCerrar?.classList.toggle('hidden', !abrir);
  };

  boton?.addEventListener('click', () => alternar(boton.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-nav-enlace]').forEach((el) => el.addEventListener('click', () => alternar(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') alternar(false); });
</script>
