---
import { clientes } from '../../data/clientes';
import { PASOS_PROCESO, PREGUNTAS_FRECUENTES } from '../../data/landing';
import { MARCA, esWhatsappActivo, obtenerEnlaceCotizacion } from '../../data/marca';
import type { CategoriaEvento, ModulosInvitacion } from '../../types/invitacion';
import type { ItemIndiceBusqueda } from '../../scripts/navbarBuscador';
import { obtenerEtiquetaCategoria } from '../../utils/categorias';
import {
  PLANES_INFO,
  PLANES_MODULOS_BASE,
  PLANES_ORDEN,
  resolverModulos,
} from '../../utils/planes';

const enlaceCotizar = obtenerEnlaceCotizacion();
const usaWhatsapp = esWhatsappActivo();

const enlaces = [
  { href: '#muestras', etiqueta: 'Muestras' },
  { href: '#como-funciona', etiqueta: 'Cómo funciona' },
  { href: '#paquetes', etiqueta: 'Paquetes' },
  { href: '#preguntas', etiqueta: 'Preguntas' },
];

const ALIAS_CATEGORIA: Record<CategoriaEvento, string> = {
  bodas: 'boda bodas matrimonio casamiento novios pareja',
  'xv-anos': 'xv quince quinceanera mis xv 15 anos',
  bautizos: 'bautizo bautizos sacramento bebe iglesia',
  cumpleanos: 'cumpleanos cumple fiesta celebracion',
};

function palabrasDeModulos(modulos: ModulosInvitacion): string {
  const lista: string[] = [];
  if (modulos.musica) lista.push('musica cancion audio reproductor');
  if (modulos.galeria) lista.push('galeria fotos sesiones');
  if (modulos.itinerario) lista.push('itinerario horarios cronograma');
  if (modulos.dressCode) lista.push('dress code vestimenta colores etiqueta');
  if (modulos.mesaRegalos) lista.push('mesa de regalos lluvia de sobres liverpool amazon');
  if (modulos.rsvpWhatsapp) lista.push('whatsapp confirmacion rsvp');
  if (modulos.rsvpGoogleForm) lista.push('rsvp formulario confirmacion google form');
  if (modulos.paseBoletos) lista.push('pase pases boletos lugares invitados ticket');
  if (modulos.calendario) lista.push('calendario agendar google apple');
  if (modulos.hoteles) lista.push('hoteles hospedaje foraneos');
  if (modulos.albumQr) lista.push('album qr fotos compartidas drive');
  return lista.join(' ');
}

// Privacidad estricta: únicamente demos públicas (esDemo === true); jamás clientes reales ni /admin
const muestrasIndexadas: ItemIndiceBusqueda[] = clientes
  .filter((cliente) => cliente.esDemo === true)
  .map((demo) => {
    const modulos = resolverModulos(demo);
    const categoriaLabel = obtenerEtiquetaCategoria(demo.categoria);
    const planInfo = PLANES_INFO[demo.plan];
    const rutaBase = `/${demo.categoria}/${demo.slug}`;
    const href = modulos.paseBoletos ? `${rutaBase}?pases=4` : rutaBase;

    return {
      id: `muestra-${demo.categoria}-${demo.slug}`,
      tipo: 'muestra',
      etiquetaTipo: 'Muestra en vivo',
      titulo: demo.protagonistas,
      subtitulo: `${categoriaLabel} · Paquete ${planInfo.nombre} · ${demo.ciudad}`,
      href,
      imagen: demo.fotoPortada,
      imagenAlt: demo.fotoPortadaAlt || demo.titulo,
      imagenPosicion: demo.fotoPosicion,
      palabrasClave: [
        demo.titulo,
        demo.protagonistas,
        demo.subtitulo,
        demo.ciudad,
        demo.tema,
        demo.categoria,
        categoriaLabel,
        ALIAS_CATEGORIA[demo.categoria],
        planInfo.nombre,
        'muestra muestras demo ejemplo invitacion invitaciones clasico editorial',
        palabrasDeModulos(modulos),
      ].join(' '),
    };
  });

const paquetesIndexados: ItemIndiceBusqueda[] = PLANES_ORDEN.map((planId) => {
  const plan = PLANES_INFO[planId];
  const modulosBase = PLANES_MODULOS_BASE[planId];
  const precioTexto = `$${plan.precioMXN} MXN`;

  return {
    id: `paquete-${plan.id}`,
    tipo: 'paquete',
    etiquetaTipo: 'Paquete',
    meta: precioTexto,
    titulo: `Paquete ${plan.nombre}`,
    subtitulo: plan.descripcion,
    href: '#paquetes',
    palabrasClave: [
      plan.nombre,
      plan.etiqueta,
      plan.descripcion,
      plan.beneficios.join(' '),
      String(plan.precioMXN),
      precioTexto,
      'precio precios costo costos paquete paquetes plan planes cotizar pago unico mxn',
      palabrasDeModulos(modulosBase),
    ].join(' '),
  };
});

const preguntasIndexadas: ItemIndiceBusqueda[] = PREGUNTAS_FRECUENTES.map((faq, idx) => ({
  id: `pregunta-${idx + 1}`,
  tipo: 'pregunta',
  etiquetaTipo: 'Pregunta',
  titulo: faq.pregunta,
  subtitulo: faq.respuesta,
  href: '#preguntas',
  palabrasClave: [
    faq.pregunta,
    faq.respuesta,
    'pregunta preguntas duda dudas faq',
    idx === 0 ? 'envios ilimitados invitados whatsapp' : '',
    idx === 1 ? 'entrega tiempo 24 72 horas' : '',
    idx === 2 ? 'extras modulos boletos musica formulario' : '',
    idx === 3 ? 'confirmacion rsvp whatsapp formulario' : '',
    idx === 4 ? 'cambios editar modificar actualizar horario direccion' : '',
    idx === 5 ? 'vigencia duracion activa pago transferencia precio costo' : '',
  ]
    .filter(Boolean)
    .join(' '),
}));

const pasosIndexados: ItemIndiceBusqueda[] = PASOS_PROCESO.map((paso) => ({
  id: `paso-${paso.numero}`,
  tipo: 'proceso',
  etiquetaTipo: 'Cómo funciona',
  meta: `Paso ${paso.numero}`,
  titulo: paso.titulo,
  subtitulo: paso.descripcion,
  href: '#como-funciona',
  palabrasClave: [
    paso.titulo,
    paso.descripcion,
    'como funciona proceso pasos entrega 24 72 whatsapp envio datos estilo',
  ].join(' '),
}));

const indiceBusquedaJson = JSON.stringify([
  ...muestrasIndexadas,
  ...paquetesIndexados,
  ...preguntasIndexadas,
  ...pasosIndexados,
]).replace(/</g, '\\u003c');
---

<header
  id="site-navbar"
  data-scrolled="false"
  data-hidden="false"
  data-search-open="false"
  class="nav-header"
>
  <div class="nav-shell">
    <div class="nav-bar">
      <div class="nav-bar-inner mx-auto flex w-full max-w-6xl items-center justify-between gap-2 px-3 py-2 sm:px-6 sm:py-2.5">
        <a
          href="#inicio"
          data-nav-enlace
          class="nav-brand inline-flex min-h-[44px] shrink-0 items-center gap-2.5 pr-2 hover:opacity-85"
        >
          <span class="nav-logo-stack relative inline-flex h-9 w-12 shrink-0 items-center justify-center">
            <img
              src="/marca/logo-blanco.png"
              alt={MARCA.nombre}
              width="48"
              height="36"
              decoding="async"
              fetchpriority="high"
              class="nav-logo-claro absolute inset-0 h-9 w-12 object-contain object-center"
            />
            <img
              src="/marca/logo-color.png"
              alt=""
              aria-hidden="true"
              width="48"
              height="36"
              decoding="async"
              class="nav-logo-color absolute inset-0 h-9 w-12 object-contain object-center"
            />
          </span>
          <span class="nav-brand-text font-display text-xl font-semibold leading-none tracking-wide sm:text-2xl">
            {MARCA.nombre}
          </span>
        </a>

        <nav class="nav-desktop-links hidden items-center gap-7 md:flex" aria-label="Secciones principales">
          {enlaces.map((item) => (
            <a href={item.href} data-nav-seccion class="nav-link text-sm font-medium">
              {item.etiqueta}
            </a>
          ))}
        </nav>

        <div
          id="nav-search-inline"
          class="nav-search-inline flex min-w-0 flex-1 items-center gap-1 sm:gap-2"
          role="search"
        >
          <svg
            class="nav-search-lead hidden h-4 w-4 shrink-0 sm:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5" />
            <path d="M16 16l4.5 4.5" stroke-linecap="round" />
          </svg>
          <label for="nav-search-input" class="sr-only">
            Buscar muestras, paquetes o preguntas frecuentes
          </label>
          <input
            type="search"
            id="nav-search-input"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder="Buscar diseños, precios..."
            class="nav-search-input h-10 w-full min-w-0 flex-1 bg-transparent text-base leading-normal focus:outline-none"
          />
          <button
            type="button"
            id="nav-search-clear"
            aria-label="Cerrar búsqueda"
            class="nav-search-clear -mr-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full active:scale-95 sm:mr-0"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6l-12 12" stroke-linecap="round" />
            </svg>
          </button>
        </div>

        <div class="flex shrink-0 items-center gap-1 sm:gap-2">
          <button
            type="button"
            id="nav-search-toggle"
            aria-expanded="false"
            aria-controls="nav-search-panel"
            aria-label="Buscar muestras, paquetes o dudas"
            class="nav-toggle nav-search-toggle inline-flex h-10 w-10 items-center justify-center rounded-full active:scale-95"
          >
            <svg
              class="h-[18px] w-[18px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="6.5" />
              <path d="M16 16l4.5 4.5" stroke-linecap="round" />
            </svg>
          </button>

          <a
            href={enlaceCotizar}
            target={usaWhatsapp ? '_blank' : undefined}
            rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
            class="nav-cta hidden min-h-[40px] items-center justify-center rounded-full px-5 py-1.5 text-[13px] font-medium tracking-[0.02em] active:scale-[0.98] md:inline-flex"
          >
            Cotizar
          </a>

          <button
            type="button"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-movil-menu"
            aria-label="Abrir menú de navegación"
            class="nav-toggle inline-flex h-10 w-10 items-center justify-center rounded-full active:scale-95 md:hidden"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path data-icono-abrir d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
              <path data-icono-cerrar class="hidden" d="M6 6l12 12M18 6l-12 12" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div
      id="nav-search-panel"
      aria-hidden="true"
      data-cotizar-href={enlaceCotizar}
      data-cotizar-externo={usaWhatsapp ? 'true' : 'false'}
      class="nav-search-panel mt-2 hidden rounded-3xl p-2.5 sm:p-3"
    >
      <div id="nav-search-results" class="max-h-[min(68vh,28rem)] overflow-y-auto overscroll-contain">
      </div>
    </div>

    <div id="nav-movil-menu" class="nav-movil-menu mt-2 hidden flex-col gap-0.5 rounded-3xl p-2.5 md:hidden">
      {enlaces.map((item) => (
        <a
          href={item.href}
          data-nav-enlace
          data-nav-seccion
          class="nav-movil-enlace flex min-h-[44px] items-center justify-between rounded-2xl px-4 text-sm font-medium"
        >
          <span>{item.etiqueta}</span>
          <svg class="nav-movil-flecha h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
      <div class="nav-movil-pie mt-1.5 flex items-center justify-between gap-3 px-4 pt-3 pb-1">
        <span class="nav-movil-nota text-xs leading-snug">
          ¿Planeas un evento?
        </span>
        <a
          href={enlaceCotizar}
          target={usaWhatsapp ? '_blank' : undefined}
          rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
          data-nav-enlace
          class="nav-movil-cta inline-flex min-h-[38px] shrink-0 items-center gap-1.5 rounded-full px-4 py-1.5 text-[13px] font-medium tracking-[0.01em] active:scale-[0.98]"
        >
          <span>Cotizar</span>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script type="application/json" id="nav-search-index" set:html={indiceBusquedaJson} />

<script>
  import { inicializarBuscadorNavbar } from '../../scripts/navbarBuscador';

  const header = document.getElementById('site-navbar');
  const boton = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-movil-menu');
  const iconoAbrir = boton?.querySelector('[data-icono-abrir]');
  const iconoCerrar = boton?.querySelector('[data-icono-cerrar]');

  let menuAbierto = false;
  let cerrarBusqueda: ((opciones?: { devolverFoco?: boolean }) => void) | null = null;
  let iniciarNavegacionSeccionRef: (() => void) | null = null;

  const alternar = (abrir: boolean) => {
    if (!boton || !menu || menuAbierto === abrir) return;
    if (abrir) {
      cerrarBusqueda?.({ devolverFoco: false });
    }
    menuAbierto = abrir;
    boton.setAttribute('aria-expanded', abrir ? 'true' : 'false');
    boton.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú de navegación');
    menu.classList.toggle('hidden', !abrir);
    menu.classList.toggle('flex', abrir);
    iconoAbrir?.classList.toggle('hidden', abrir);
    iconoCerrar?.classList.toggle('hidden', !abrir);
  };

  if (header) {
    const buscador = inicializarBuscadorNavbar({
      header,
      onAbrir: () => alternar(false),
      onNavegarSeccion: () => iniciarNavegacionSeccionRef?.(),
    });
    cerrarBusqueda = buscador.cerrar;
  }

  boton?.addEventListener('click', () => alternar(!menuAbierto));
  header?.querySelectorAll('[data-nav-enlace]').forEach((el) =>
    el.addEventListener('click', () => {
      alternar(false);
      cerrarBusqueda?.({ devolverFoco: false });
    }),
  );

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && menuAbierto) {
      alternar(false);
      boton?.focus();
    }
  });

  document.addEventListener('click', (evento) => {
    if (!menuAbierto || !header) return;
    const destino = evento.target as Node | null;
    if (destino && !header.contains(destino)) {
      alternar(false);
    }
  });

  if (header) {
    const UMBRAL_ESTILO = 40;
    const UMBRAL_TOPE_VISIBLE = 48;
    const UMBRAL_TOPE_OCULTAR = 480;
    const UMBRAL_BAJADA = 520;
    const UMBRAL_SUBIDA = 220;
    const PAUSA_REINICIO_MS = 1200;
    const RETARDO_OCULTAR_CLICK_MS = 180;

    let rafId = 0;
    let ultimoY = Math.max(0, window.scrollY);
    let bajadaAcumulada = 0;
    let subidaAcumulada = 0;
    let navegandoSeccion = false;
    let timerFinNavegacion = 0;
    let timerOcultarClick = 0;
    let timerPausaScroll = 0;

    const establecerEstado = (clave: 'scrolled' | 'hidden', activo: boolean) => {
      const valor = activo ? 'true' : 'false';
      if (header.dataset[clave] !== valor) {
        header.dataset[clave] = valor;
      }
    };

    const finalizarNavegacionSeccion = () => {
      window.clearTimeout(timerFinNavegacion);
      if (!navegandoSeccion) return;
      window.clearTimeout(timerOcultarClick);
      if (header.dataset.searchOpen !== 'true') {
        establecerEstado('hidden', true);
      }
      navegandoSeccion = false;
      ultimoY = Math.max(0, window.scrollY);
      bajadaAcumulada = 0;
      subidaAcumulada = 0;
    };

    const iniciarNavegacionSeccion = () => {
      navegandoSeccion = true;
      bajadaAcumulada = 0;
      subidaAcumulada = 0;
      alternar(false);
      cerrarBusqueda?.({ devolverFoco: false });
      window.clearTimeout(timerOcultarClick);
      timerOcultarClick = window.setTimeout(() => {
        if (header.dataset.searchOpen !== 'true') {
          establecerEstado('hidden', true);
        }
      }, RETARDO_OCULTAR_CLICK_MS);
      window.clearTimeout(timerFinNavegacion);
      timerFinNavegacion = window.setTimeout(finalizarNavegacionSeccion, 850);
    };

    iniciarNavegacionSeccionRef = iniciarNavegacionSeccion;

    header.querySelectorAll<HTMLAnchorElement>('[data-nav-seccion]').forEach((enlace) => {
      enlace.addEventListener('click', iniciarNavegacionSeccion);
    });

    header.addEventListener('focusin', (evento) => {
      const destino = evento.target as HTMLElement | null;
      if (destino && destino.matches(':focus-visible') && !navegandoSeccion) {
        establecerEstado('hidden', false);
      }
    });

    const actualizarEstadoScroll = () => {
      rafId = 0;
      const yActual = Math.max(0, window.scrollY);

      establecerEstado('scrolled', yActual > UMBRAL_ESTILO);

      if (header.dataset.searchOpen === 'true') {
        establecerEstado('hidden', false);
        ultimoY = yActual;
        bajadaAcumulada = 0;
        subidaAcumulada = 0;
        return;
      }

      if (navegandoSeccion) {
        ultimoY = yActual;
        bajadaAcumulada = 0;
        subidaAcumulada = 0;
        window.clearTimeout(timerFinNavegacion);
        timerFinNavegacion = window.setTimeout(finalizarNavegacionSeccion, 180);
        return;
      }

      const delta = yActual - ultimoY;
      ultimoY = yActual;

      if (yActual <= UMBRAL_TOPE_VISIBLE) {
        bajadaAcumulada = 0;
        subidaAcumulada = 0;
        establecerEstado('hidden', false);
        return;
      }

      if (delta > 0) {
        subidaAcumulada = 0;
        bajadaAcumulada += delta;
        window.clearTimeout(timerPausaScroll);
        timerPausaScroll = window.setTimeout(() => {
          bajadaAcumulada = 0;
        }, PAUSA_REINICIO_MS);

        if (menuAbierto && bajadaAcumulada >= 60) {
          alternar(false);
        }

        if (yActual > UMBRAL_TOPE_OCULTAR && bajadaAcumulada >= UMBRAL_BAJADA && !menuAbierto) {
          establecerEstado('hidden', true);
          bajadaAcumulada = 0;
        }
      } else if (delta < 0) {
        bajadaAcumulada = 0;

        // Evita que el rebote elástico al final de la página muestre la barra
        const maxScroll = Math.max(
          0,
          document.documentElement.scrollHeight - window.innerHeight,
        );
        if (maxScroll > 0 && yActual >= maxScroll - 16) {
          return;
        }

        subidaAcumulada += -delta;
        window.clearTimeout(timerPausaScroll);
        timerPausaScroll = window.setTimeout(() => {
          subidaAcumulada = 0;
        }, PAUSA_REINICIO_MS);

        if (subidaAcumulada >= UMBRAL_SUBIDA) {
          establecerEstado('hidden', false);
          subidaAcumulada = 0;
        }
      }
    };

    const programarScroll = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(actualizarEstadoScroll);
    };

    const manejarResize = () => {
      if (menuAbierto && window.innerWidth >= 768) {
        alternar(false);
      }
      programarScroll();
    };

    window.addEventListener('scroll', programarScroll, { passive: true });
    window.addEventListener('resize', manejarResize, { passive: true });
    if ('onscrollend' in window) {
      window.addEventListener('scrollend', finalizarNavegacionSeccion, { passive: true });
    }

    establecerEstado('scrolled', ultimoY > UMBRAL_ESTILO);
    establecerEstado('hidden', false);
  }
</script>
