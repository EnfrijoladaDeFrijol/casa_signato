---
import HeroMockup from './HeroMockup.astro';
import {
  esWhatsappActivo,
  obtenerEnlaceCotizacion,
  obtenerEtiquetaCtaCotizar,
} from '../../data/marca';

const enlaceCotizar = obtenerEnlaceCotizacion();
const usaWhatsapp = esWhatsappActivo();
const etiquetaCotizar = obtenerEtiquetaCtaCotizar();

// 3 planos de profundidad al hacer scroll (fondo difuso, plano medio con aros mínimos, primer plano de puntos suaves)
const capasAtmosfera = [
  {
    factorScroll: '0.12',
    elementos: [
      {
        clase: 'cs-burbuja--bruma-salvia',
        estilo: 'left: 6%; width: 52px; height: 52px; --b-dur: 26s; --b-delay: -5s; --b-dx: 12px; --b-op: 0.42; --b-y: 20%;',
      },
      {
        clase: 'cs-burbuja--bruma-arcilla',
        estilo: 'left: 78%; width: 64px; height: 64px; --b-dur: 28s; --b-delay: -16s; --b-dx: -14px; --b-op: 0.38; --b-y: 62%;',
      },
      {
        clase: 'cs-burbuja--bruma-salvia',
        estilo: 'left: 42%; width: 44px; height: 44px; --b-dur: 24s; --b-delay: -11s; --b-dx: 10px; --b-op: 0.32; --b-y: 78%;',
      },
    ],
  },
  {
    factorScroll: '0.28',
    elementos: [
      {
        clase: 'cs-burbuja--aro-tenue',
        estilo: 'left: 9%; width: 18px; height: 18px; --b-dur: 21s; --b-delay: -4s; --b-dx: 10px; --b-op: 0.36; --b-y: 68%;',
      },
      {
        clase: 'cs-burbuja--aro-salvia',
        estilo: 'left: 24%; width: 12px; height: 12px; --b-dur: 18s; --b-delay: -12s; --b-dx: -9px; --b-op: 0.34; --b-y: 26%;',
      },
      {
        clase: 'cs-burbuja--aro-arcilla',
        estilo: 'left: 72%; width: 14px; height: 14px; --b-dur: 19.5s; --b-delay: -7s; --b-dx: 9px; --b-op: 0.34; --b-y: 30%;',
      },
      {
        clase: 'cs-burbuja--aro-tenue',
        estilo: 'left: 88%; width: 22px; height: 22px; --b-dur: 22.5s; --b-delay: -15s; --b-dx: -11px; --b-op: 0.32; --b-y: 44%;',
      },
    ],
  },
  {
    factorScroll: '0.46',
    elementos: [
      {
        clase: 'cs-burbuja--destello',
        estilo: 'left: 14%; width: 6px; height: 6px; --b-dur: 15s; --b-delay: -2.5s; --b-dx: -7px; --b-op: 0.42; --b-y: 36%;',
      },
      {
        clase: 'cs-burbuja--destello',
        estilo: 'left: 33%; width: 5px; height: 5px; --b-dur: 14s; --b-delay: -9.5s; --b-dx: 8px; --b-op: 0.36; --b-y: 82%;',
      },
      {
        clase: 'cs-burbuja--destello',
        estilo: 'left: 63%; width: 6px; height: 6px; --b-dur: 16s; --b-delay: -5.5s; --b-dx: -8px; --b-op: 0.38; --b-y: 18%;',
      },
      {
        clase: 'cs-burbuja--destello',
        estilo: 'left: 85%; width: 7px; height: 7px; --b-dur: 15.5s; --b-delay: -11s; --b-dx: 9px; --b-op: 0.44; --b-y: 74%;',
      },
    ],
  },
];
---

<section
  id="inicio"
  class="hero-bosque velo-scope relative flex min-h-[100svh] flex-col justify-between pt-20 pb-6 text-signato-lienzo sm:pt-24 sm:pb-8"
>
  <!-- Atmósfera orgánica en el fondo: velos suaves y planos de profundidad al hacer scroll -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <div class="hero-profundidad" data-hero-capa="0.14">
      <div class="hero-velo hero-velo--salvia cs-velo-respirar -top-16 -left-24 h-80 w-80 sm:h-[30rem] sm:w-[30rem] lg:-left-10 lg:top-6"></div>
    </div>
    <div class="hero-profundidad" data-hero-capa="0.22">
      <div class="hero-velo hero-velo--arcilla cs-velo-respirar-alt -right-20 bottom-10 h-80 w-80 sm:h-[32rem] sm:w-[32rem] lg:right-[6%] lg:bottom-8"></div>
    </div>

    {capasAtmosfera.map((capa) => (
      <div class="hero-profundidad" data-hero-capa={capa.factorScroll}>
        {capa.elementos.map((burbuja) => (
          <span class={`cs-burbuja ${burbuja.clase}`} style={burbuja.estilo}></span>
        ))}
      </div>
    ))}
  </div>

  <!-- Contenido principal centrado en móvil y en 2 columnas en PC -->
  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 items-center px-4 py-4 sm:px-6 lg:py-8">
    <div class="grid w-full items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="flex flex-col items-center text-center lg:col-span-7 lg:items-start lg:text-left">
        <h1
          class="cs-enter font-display max-w-xl text-[2.45rem] font-medium leading-[1.03] tracking-[-0.01em] text-signato-lienzo sm:text-5xl lg:max-w-none lg:text-[4.2rem]"
          style="--i: 0"
        >
          Invitaciones digitales para{' '}
          <em class="font-normal italic text-[#A9C4A6]">XV Años, bodas</em>{' '}
          y bautizos
        </h1>

        <p
          class="cs-enter mt-4 max-w-md text-[15px] leading-relaxed text-signato-lienzo/80 sm:mt-5 sm:max-w-lg sm:text-base"
          style="--i: 1"
        >
          Diseño editorial pensado para abrir al instante desde WhatsApp, con envíos ilimitados y pago único sin mensualidades.
        </p>

        <div
          class="cs-enter mt-7 flex w-full flex-col items-center gap-4 sm:mt-8 sm:w-auto sm:flex-row sm:items-center sm:gap-7"
          style="--i: 2"
        >
          <a
            href="#muestras"
            class="hero-cta-primary group relative mx-auto inline-flex min-h-[48px] w-auto items-center justify-center gap-2.5 overflow-hidden isolate rounded-full px-7 py-3 text-[14.5px] font-medium tracking-[0.015em] active:scale-[0.98] sm:text-[15px] lg:mx-0"
          >
            <span class="relative z-10">Ver muestras en vivo</span>
            <svg
              class="hero-cta-flecha relative z-10 h-4 w-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <a
            href={enlaceCotizar}
            target={usaWhatsapp ? '_blank' : undefined}
            rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
            class="group inline-flex min-h-[44px] items-center justify-center px-1 text-[14px] font-normal tracking-[0.02em] text-signato-lienzo/90 transition-colors duration-300 hover:text-signato-lienzo"
          >
            <span class="inline-flex items-center gap-1.5 border-b border-signato-secundario/60 pb-1 transition-colors duration-300 group-hover:border-signato-lienzo">
              <span>{etiquetaCotizar}</span>
              <svg
                class="h-3.5 w-3.5 text-signato-secundario transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-signato-lienzo"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Vista previa en cristal oscuro para escritorio -->
      <div class="cs-enter hidden lg:col-span-5 lg:block" style="--i: 2">
        <HeroMockup sobreOscuro={true} />
      </div>
    </div>
  </div>

  <!-- Barra inferior compacta en cristal limpio + flecha para bajar -->
  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-3 px-4 sm:px-6">
    <dl
      class="cs-enter glass-dark-sutil grid w-full max-w-md grid-cols-3 divide-x divide-signato-lienzo/15 rounded-xl px-2 py-2.5 text-center sm:max-w-lg sm:py-3"
      style="--i: 3"
    >
      <div class="min-w-0 px-1.5">
        <dt class="text-[9.5px] font-medium uppercase tracking-[0.14em] text-signato-lienzo/60 sm:text-[10px]">
          Entrega
        </dt>
        <dd class="font-display mt-0.5 whitespace-nowrap text-base font-semibold leading-tight text-signato-lienzo sm:text-xl">
          24–72 hrs
        </dd>
      </div>
      <div class="min-w-0 px-1.5">
        <dt class="text-[9.5px] font-medium uppercase tracking-[0.14em] text-signato-lienzo/60 sm:text-[10px]">
          Envíos
        </dt>
        <dd class="font-display mt-0.5 whitespace-nowrap text-base font-semibold leading-tight text-signato-lienzo sm:text-xl">
          Ilimitados
        </dd>
      </div>
      <div class="min-w-0 px-1.5">
        <dt class="text-[9.5px] font-medium uppercase tracking-[0.14em] text-signato-lienzo/60 sm:text-[10px]">
          Pago único
        </dt>
        <dd class="font-display mt-0.5 whitespace-nowrap text-base font-semibold leading-tight text-[#A9C4A6] sm:text-xl">
          Desde $349
        </dd>
      </div>
    </dl>

    <a
      href="#vista-previa"
      aria-label="Deslizar a la vista previa interactiva"
      class="cs-flecha-bajar inline-flex h-8 w-8 items-center justify-center rounded-full text-signato-lienzo/70 transition-colors hover:text-signato-lienzo lg:hidden"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <a
      href="#muestras"
      aria-label="Explorar muestras interactivas"
      class="cs-flecha-bajar hidden h-8 w-8 items-center justify-center rounded-full text-signato-lienzo/70 transition-colors hover:text-signato-lienzo lg:inline-flex"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<!-- En móvil el mockup aparece limpio justo al bajar del Hero a pantalla completa -->
<section
  id="vista-previa"
  aria-label="Vista previa interactiva en celular"
  class="bg-signato-lienzo px-4 py-14 sm:py-16 lg:hidden"
>
  <HeroMockup />
</section>

<script>
  const hero = document.getElementById('inicio');
  const capas = hero?.querySelectorAll<HTMLElement>('[data-hero-capa]');
  const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && capas && capas.length > 0 && !reducirMovimiento) {
    let rafId = 0;

    const actualizarProfundidad = () => {
      rafId = 0;
      const altoHero = hero.offsetHeight || window.innerHeight;
      const scrollY = Math.max(0, window.scrollY);
      if (scrollY > altoHero * 1.25) return;

      capas.forEach((capa) => {
        const factor = Number(capa.dataset.heroCapa || '0');
        const desplazamiento = Math.round(scrollY * factor * 10) / 10;
        capa.style.transform = `translate3d(0, ${desplazamiento}px, 0)`;
      });
    };

    const programar = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(actualizarProfundidad);
    };

    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', programar, { passive: true });
    actualizarProfundidad();
  }
</script>
