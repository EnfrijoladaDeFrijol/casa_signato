---
const features = [
  {
    title: "Ecológicas",
    description: "Cero papel, cero desperdicios. Ayudamos al planeta sin sacrificar la elegancia y estilo de tu evento.",
    icon: "🌱"
  },
  {
    title: "Entrega Inmediata",
    description: "Recibe tu invitación digital en minutos y compártela por WhatsApp o redes sociales al instante.",
    icon: "⚡"
  },
  {
    title: "Diseños Exclusivos",
    description: "Plantillas únicas creadas por diseñadores profesionales para que tu invitación destaque.",
    icon: "🎨"
  }
];
---
<section class="py-24 px-4 sm:px-6 relative z-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-3xl md:text-5xl font-bold text-contraste tracking-tight">¿Por qué elegirnos?</h2>
      <p class="text-contraste/70 text-lg max-w-2xl mx-auto font-light">La manera más inteligente y hermosa de invitar a tus seres queridos.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="relative group h-full">
          <!-- Glassmorphism Card -->
          <div class="h-full bg-white/40 backdrop-blur-xl border border-white/50 p-8 rounded-[2rem] shadow-[0_8px_32px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_48px_rgba(0,0,0,0.08)] hover:bg-white/50 transition-all duration-500 hover:-translate-y-2">
            
            <!-- Icon floating effect -->
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-white/80 to-white/30 backdrop-blur-md flex items-center justify-center text-3xl mb-6 shadow-sm border border-white/60 group-hover:scale-110 transition-transform duration-500">
              {feature.icon}
            </div>
            
            <h3 class="text-2xl font-bold text-contraste mb-4">{feature.title}</h3>
            <p class="text-contraste/70 leading-relaxed font-light">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
