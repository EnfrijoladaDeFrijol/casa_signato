---
import {
  MARCA,
  obtenerEnlaceCotizacion,
  obtenerRedesActivas,
} from '../../data/marca';

const redesActivas = obtenerRedesActivas();
const anioActual = new Date().getFullYear();
const enlaceCotizar = obtenerEnlaceCotizacion();

const navegacion = [
  { href: '#muestras', etiqueta: 'Muestras' },
  { href: '#como-funciona', etiqueta: 'Cómo funciona' },
  { href: '#paquetes', etiqueta: 'Paquetes' },
  { href: '#preguntas', etiqueta: 'Preguntas' },
];
---

<footer class="border-t border-signato-secundario/40 bg-signato-lienzo">
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <a
          href="#inicio"
          class="inline-flex items-center gap-2.5 text-signato-contraste transition-opacity hover:opacity-80"
        >
          <span class="inline-flex h-9 w-14 shrink-0 items-center justify-center overflow-hidden">
            <img
              src="/marca/logo-color.png"
              alt={MARCA.nombre}
              loading="lazy"
              width="108"
              height="135"
              class="h-auto w-full max-w-none -translate-y-[2%]"
            />
          </span>
          <span class="font-display text-2xl font-semibold tracking-wide">
            {MARCA.nombre}
          </span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-signato-contraste/70">
          Invitaciones digitales en {MARCA.ubicacion}. Diseño editorial para XV Años, bodas, bautizos y celebraciones especiales.
        </p>
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:gap-12">
        <nav aria-label="Enlaces de pie de página">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-signato-principal">
            Secciones
          </p>
          <ul class="mt-3 space-y-2 text-sm text-signato-contraste/80">
            {navegacion.map((item) => (
              <li>
                <a href={item.href} class="inline-flex min-h-[36px] items-center transition-colors hover:text-signato-contraste">
                  {item.etiqueta}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-signato-principal">
            Contacto
          </p>
          <div class="mt-3 flex flex-col items-start gap-2 text-sm">
            <a
              href={enlaceCotizar}
              class="inline-flex min-h-[36px] items-center text-signato-contraste/85 underline decoration-signato-secundario underline-offset-4 transition-colors hover:text-signato-principal"
            >
              {MARCA.email}
            </a>

            <button
              type="button"
              data-copiar-correo={MARCA.email}
              class="inline-flex min-h-[36px] cursor-pointer items-center text-xs font-semibold uppercase tracking-[0.14em] text-signato-principal transition-opacity hover:opacity-80"
            >
              <span class="cs-swap">
                <span data-swap-a>Copiar correo</span>
                <span data-swap-b>Correo copiado</span>
              </span>
            </button>

            {redesActivas.length > 0 && (
              <div class="mt-1 flex flex-wrap items-center gap-3">
                {redesActivas.map((red) => (
                  <a
                    href={red.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[36px] items-center text-xs font-semibold uppercase tracking-[0.14em] text-signato-contraste/80 transition-colors hover:text-signato-principal"
                  >
                    {red.nombre}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-signato-secundario/35 pt-6 text-xs text-signato-contraste/65 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anioActual} {MARCA.nombre}. Todos los derechos reservados.</p>
      <p>Hecho en {MARCA.ubicacion}</p>
    </div>
  </div>
</footer>
