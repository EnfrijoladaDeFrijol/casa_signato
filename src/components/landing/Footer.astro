  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-center md:text-left">
      <h3 class="text-2xl font-bold text-contraste tracking-tight">Casa Signato</h3>
      <p class="text-contraste/60 mt-1 text-sm font-light">Creando conexiones memorables.</p>
    </div>
    
    <div class="flex gap-8">
      <a href="#" class="text-contraste/60 hover:text-principal transition-colors text-sm font-medium">Instagram</a>
      <a href="#" class="text-contraste/60 hover:text-principal transition-colors text-sm font-medium">Facebook</a>
      <a href="#" class="text-contraste/60 hover:text-principal transition-colors text-sm font-medium">TikTok</a>
    </div>
  </div>
  
  <div class="text-center pb-8 text-contraste/40 text-xs font-light">
    &copy; {new Date().getFullYear()} Casa Signato. Todos los derechos reservados.
