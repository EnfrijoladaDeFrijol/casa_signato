---
import type { ClienteInvitacion } from '../../types/invitacion';
import { formatearFechaCorta } from '../../utils/fechas';

interface Props {
  demo: ClienteInvitacion;
  href: string;
  etiquetaCategoria: string;
  nombrePlan: string;
  indice: number;
}

const { demo, href, etiquetaCategoria, nombrePlan, indice } = Astro.props;

const subtitulo = demo.subtitulo ?? etiquetaCategoria;
const fechaCorta = formatearFechaCorta(demo.fechaISO);
const paletaMuestra = demo.dressCode?.coloresSugeridos?.length
  ? demo.dressCode.coloresSugeridos.slice(0, 4).map((color) => color.hex)
  : [demo.temaColores.bg, demo.temaColores.accent, demo.temaColores.ink];
const esBoda = demo.categoria === 'bodas';
---

<a
  href={href}
  data-phone-link
  aria-label={`Abrir muestra interactiva de ${demo.protagonistas} (${etiquetaCategoria}, paquete ${nombrePlan})`}
  class="phone-frame group relative block w-full rounded-[2.65rem] bg-[#1F241E] p-[9px] text-left select-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signato-principal"
>
  <div class="phone-screen relative aspect-[9/19] w-full overflow-hidden rounded-[2.1rem] border border-[#2F362E] bg-[#242B23]">
    <img
      src={demo.fotoPortada}
      alt={demo.fotoPortadaAlt ?? demo.titulo}
      loading={indice < 3 ? 'eager' : 'lazy'}
      decoding="async"
      draggable="false"
      style={demo.fotoPosicion ? `object-position: ${demo.fotoPosicion}` : undefined}
      class="phone-ken-burns absolute inset-0 h-full w-full object-cover object-center"
    />

    <div class="phone-veil-top pointer-events-none absolute inset-x-0 top-0 h-[48%]" aria-hidden="true"></div>
    <div class="phone-veil-bottom pointer-events-none absolute inset-x-0 bottom-0 h-[44%]" aria-hidden="true"></div>

    <div class="relative z-10 flex h-full flex-col justify-between px-4 pt-3 pb-4 text-[#F7F6F2]">
      <div>
        <div class="flex items-center justify-between text-[10px] font-semibold tracking-tight text-[#F7F6F2]/92" aria-hidden="true">
          <span class="tabular-nums">9:41</span>
          <span class="h-[18px] w-[70px] rounded-full border border-[#2F362E]/80 bg-[#1F241E]"></span>
          <span class="flex items-center gap-1.5 text-[#F7F6F2]/90">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 18v-2m5 2v-5m5 5V9m5 9V5" stroke-linecap="round" />
            </svg>
            <svg class="h-3.5 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2.5" y="7" width="16.5" height="10" rx="2.5" />
              <path d="M21.5 10.5v3" stroke-linecap="round" />
              <path d="M6 10.5h9.5v3H6z" fill="currentColor" stroke="none" />
            </svg>
          </span>
        </div>

        <div class="phone-layer-drift mt-5 text-center">
          <p class="text-[9px] font-semibold uppercase tracking-[0.26em] text-[#F7F6F2]/85">
            {subtitulo}
          </p>
          <p
            class:list={[
              'font-display mt-1.5 text-[1.72rem] leading-[1.02] text-[#F7F6F2] sm:text-[1.92rem]',
              esBoda ? 'italic font-medium' : 'font-semibold',
            ]}
          >
            {demo.protagonistas}
          </p>
          <span class="mx-auto mt-2.5 block h-px w-8 bg-[#F7F6F2]/50" aria-hidden="true"></span>
          <p class="mt-2 text-[9.5px] font-medium uppercase tracking-[0.18em] text-[#F7F6F2]/85">
            {fechaCorta}
          </p>
        </div>
      </div>

      <div class="space-y-2.5">
        <div class="flex items-center justify-center gap-1.5" aria-hidden="true">
          {paletaMuestra.map((hex) => (
            <span
              class="h-2.5 w-2.5 rounded-full border border-[#F7F6F2]/75"
              style={`background-color:${hex}`}
            ></span>
          ))}
        </div>

        {demo.musica && (
          <div class="mx-auto flex max-w-full items-center justify-center gap-1.5 text-[10px] text-[#F7F6F2]/88">
            <svg class="h-3 w-3 shrink-0 text-[#F7F6F2]/85" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M9 18V6l11-2v12" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="6.5" cy="18" r="2.5" />
              <circle cx="17.5" cy="16" r="2.5" />
            </svg>
            <span class="truncate">{demo.musica.titulo}</span>
          </div>
        )}

        <div class="flex items-center justify-center gap-2 border-t border-[#F7F6F2]/22 pt-2 text-[9.5px] font-medium uppercase tracking-[0.2em] text-[#F7F6F2]/82">
          <span>{etiquetaCategoria}</span>
          <span class="h-px w-3 bg-[#F7F6F2]/45" aria-hidden="true"></span>
          <span>{nombrePlan}</span>
        </div>
      </div>
    </div>
  </div>
</a>
