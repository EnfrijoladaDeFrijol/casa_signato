---
const hrefDemo = '/xv-anos/sofia-xv?pases=4';
---

<div class="relative mx-auto w-full max-w-[308px] pb-4 sm:max-w-[328px]">
  <a
    href={hrefDemo}
    aria-label="Abrir muestra interactiva de XV Años de Sofía Ramírez con pase de 4 boletos"
    class="glass-surface group block rounded-[2.4rem] p-3 transition-transform duration-300 hover:-translate-y-1 active:scale-[0.98]"
  >
    <div class="overflow-hidden rounded-[1.85rem] border border-[#86494A]/20 bg-[#FBF6F2] px-4 pt-5 pb-4">
      <div class="relative mx-auto overflow-hidden rounded-t-[9rem] rounded-b-2xl border border-[#86494A]/35 bg-[#F5EAE4] px-5 pt-9 pb-7 text-center">
        <div
          class="pointer-events-none absolute inset-2 rounded-t-[8.5rem] rounded-b-xl border border-[#86494A]/20"
          aria-hidden="true"
        ></div>

        <p class="relative text-[10px] font-semibold uppercase tracking-[0.28em] text-[#86494A]">
          Mis XV Años
        </p>

        <p class="font-display relative mt-3 text-[2.85rem] font-medium leading-[0.95] text-[#3B2B2B] transition-transform duration-500 group-hover:scale-[1.02]">
          Sofía
        </p>
        <p class="font-display relative italic text-2xl leading-tight text-[#86494A]">
          Ramírez
        </p>

        <div class="relative mx-auto my-4 h-px w-12 bg-[#86494A]/45" aria-hidden="true"></div>

        <p class="relative text-[10px] font-semibold uppercase tracking-[0.2em] text-[#3B2B2B]/80">
          18 · Septiembre · 2027
        </p>
        <p class="relative mt-1 text-[11px] text-[#3B2B2B]/65">
          Guadalajara, Jal.
        </p>
      </div>

      <div class="mt-3.5 grid grid-cols-3 gap-2">
        <div class="rounded-xl border border-[#86494A]/15 bg-white/75 py-2 text-center">
          <p class="font-display text-lg font-semibold leading-none text-[#3B2B2B]">142</p>
          <p class="mt-0.5 text-[9px] uppercase tracking-wider text-[#3B2B2B]/65">Días</p>
        </div>
        <div class="rounded-xl border border-[#86494A]/15 bg-white/75 py-2 text-center">
          <p class="font-display text-lg font-semibold leading-none text-[#3B2B2B]">08</p>
          <p class="mt-0.5 text-[9px] uppercase tracking-wider text-[#3B2B2B]/65">Horas</p>
        </div>
        <div class="rounded-xl border border-[#86494A]/15 bg-white/75 py-2 text-center">
          <p class="font-display text-lg font-semibold leading-none text-[#3B2B2B]">45</p>
          <p class="mt-0.5 text-[9px] uppercase tracking-wider text-[#3B2B2B]/65">Min</p>
        </div>
      </div>

      <div class="mt-3.5 flex items-center justify-between border-t border-[#86494A]/18 pt-3 text-xs font-semibold text-[#3B2B2B]">
        <span>Abrir muestra en vivo</span>
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#86494A] text-[#FBF6F2] transition-transform group-hover:translate-x-0.5">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </div>
  </a>

  <div class="glass-surface cs-float pointer-events-none absolute right-2 bottom-0 flex items-center gap-2 rounded-2xl px-3 py-1.5 sm:-right-4">
    <svg class="h-3.5 w-3.5 text-signato-principal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4 9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V9Z" />
      <path d="M13 7v10" stroke-dasharray="2 2" stroke-linecap="round" />
    </svg>
    <span class="text-[11px] font-semibold tracking-wide text-signato-contraste">
      Pase · 4 lugares
    </span>
  </div>
</div>
