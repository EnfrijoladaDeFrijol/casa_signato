---
import {
  MARCA,
  esWhatsappActivo,
  obtenerEnlaceCotizacion,
  obtenerEtiquetaCtaCotizar,
} from '../../data/marca';
import { PLANES_INFO, PLANES_ORDEN } from '../../utils/planes';

const usaWhatsapp = esWhatsappActivo();
---

<section id="paquetes" class="velo-scope border-t border-signato-secundario/35 py-16 sm:py-24">
  <div class="velo-orb velo-orb--arcilla cs-drift-alt top-12 -left-12 h-80 w-80 sm:h-[28rem] sm:w-[28rem]" aria-hidden="true"></div>
  <div class="velo-orb velo-orb--salvia cs-drift top-1/3 left-1/3 h-80 w-80 sm:h-[26rem] sm:w-[26rem]" aria-hidden="true"></div>
  <div class="velo-orb velo-orb--arcilla cs-drift-alt bottom-10 -right-12 h-80 w-80 sm:h-[28rem] sm:w-[28rem]" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-signato-contraste/75">
          Pago único en MXN · <span class="text-signato-principal">Precios de lanzamiento</span>
        </p>
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
      </div>

      <h2 class="font-display mt-3 text-4xl font-medium leading-[1.06] text-signato-contraste sm:text-5xl">
        Tres paquetes claros para cada tipo de evento
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-signato-contraste/75 sm:text-base">
        Todos incluyen envíos ilimitados, diseño personalizado con tus colores y entrega en 24 a 72 horas.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3 lg:items-stretch">
      {PLANES_ORDEN.map((planId, idx) => {
        const plan = PLANES_INFO[planId];
        const enlace = obtenerEnlaceCotizacion(plan.nombre);
        const etiquetaBoton = obtenerEtiquetaCtaCotizar(plan.nombre);

        return (
          <article
            data-reveal
            style={`--rv: ${idx}`}
            class:list={[
              'flex flex-col justify-between rounded-3xl p-6 transition-transform duration-300 hover:-translate-y-1 sm:p-7',
              plan.destacado ? 'glass-card-featured' : 'glass-surface',
            ]}
          >
            <div>
              <div class="flex items-baseline justify-between gap-2 border-b border-signato-secundario/35 pb-3">
                <h3 class="font-display text-3xl font-semibold text-signato-contraste">{plan.nombre}</h3>
                <span
                  class:list={[
                    'text-[11px] font-semibold uppercase tracking-[0.18em]',
                    plan.destacado ? 'text-signato-principal' : 'text-signato-contraste/60',
                  ]}
                >
                  {plan.etiqueta}
                </span>
              </div>

              <p class="mt-4 flex items-baseline gap-1.5">
                <span class="font-display text-5xl font-medium leading-none text-signato-contraste">
                  ${plan.precioMXN}
                </span>
                <span class="text-xs font-medium uppercase tracking-wider text-signato-contraste/65">
                  MXN · Pago único
                </span>
              </p>

              <p class="mt-3 text-sm leading-relaxed text-signato-contraste/80">{plan.descripcion}</p>

              <ul class="mt-6 space-y-2.5 border-t border-signato-secundario/40 pt-5 text-sm text-signato-contraste/85">
                {plan.beneficios.map((beneficio) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-signato-principal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="m5 12.5 4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{beneficio}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={enlace}
              target={usaWhatsapp ? '_blank' : undefined}
              rel={usaWhatsapp ? 'noopener noreferrer' : undefined}
              class:list={[
                'mt-7 inline-flex min-h-[48px] w-full items-center justify-center rounded-full px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-all active:scale-[0.98]',
                plan.destacado
                  ? 'bg-signato-principal text-signato-lienzo hover:bg-signato-contraste'
                  : 'bg-signato-contraste text-signato-lienzo hover:bg-signato-principal',
              ]}
            >
              {etiquetaBoton}
            </a>
          </article>
        );
      })}
    </div>

    <div data-reveal class="glass-surface mt-8 flex flex-col items-start justify-between gap-4 rounded-3xl p-5 sm:flex-row sm:items-center sm:px-7">
      <div class="max-w-xl">
        <p class="text-sm font-semibold text-signato-contraste">¿Necesitas una función extra en tu paquete?</p>
        <p class="mt-1 text-xs leading-relaxed text-signato-contraste/75 sm:text-sm">
          Puedes sumar música, pase digital de boletos o confirmación en línea a cualquier nivel. Escríbenos a{' '}
          <span class="font-semibold text-signato-contraste">{MARCA.email}</span>.
        </p>
      </div>

      <button
        type="button"
        data-copiar-correo={MARCA.email}
        class="inline-flex min-h-[48px] w-full shrink-0 cursor-pointer items-center justify-center rounded-full border border-signato-contraste/25 bg-white/75 px-5 text-xs font-semibold uppercase tracking-[0.13em] text-signato-contraste transition-all hover:border-signato-principal hover:bg-white active:scale-[0.98] sm:w-auto"
      >
        <span class="cs-swap">
          <span data-swap-a>Copiar correo</span>
          <span data-swap-b class="text-signato-principal">Correo copiado</span>
        </span>
      </button>
    </div>
  </div>
</section>
