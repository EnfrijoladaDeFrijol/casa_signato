---
import { PASOS_PROCESO } from '../../data/landing';

const estrellaD =
  'M8 1.5C8.3 5.2 10.8 7.7 14.5 8 10.8 8.3 8.3 10.8 8 14.5 7.7 10.8 5.2 8.3 1.5 8 5.2 7.7 7.7 5.2 8 1.5Z';
---

<section id="como-funciona" class="velo-scope border-t border-signato-secundario/35 bg-white/45 py-12 sm:py-16 lg:py-20">
  <div class="velo-orb velo-orb--arcilla -top-12 -left-16 h-56 w-56 opacity-45 lg:h-72 lg:w-72" aria-hidden="true"></div>
  <div class="velo-orb velo-orb--salvia -right-16 -bottom-12 h-60 w-60 opacity-45 lg:h-72 lg:w-72" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-signato-principal">Proceso sencillo</p>
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
      </div>
      <h2 class="font-display mt-2.5 text-3xl font-medium leading-[1.06] text-signato-contraste sm:text-5xl">
        Tu invitación lista en tres pasos
      </h2>
    </div>

    <div data-reveal class="ruta-mapa relative mt-9 lg:mt-12">
      <div class="pointer-events-none absolute inset-x-0 top-0 hidden h-12 lg:block" aria-hidden="true">
        <svg class="h-full w-full" viewBox="0 0 1000 48" fill="none" preserveAspectRatio="none">
          <defs>
            <linearGradient id="cs-ruta-desk" x1="15%" y1="0%" x2="85%" y2="0%">
              <stop offset="0%" stop-color="#C6B4A6" stop-opacity="0.72" />
              <stop offset="56%" stop-color="#C6B4A6" stop-opacity="0.78" />
              <stop offset="100%" stop-color="#8BA888" stop-opacity="0.9" />
            </linearGradient>
          </defs>
          <path class="ruta-curva-trazo" d="M 157 24 C 258 4, 398 4, 500 24 C 602 44, 742 44, 843 24" stroke="url(#cs-ruta-desk)" stroke-width="1.15" stroke-linecap="round" vector-effect="non-scaling-stroke" pathLength="1" />
        </svg>
        <span class="ruta-estrella absolute top-[18.75%] left-[32.8%] -translate-x-1/2 -translate-y-1/2 text-signato-secundario" style="--st: 1">
          <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25"><path d={estrellaD} /></svg>
        </span>
        <span class="ruta-estrella absolute top-[81.25%] left-[67.2%] -translate-x-1/2 -translate-y-1/2 text-signato-principal" style="--st: 2">
          <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25"><path d={estrellaD} /></svg>
        </span>
      </div>

      <ol class="relative z-10 mx-auto max-w-md lg:grid lg:max-w-none lg:grid-cols-3 lg:gap-8">
        {PASOS_PROCESO.map((paso, idx) => (
          <li style={`--st: ${idx}`} class="ruta-estacion">
            <div class:list={[
              'flex items-center lg:flex-col lg:items-center lg:gap-0 lg:text-center',
              idx === 0 && 'gap-4',
              idx === 1 && 'flex-row-reverse gap-4 text-right',
              paso.destacado && 'flex-col text-center',
            ]}>
              <div
                class:list={[
                  'relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full',
                  paso.destacado ? 'ruta-nodo--destino' : idx === 0 ? 'glass-surface ruta-nodo ruta-nodo--uno' : 'glass-surface ruta-nodo',
                ]}
                aria-hidden="true"
              >
                {paso.icono === 'estilo' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.75" y="3.25" width="12.5" height="15.5" rx="2" />
                    <path d="M16.25 6.75h2A1.75 1.75 0 0 1 20 8.5V19a1.75 1.75 0 0 1-1.75 1.75H9.5A1.75 1.75 0 0 1 7.75 19v-.25" />
                    <path d="M7.25 8.25h5.5M7.25 11.5h5.5M7.25 14.75h3.25" />
                  </svg>
                )}
                {paso.icono === 'datos' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" />
                    <circle cx="8.5" cy="9" r="1.3" />
                    <path d="M3.5 16.2 9.2 11.4a1.3 1.3 0 0 1 1.75.08l2.55 2.55 2.15-2.05a1.3 1.3 0 0 1 1.8.04L20.5 15.2" />
                  </svg>
                )}
                {paso.icono === 'enlace' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.5 3.5 10.25 13.75" />
                    <path d="M20.5 3.5 14 20.5l-3.75-6.75L3.5 10 20.5 3.5Z" />
                  </svg>
                )}
              </div>

              <div class:list={[
                'min-w-0 lg:mt-5 lg:w-auto lg:px-2 lg:py-0',
                paso.destacado ? 'ruta-destino-card -mt-6 w-full rounded-[1.75rem] px-6 pt-9 pb-5' : 'flex-1',
              ]}>
                <div class:list={['flex items-center gap-2 lg:justify-center', idx === 1 && 'justify-end', paso.destacado && 'justify-center']}>
                  {(idx === 1 || paso.destacado) && <span class="h-px w-4 bg-signato-secundario/75 lg:hidden" aria-hidden="true"></span>}
                  <span class="font-display text-base italic leading-none tracking-wide text-signato-principal lg:text-lg">{paso.numero}</span>
                  {(idx === 0 || paso.destacado) && <span class="h-px w-4 bg-signato-secundario/75 lg:hidden" aria-hidden="true"></span>}
                </div>
                <h3 class="font-display mt-0.5 text-[1.4rem] font-semibold leading-tight text-signato-contraste sm:text-2xl lg:mt-1">{paso.titulo}</h3>
                <p class="mt-1 text-[13px] leading-relaxed text-signato-contraste/75 sm:text-sm lg:mx-auto lg:mt-1.5 lg:max-w-[26ch]">{paso.descripcion}</p>
              </div>
            </div>

            {idx < 2 && (
              <div class:list={['relative mx-6 h-14 lg:hidden', idx === 0 ? '-my-1.5' : '-mt-1.5 mb-1.5']} aria-hidden="true">
                <svg class="h-full w-full overflow-visible" viewBox="0 0 1000 56" fill="none" preserveAspectRatio="none">
                  <path
                    class="ruta-curva-movil"
                    style={`--cd: ${idx === 0 ? '90ms' : '240ms'}`}
                    d={idx === 0 ? 'M 2 2 C 2 40, 998 16, 998 54' : 'M 998 2 C 998 40, 500 16, 500 54'}
                    stroke={idx === 0 ? '#C6B4A6' : '#8BA888'}
                    stroke-opacity={idx === 0 ? '0.78' : '0.84'}
                    stroke-width="1.2"
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                    pathLength="1"
                  />
                </svg>
                <span
                  style={`--st: ${idx + 1}`}
                  class:list={['ruta-estrella absolute top-1/2 -translate-x-1/2 -translate-y-1/2', idx === 0 ? 'left-1/2 text-signato-secundario' : 'left-3/4 text-signato-principal']}
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25"><path d={estrellaD} /></svg>
                </span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
