---
import { clientes } from '../../data/clientes';
import { CATEGORIAS_ORDEN, obtenerEtiquetaCategoria } from '../../utils/categorias';
import { PLANES_INFO, resolverModulos } from '../../utils/planes';
import PhoneDemoMockup from './PhoneDemoMockup.astro';

const muestras = clientes.filter((cliente) => cliente.esDemo);
const categoriasPresentes = CATEGORIAS_ORDEN.filter((cat) =>
  muestras.some((demo) => demo.categoria === cat),
);

const muestrasConMeta = muestras.map((demo) => {
  const infoPlan = PLANES_INFO[demo.plan];
  const modulos = resolverModulos(demo);
  const ruta = modulos.paseBoletos
    ? `/${demo.categoria}/${demo.slug}?pases=4`
    : `/${demo.categoria}/${demo.slug}`;
  return {
    demo,
    ruta,
    nombrePlan: infoPlan.nombre,
    etiquetaSingular: obtenerEtiquetaCategoria(demo.categoria, true),
  };
});

const indiceInicial = muestrasConMeta.length >= 3 ? 1 : 0;
const muestraInicial = muestrasConMeta[indiceInicial] ?? muestrasConMeta[0];
---

<section id="muestras" data-muestras-catalogo class="velo-scope border-t border-signato-secundario/35 py-16 sm:py-24">
  <div class="velo-orb velo-orb--salvia -top-8 left-1/2 h-64 w-64 -translate-x-1/2 opacity-40 sm:h-80 sm:w-80" aria-hidden="true"></div>
  <div class="velo-orb velo-orb--arcilla bottom-8 left-1/2 h-56 w-72 -translate-x-1/2 opacity-35 sm:h-72 sm:w-96" aria-hidden="true"></div>

  <div class="relative mx-auto w-full min-w-0 max-w-6xl px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-xl text-center">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-signato-principal">
          Catálogo interactivo
        </p>
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
      </div>
      <h2 class="font-display mt-2.5 text-4xl font-medium leading-[1.05] text-signato-contraste sm:text-5xl">
        Diseños vivos en tu celular
      </h2>
    </div>

    <div data-reveal style="--rv: 1" class="mt-7 flex flex-col items-center gap-3">
      <div role="tablist" aria-label="Filtrar muestras por categoría" class="glass-surface inline-flex max-w-full flex-wrap items-center justify-center gap-1 rounded-full p-1">
        <button type="button" role="tab" aria-selected="true" data-filtro-cat="todas" class="muestras-tab cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wide transition-colors">
          Todas
        </button>
        {categoriasPresentes.map((cat) => (
          <button type="button" role="tab" aria-selected="false" data-filtro-cat={cat} class="muestras-tab cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wide transition-colors">
            {obtenerEtiquetaCategoria(cat)}
          </button>
        ))}
      </div>

      <button type="button" data-toggle-preview aria-pressed="false" class="glass-surface inline-flex cursor-pointer items-center gap-2 rounded-full px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-signato-contraste/80 transition-colors hover:text-signato-contraste">
        <svg data-icon-pause class="h-3.5 w-3.5 text-signato-principal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M9 6v12M15 6v12" stroke-linecap="round" />
        </svg>
        <svg data-icon-play class="hidden h-3.5 w-3.5 text-signato-principal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M8 6.5v11l9-5.5-9-5.5Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Vista previa</span>
      </button>
    </div>
  </div>

  <div data-reveal style="--rv: 2" class="relative mt-8 w-full min-w-0 sm:mt-10">
    <button type="button" data-carrusel-prev aria-label="Ver muestra anterior" class="muestras-nav glass-surface absolute top-1/2 left-5 z-20 h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-signato-contraste transition-transform hover:scale-105 disabled:pointer-events-none disabled:opacity-30 lg:left-10">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div data-carrusel-track class="muestras-track">
      {muestrasConMeta.map(({ demo, ruta, nombrePlan, etiquetaSingular }, idx) => (
        <div
          data-slide
          data-categoria={demo.categoria}
          data-titulo={demo.protagonistas}
          data-meta={`${etiquetaSingular} · Paquete ${nombrePlan}`}
          data-href={ruta}
          data-active={idx === indiceInicial ? 'true' : 'false'}
          class="muestras-slide"
        >
          <PhoneDemoMockup demo={demo} href={ruta} etiquetaCategoria={etiquetaSingular} nombrePlan={nombrePlan} indice={idx} />
        </div>
      ))}
    </div>

    <button type="button" data-carrusel-next aria-label="Ver muestra siguiente" class="muestras-nav glass-surface absolute top-1/2 right-5 z-20 h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-signato-contraste transition-transform hover:scale-105 disabled:pointer-events-none disabled:opacity-30 lg:right-10">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  {muestraInicial && (
    <div data-reveal style="--rv: 3" class="relative mx-auto mt-6 flex w-full max-w-md flex-col items-center px-4 text-center sm:mt-8">
      <p data-cta-titulo class="font-display text-2xl font-medium text-signato-contraste">
        {muestraInicial.demo.protagonistas}
      </p>
      <p data-cta-meta class="mt-0.5 text-[11px] font-medium uppercase tracking-[0.18em] text-signato-contraste/65">
        {muestraInicial.etiquetaSingular} · Paquete {muestraInicial.nombrePlan}
      </p>
      <a href={muestraInicial.ruta} data-cta-link class="mt-4 inline-flex min-h-[46px] items-center gap-2.5 rounded-full bg-signato-contraste px-6 py-2.5 text-xs font-semibold uppercase tracking-[0.14em] text-signato-lienzo transition-colors hover:bg-signato-principal active:scale-[0.98]">
        <span>Abrir muestra con animaciones</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  )}
</section>

<script>
  import { iniciarMuestrasCarrusel } from '../../scripts/muestrasCarrusel';

  document
    .querySelectorAll<HTMLElement>('[data-muestras-catalogo]')
    .forEach((seccion) => iniciarMuestrasCarrusel(seccion));
</script>
