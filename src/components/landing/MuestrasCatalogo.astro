---
import { clientes } from '../../data/clientes';
import { obtenerEtiquetaCategoria } from '../../utils/categorias';
import { formatearFechaCorta } from '../../utils/fechas';
import { PLANES_INFO, resolverModulos } from '../../utils/planes';

const muestras = clientes.filter((cliente) => cliente.esDemo);
---

<section id="muestras" class="border-t border-signato-secundario/35 py-16 sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div data-reveal class="max-w-2xl">
      <div class="flex items-center gap-3">
        <span class="h-px w-6 bg-signato-secundario" aria-hidden="true"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-signato-principal">
          Catálogo interactivo
        </p>
      </div>
      <h2 class="font-display mt-2.5 text-4xl font-medium leading-[1.06] text-signato-contraste sm:text-5xl">
        Muestras reales listas para probar en tu celular
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-signato-contraste/75 sm:text-base">
        Abre cada ejemplo tal como lo recibirán tus invitados: explora su paleta propia, ubicaciones, música y pase de boletos en vivo.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {muestras.map((demo, idx) => {
        const infoPlan = PLANES_INFO[demo.plan];
        const modulos = resolverModulos(demo);
        const rutaMuestra = modulos.paseBoletos
          ? `/${demo.categoria}/${demo.slug}?pases=4`
          : `/${demo.categoria}/${demo.slug}`;
        const estiloMuestra = `--m-bg:${demo.temaColores.bg};--m-surface:${demo.temaColores.surface};--m-accent:${demo.temaColores.accent};--m-ink:${demo.temaColores.ink}`;
        const variante =
          demo.categoria === 'xv-anos' ? 'xv' : demo.categoria === 'bodas' ? 'boda' : 'bautizo';

        return (
          <a
            href={rutaMuestra}
            data-reveal
            style={`--rv: ${idx}`}
            class="glass-surface group flex flex-col justify-between overflow-hidden rounded-3xl p-3 transition-all duration-300 hover:-translate-y-1 active:scale-[0.98]"
          >
            <div>
              <div
                style={estiloMuestra}
                class={`muestra-lienzo muestra-lienzo--${variante} relative flex h-60 flex-col justify-between overflow-hidden rounded-[1.35rem] p-5 transition-transform duration-500 group-hover:scale-[1.01]`}
              >
                <div class="muestra-marco pointer-events-none absolute inset-3" aria-hidden="true"></div>

                <div class="relative flex items-center justify-between text-[10px] font-semibold uppercase tracking-[0.22em]">
                  <span class="muestra-acento">{demo.subtitulo}</span>
                  <span class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="h-2.5 w-2.5 rounded-full border border-white/60" style={`background-color:${demo.temaColores.bg}`}></span>
                    <span class="h-2.5 w-2.5 rounded-full border border-white/60" style={`background-color:${demo.temaColores.accent}`}></span>
                    <span class="h-2.5 w-2.5 rounded-full border border-white/60" style={`background-color:${demo.temaColores.ink}`}></span>
                  </span>
                </div>

                <div class="relative my-auto py-2 text-center">
                  <p class:list={['font-display text-[2.15rem] leading-[1.04] transition-transform duration-500 group-hover:scale-[1.02]', variante === 'boda' ? 'italic font-medium' : 'font-semibold']}>
                    {demo.protagonistas}
                  </p>
                  <span class="muestra-linea mx-auto mt-3 block h-px w-12" aria-hidden="true"></span>
                  <p class="mt-2.5 text-[11px] font-medium tracking-[0.14em] uppercase opacity-80">
                    {formatearFechaCorta(demo.fechaISO)}
                  </p>
                </div>

                <p class="relative text-center text-[11px] opacity-75">{demo.ciudad}</p>
              </div>

              <div class="px-2 pt-4">
                <div class="flex items-center justify-between gap-2 border-b border-signato-secundario/30 pb-2.5 text-[11px]">
                  <span class="font-semibold uppercase tracking-[0.18em] text-signato-principal">
                    {obtenerEtiquetaCategoria(demo.categoria)}
                  </span>
                  <span class="font-medium uppercase tracking-[0.14em] text-signato-contraste/70">
                    Paquete {infoPlan.nombre}
                  </span>
                </div>

                <h3 class="font-display mt-3 text-2xl font-semibold text-signato-contraste transition-colors group-hover:text-signato-principal">
                  {demo.protagonistas}
                </h3>
                <p class="mt-0.5 text-xs text-signato-contraste/70">
                  {demo.ciudad}
                  {modulos.paseBoletos && ' · Pase digital con 4 lugares'}
                </p>
              </div>
            </div>

            <div class="mt-4 flex min-h-[48px] items-center justify-between border-t border-signato-secundario/35 px-2 pt-3 text-xs font-semibold uppercase tracking-[0.14em] text-signato-contraste">
              <span>Abrir muestra en vivo</span>
              <svg class="h-4 w-4 text-signato-principal transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .muestra-lienzo--bautizo { background: linear-gradient(155deg, color-mix(in srgb, var(--m-accent) 26%, var(--m-bg)) 0%, var(--m-bg) 100%); color: var(--m-ink); }
  .muestra-lienzo--bautizo .muestra-marco { border: 1px solid color-mix(in srgb, var(--m-accent) 55%, transparent); border-radius: 6rem 6rem 0.9rem 0.9rem; }
  .muestra-lienzo--bautizo .muestra-acento { color: color-mix(in srgb, var(--m-ink) 80%, var(--m-accent)); }
  .muestra-lienzo--bautizo .muestra-linea { background-color: var(--m-accent); }
  .muestra-lienzo--boda { background: linear-gradient(150deg, var(--m-ink) 0%, color-mix(in srgb, var(--m-accent) 42%, var(--m-ink)) 100%); color: var(--m-bg); }
  .muestra-lienzo--boda .muestra-marco { border: 1px solid color-mix(in srgb, var(--m-bg) 32%, transparent); border-radius: 0.75rem; }
  .muestra-lienzo--boda .muestra-acento { color: color-mix(in srgb, var(--m-bg) 78%, var(--m-accent)); }
  .muestra-lienzo--boda .muestra-linea { background-color: color-mix(in srgb, var(--m-bg) 60%, var(--m-accent)); }
  .muestra-lienzo--xv { background: linear-gradient(155deg, var(--m-accent) 0%, color-mix(in srgb, var(--m-accent) 72%, var(--m-ink)) 100%); color: var(--m-bg); }
  .muestra-lienzo--xv .muestra-marco { border: 1px solid color-mix(in srgb, var(--m-bg) 38%, transparent); border-radius: 7rem 7rem 0.85rem 0.85rem; }
  .muestra-lienzo--xv .muestra-acento { color: var(--m-surface); }
  .muestra-lienzo--xv .muestra-linea { background-color: var(--m-surface); }
</style>
