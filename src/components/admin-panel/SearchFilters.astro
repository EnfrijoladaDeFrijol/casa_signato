---
interface Props {
  categoriasUnicas: string[];
  labelCategoria: Record<string, string>;
}

const { categoriasUnicas, labelCategoria } = Astro.props;
---

<!-- Se eliminaron los bordes (border-b, border-slate-200) y las sombras (shadow-sm) -->
<!-- Se dejó bg-[#F8FAFC] para que se fusione perfectamente de forma invisible -->
<div class="sticky top-0 z-20 bg-[#F8FAFC] py-3 md:py-4 mb-8 md:mb-12">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 lg:gap-6 w-full min-w-0">
    
    <!-- Búsqueda -->
    <div class="relative w-full max-w-full lg:max-w-md shrink-0">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        id="searchInput" 
        placeholder="Buscar por nombre..." 
        class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-900 text-sm md:text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all shadow-sm placeholder:text-slate-400"
      />
    </div>

    <!-- Filtros por Categoría -->
    <div class="w-full min-w-0">
      <div class="flex items-center lg:justify-end gap-2 overflow-x-auto pb-1 lg:pb-0 no-scrollbar" id="filterContainer">
        <button class="filter-btn bg-slate-900 text-white border-transparent px-4 py-2 rounded-lg text-sm font-semibold transition-all shrink-0 whitespace-nowrap" data-category="all">
          Todas
        </button>
        {categoriasUnicas.map(cat => (
          <button class="filter-btn bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 hover:text-slate-900 px-4 py-2 rounded-lg text-sm font-medium transition-all shrink-0 whitespace-nowrap" data-category={cat}>
            {labelCategoria[cat] ?? cat}
          </button>
        ))}
      </div>
    </div>
    
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>