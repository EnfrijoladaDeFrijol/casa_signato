---
import MarcaLayout from '../../layouts/MarcaLayout.astro';
import SearchFilters from '../../components/admin/SearchFilters.astro';
import InvitationCard from '../../components/admin/InvitationCard.astro';
import { clientes } from '../../data/clientes';
import type { CategoriaEvento } from '../../types/invitacion';
import { agruparClientesPorCategoria } from '../../utils/categorias';

const agrupados = agruparClientesPorCategoria(clientes);
const conteosPorCategoria: Record<CategoriaEvento, number> = {
  'xv-anos': agrupados['xv-anos'].length,
  bodas: agrupados.bodas.length,
  bautizos: agrupados.bautizos.length,
  cumpleanos: agrupados.cumpleanos.length,
};
---

<MarcaLayout
  title="Panel Interno | Casa Signato"
  description="Buscador y acceso rápido a las invitaciones digitales de Casa Signato."
>
  <header class="sticky top-0 z-40 border-b border-signato-secundario/40 bg-signato-lienzo/90 backdrop-blur-md">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <a
        href="/admin"
        class="inline-flex items-center gap-2.5 text-signato-contraste transition-opacity hover:opacity-80"
      >
        <span class="inline-flex h-8 w-12 shrink-0 items-center justify-center overflow-hidden">
          <img
            src="/marca/logo-color.png"
            alt="Casa Signato"
            class="h-auto w-full max-w-none -translate-y-[2%]"
          />
        </span>
        <span class="font-display text-xl font-semibold tracking-wide">
          Casa Signato · Interno
        </span>
      </a>

      <a
        href="/"
        class="inline-flex min-h-[40px] items-center rounded-full border border-signato-secundario/60 px-4 py-1.5 text-xs font-semibold text-signato-contraste transition-colors hover:bg-signato-secundario/20"
      >
        Ver sitio público
      </a>
    </div>
  </header>

  <main class="flex-1 w-full min-w-0">
    <div class="mx-auto w-full min-w-0 max-w-6xl space-y-6 px-4 py-8 sm:px-6 sm:py-10">
    <div class="flex w-full min-w-0 flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-signato-principal">
          Operación interna
        </p>
        <h1 class="font-display mt-1 text-3xl font-semibold text-signato-contraste sm:text-4xl">
          Directorio de Invitaciones
        </h1>
      </div>

      <p class="text-xs text-signato-contraste/70" id="admin-conteo">
        Mostrando {clientes.length} de {clientes.length} invitaciones
      </p>
    </div>

    <SearchFilters
      totalClientes={clientes.length}
      conteosPorCategoria={conteosPorCategoria}
    />

    <div
      id="admin-grid"
      class="grid w-full min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    >
      {clientes.map((cliente) => <InvitationCard cliente={cliente} />)}
    </div>

    <div
      id="admin-vacio"
      class="hidden rounded-3xl border border-dashed border-signato-secundario bg-white/70 px-6 py-10 text-center"
    >
      <p class="font-display text-2xl font-semibold text-signato-contraste">
        No hay invitaciones que coincidan con tu búsqueda
      </p>
      <p class="mt-1 text-sm text-signato-contraste/70">
        Prueba limpiando el texto o cambiando la categoría seleccionada.
      </p>
    </div>
    </div>
  </main>
</MarcaLayout>

<script>
  const buscador = document.querySelector<HTMLInputElement>('#admin-buscador');
  const botonesFiltro = document.querySelectorAll<HTMLButtonElement>(
    '[data-filtro-categoria]',
  );
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-cliente-card]');
  const estadoVacio = document.querySelector<HTMLElement>('#admin-vacio');
  const textoConteo = document.querySelector<HTMLElement>('#admin-conteo');

  let categoriaActiva = 'todas';
  const totalTarjetas = tarjetas.length;

  const aplicarFiltros = () => {
    const consulta = (buscador?.value || '').trim().toLowerCase();
    let visibles = 0;

    tarjetas.forEach((tarjeta) => {
      const cat = tarjeta.dataset.categoria || '';
      const texto = tarjeta.dataset.busqueda || '';
      const coincideCat =
        categoriaActiva === 'todas' || cat === categoriaActiva;
      const coincideTexto = !consulta || texto.includes(consulta);
      const mostrar = coincideCat && coincideTexto;

      tarjeta.classList.toggle('hidden', !mostrar);
      if (mostrar) visibles += 1;
    });

    estadoVacio?.classList.toggle('hidden', visibles > 0);
    if (textoConteo) {
      textoConteo.textContent = `Mostrando ${visibles} de ${totalTarjetas} invitaciones`;
    }
  };

  botonesFiltro.forEach((boton) => {
    boton.addEventListener('click', () => {
      categoriaActiva = boton.dataset.filtroCategoria || 'todas';

      botonesFiltro.forEach((item) => {
        const activo = item === boton;
        item.setAttribute('aria-pressed', activo ? 'true' : 'false');
        item.classList.toggle('bg-signato-contraste', activo);
        item.classList.toggle('text-signato-lienzo', activo);
        item.classList.toggle('font-semibold', activo);
        item.classList.toggle('border', !activo);
        item.classList.toggle('border-signato-secundario/60', !activo);
        item.classList.toggle('bg-signato-lienzo', !activo);
        item.classList.toggle('text-signato-contraste', !activo);
      });

      aplicarFiltros();
    });
  });

  buscador?.addEventListener('input', aplicarFiltros);

  document.querySelectorAll<HTMLButtonElement>('[data-copiar-ruta]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const ruta = boton.dataset.copiarRuta;
      if (!ruta) return;
      const urlCompleta = `${window.location.origin}${ruta}`;
      const original = boton.textContent || 'Copiar enlace';

      try {
        await navigator.clipboard.writeText(urlCompleta);
        boton.textContent = 'Enlace copiado';
        window.setTimeout(() => {
          boton.textContent = original;
        }, 2000);
      } catch {
        boton.textContent = ruta;
      }
    });
  });
</script>
