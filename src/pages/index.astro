---
import MarcaLayout from '../layouts/MarcaLayout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import MuestrasCatalogo from '../components/landing/MuestrasCatalogo.astro';
import ComoFunciona from '../components/landing/ComoFunciona.astro';
import Paquetes from '../components/landing/Paquetes.astro';
import PreguntasFrecuentes from '../components/landing/PreguntasFrecuentes.astro';
import CtaFinal from '../components/landing/CtaFinal.astro';
import Footer from '../components/landing/Footer.astro';
---

<MarcaLayout
  title="Casa Signato | Invitaciones Digitales Boutique en México"
  description="Invitaciones digitales boutique para XV Años, bodas, bautizos y cumpleaños. Envíos ilimitados por WhatsApp, entrega en 24 a 72 horas y pago único desde $349 MXN."
>
  <Navbar />
  <main class="flex-1 w-full min-w-0">
    <Hero />
    <MuestrasCatalogo />
    <ComoFunciona />
    <Paquetes />
    <PreguntasFrecuentes />
    <CtaFinal />
  </main>
  <Footer />
</MarcaLayout>
