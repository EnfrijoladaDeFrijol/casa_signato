---
import BrandLayout from '../layouts/BrandLayout.astro';
import { clientes } from '../data/clientes';
import { obtenerEtiquetaCategoria } from '../utils/categorias';
import { PLANES_INFO, PLANES_ORDEN } from '../utils/planes';
---

<BrandLayout
  title="Casa Signato | Invitaciones Digitales Boutique"
  description="Invitaciones digitales elegantes, rápidas y personalizadas en México para XV Años, Bodas, Bautizos y Cumpleaños."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.26em] text-signato-principal">
        Papelería Digital Boutique · México
      </p>
      <h1 class="font-display mt-3 text-4xl font-semibold leading-tight text-signato-contraste sm:text-6xl">
        Invitaciones digitales con diseño editorial y entrega ágil
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-signato-contraste/75 sm:text-base">
        Casa Signato combina estética atemporal, velocidad móvil y una arquitectura modular pensada para compartir por WhatsApp desde el primer momento.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/admin"
          class="inline-flex w-full items-center justify-center rounded-full bg-signato-principal px-6 py-3 text-sm font-semibold text-signato-lienzo transition-opacity hover:opacity-90 sm:w-auto"
        >
          Ir al panel interno (/admin)
        </a>
        <a
          href="#paquetes"
          class="inline-flex w-full items-center justify-center rounded-full border border-signato-secundario px-6 py-3 text-sm font-semibold text-signato-contraste transition-colors hover:bg-signato-secundario/20 sm:w-auto"
        >
          Ver paquetes oficiales
        </a>
      </div>
    </div>

    <div class="mt-14">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-signato-principal">
            Muestras funcionales
          </p>
          <h2 class="font-display text-3xl font-semibold text-signato-contraste">
            Demos activas de Fase 1
          </h2>
        </div>
        <a
          href="/admin"
          class="text-xs font-semibold uppercase tracking-[0.14em] text-signato-contraste/75 underline decoration-signato-principal underline-offset-4"
        >
          Ver catálogo en /admin
        </a>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          clientes.map((demo) => {
            const infoPlan = PLANES_INFO[demo.plan];
            return (
              <a
                href={`/${demo.categoria}/${demo.slug}`}
                class="group flex flex-col justify-between rounded-3xl border border-signato-secundario/45 bg-white p-5 transition-colors hover:border-signato-principal"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="font-semibold uppercase tracking-[0.14em] text-signato-principal">
                      {obtenerEtiquetaCategoria(demo.categoria)}
                    </span>
                    <span class="rounded-full bg-signato-lienzo px-2.5 py-0.5 font-medium text-signato-contraste">
                      {infoPlan.nombre}
                    </span>
                  </div>
                  <h3 class="font-display mt-3 text-2xl font-semibold text-signato-contraste group-hover:text-signato-principal transition-colors">
                    {demo.protagonistas}
                  </h3>
                  <p class="mt-1 text-xs text-signato-contraste/70">{demo.ciudad}</p>
                </div>

                <span class="mt-5 inline-flex items-center text-xs font-semibold text-signato-contraste">
                  Abrir muestra →
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="paquetes" class="border-t border-signato-secundario/35 bg-white/55">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-signato-principal">
          Pago único en MXN
        </p>
        <h2 class="font-display mt-2 text-3xl font-semibold text-signato-contraste sm:text-4xl">
          Nuestros Paquetes
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          PLANES_ORDEN.map((planId) => {
            const plan = PLANES_INFO[planId];
            return (
              <article
                class:list={[
                  'flex flex-col justify-between rounded-3xl border p-6 sm:p-7',
                  plan.destacado
                    ? 'border-signato-principal bg-white/90 shadow-md backdrop-blur-md'
                    : 'border-signato-secundario/50 bg-signato-lienzo/70',
                ]}
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="font-display text-3xl font-semibold text-signato-contraste">
                      {plan.nombre}
                    </h3>
                    <span
                      class:list={[
                        'rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wider',
                        plan.destacado
                          ? 'bg-signato-principal text-signato-lienzo'
                          : 'bg-signato-secundario/30 text-signato-contraste',
                      ]}
                    >
                      {plan.etiqueta}
                    </span>
                  </div>

                  <p class="mt-4 flex items-baseline gap-1.5">
                    <span class="font-display text-4xl font-semibold text-signato-contraste">
                      ${plan.precioMXN}
                    </span>
                    <span class="text-xs font-medium uppercase tracking-wider text-signato-contraste/65">
                      MXN · Pago único
                    </span>
                  </p>

                  <p class="mt-3 text-sm leading-relaxed text-signato-contraste/75">
                    {plan.descripcion}
                  </p>

                  <ul class="mt-6 space-y-2.5 border-t border-signato-secundario/35 pt-5 text-sm text-signato-contraste/85">
                    {plan.beneficios.map((beneficio) => (
                      <li class="flex items-start gap-2.5">
                        <svg
                          class="mt-0.5 h-4 w-4 shrink-0 text-signato-principal"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path d="m4.5 10.5 3.5 3.5 7.5-8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>{beneficio}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <a
                  href="/admin"
                  class:list={[
                    'mt-7 inline-flex items-center justify-center rounded-full px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] transition-opacity hover:opacity-90',
                    plan.destacado
                      ? 'bg-signato-principal text-signato-lienzo'
                      : 'bg-signato-contraste text-signato-lienzo',
                  ]}
                >
                  Probar en panel interno
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BrandLayout>
