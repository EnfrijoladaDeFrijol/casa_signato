---
// ============================================================
// ENRUTADOR DINÁMICO MAESTRO
// Archivo: src/pages/[categoria]/[cliente].astro
//
// Este es el NÚCLEO del sistema. Un único archivo genera TODAS
// las rutas de invitación. Jamás se duplica código por cliente.
//
// Flujo:
// 1. getStaticPaths() lee clientes.ts
// 2. Mapea cada cliente a { params, props }
// 3. Astro genera una página estática por cada entrada
// 4. El componente visual se selecciona del MAPA_PLANTILLAS
// 5. Los datos se inyectan como props al componente visual
// ============================================================
import type { GetStaticPaths } from 'astro';
import type { ClienteInvitacion, PlantillaID } from '../../types/invitacion';

import Layout from '../../layouts/Layout.astro';

// --- Importación estática de TODAS las plantillas visuales ---
// Los componentes Astro NO se pueden importar dinámicamente con import()
// en el frontmatter para SSG. Este mapa estático es el patrón correcto.
// Cada plantilla vive en su propia subcarpeta modular.
import BodaClasica from '../../components/plantillas/boda-clasica/index.astro';
import XvElegante from '../../components/plantillas/xv-elegante/index.astro';
import BautizoAngelical from '../../components/plantillas/bautizo-angelical/index.astro';
import CumpleanosFiesta from '../../components/plantillas/cumpleanos-fiesta/index.astro';

// --- Base de datos local (TypeScript tipado) ---
import { clientes } from '../../data/clientes';

// --- Mapa de plantillas: conecta el ID string con el componente real ---
const MAPA_PLANTILLAS: Record<PlantillaID, typeof BodaClasica> = {
  'boda-clasica': BodaClasica,
  'xv-elegante': XvElegante,
  'bautizo-angelical': BautizoAngelical,
  'cumpleanos-fiesta': CumpleanosFiesta,
};

// ============================================================
// getStaticPaths: genera una ruta estática por cada cliente
// URL resultante: /{categoria}/{slug}
// ============================================================
export const getStaticPaths = (() => {
  return clientes.map((cliente) => ({
    params: {
      categoria: cliente.categoria,
      cliente: cliente.slug,
    },
    props: {
      datosCliente: cliente,
    },
  }));
}) satisfies GetStaticPaths;

// --- Extraer datos del cliente de esta ruta ---
interface Props {
  datosCliente: ClienteInvitacion;
}

const { datosCliente } = Astro.props;

// --- Seleccionar el componente visual correcto ---
const PlantillaComponente = MAPA_PLANTILLAS[datosCliente.plantilla];

// --- Construir meta description ---
const descripcion = `Invitación de ${datosCliente.contenido.titulo} — ${datosCliente.contenido.subtitulo}`;
---

<Layout
  title={`${datosCliente.contenido.titulo} | ${datosCliente.contenido.subtitulo}`}
  description={descripcion}
  colorPrimario={datosCliente.colores.primario}
  colorSecundario={datosCliente.colores.secundario}
  colorAcento={datosCliente.colores.acento}
  colorFondo={datosCliente.colores.fondo}
  colorTexto={datosCliente.colores.texto}
>
  <!--
    Renderizado dinámico: el componente correcto se elige del MAPA_PLANTILLAS
    según datosCliente.plantilla. Todos reciben las mismas props estandarizadas.
  -->
  <PlantillaComponente
    datos={datosCliente.contenido}
    colores={datosCliente.colores}
  />
</Layout>
