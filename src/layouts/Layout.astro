---
// ============================================================
// Layout Global — Cascarón HTML responsivo para todas las invitaciones
// ============================================================
interface Props {
  title: string;
  description?: string;
  colorPrimario?: string;
  colorSecundario?: string;
  colorAcento?: string;
  colorFondo?: string;
  colorTexto?: string;
}

const {
  title,
  description = 'Invitación Digital Interactiva',
  colorPrimario = '#6B4F3A',
  colorSecundario = '#D4A574',
  colorAcento = '#C8956C',
  colorFondo = '#FDF8F3',
  colorTexto = '#3D2B1F',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Playfair Display (títulos) + Inter (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- Estilos globales de Tailwind CSS v4 -->
    <style>
      @import '../styles/global.css';
    </style>
  </head>
  <body
    style={`
      --color-primario: ${colorPrimario};
      --color-secundario: ${colorSecundario};
      --color-acento: ${colorAcento};
      --color-fondo: ${colorFondo};
      --color-texto: ${colorTexto};
    `}
    class="min-h-screen font-sans antialiased overflow-x-hidden"
  >
    <slot />
  </body>
</html>
