---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Casa Signato — Invitaciones digitales boutique hechas en México para XV Años, Bodas, Bautizos y Cumpleaños.',
} = Astro.props;

const rutaActual = Astro.url.pathname;
const enAdmin = rutaActual.startsWith('/admin');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F6F2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-signato-lienzo text-signato-contraste antialiased flex flex-col">
    <header class="sticky top-0 z-40 border-b border-signato-secundario/40 bg-signato-lienzo/85 backdrop-blur-md">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-signato-contraste transition-opacity hover:opacity-80"
        >
          <svg
            class="h-7 w-7 text-signato-principal shrink-0"
            viewBox="0 0 32 32"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M17.5 4.5C14.5 4.5 12 6.8 12 9.5C12 11.4 13.2 12.8 14.5 13.7C15.7 14.5 16.3 15.8 15.6 17.5C14.9 19.2 13.8 20.5 14.4 23C14.9 25.1 17 26.8 19.3 26.5C21.2 26.2 22.2 24.5 21.6 22.8C21.1 21.5 19.5 21.2 18.7 22.1"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
            <path
              d="M12.5 8.5L9.5 9.6L12.1 10.6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M17.5 6.8C19.6 7.4 20.8 9.2 20.4 11.5C20 13.3 18.6 14.8 18.4 16.4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <circle cx="15.2" cy="8.4" r="0.9" fill="currentColor" />
          </svg>
          <span class="font-display text-xl font-semibold tracking-wide sm:text-2xl">
            Casa Signato
          </span>
        </a>

        <nav class="flex items-center gap-2 sm:gap-3" aria-label="Navegación principal">
          <a
            href="/"
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
              !enAdmin
                ? 'bg-signato-contraste text-signato-lienzo'
                : 'text-signato-contraste/80 hover:bg-signato-secundario/25',
            ]}
          >
            Inicio
          </a>
          <a
            href="/admin"
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
              enAdmin
                ? 'bg-signato-principal text-signato-lienzo'
                : 'border border-signato-secundario/60 text-signato-contraste hover:bg-signato-secundario/25',
            ]}
          >
            Panel interno
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full min-w-0">
      <slot />
    </main>

    <footer class="border-t border-signato-secundario/35 bg-signato-lienzo">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-signato-contraste/70 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>Casa Signato · Papelería digital boutique en México</p>
        <p>Arquitectura modular Astro + TypeScript · Fase 1</p>
      </div>
    </footer>
  </body>
</html>
